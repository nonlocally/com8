.DS_Store
*.log
*.pyc
__pycache__/
/dist/
# runtime state lives in $XDG_STATE_HOME/communicate, never in the repo — but
# guard against accidental local copies:
/state/
/.state/

# Capability cards describe real hosts/corpora — schema is shared, entries are not.
registry/*.md
!registry/README.md
!registry/EXAMPLE.md

# Open WebUI writes its session-signing key here when run from a checkout.
# It is a local secret and never repository content.
/.webui_secret_key

# Browser accessibility dumps from the playwright MCP — screen captures of live
# UI, carrying real agent names. Local debugging artifacts, never repo content.
/.playwright-mcp/
android/phonebridge/build/
android/vdisplay/build/
android/phonebridge/debug.keystore
