#!/usr/bin/env bash
# com8-snapshot — automatic, logged, permanently-archived tmux-workspace backups.
# The optional COM8 snapshot module; adapted from Anu (see profiles/NOTICE.md).
#
# Wraps `tss` (profiles/runtime/fns/snapshots) for UNATTENDED use. The owned schedule
# (`com8-snapshot schedule install`) runs `com8-snapshot run` every 6 hours
# (03:00, 09:00, 15:00, 21:00). Each run:
#   1. snapshots the whole tmux workspace to $COM8_SNAPSHOT_DIR/snap-YYYY-MM-DD-HHMM
#   2. mirrors every not-yet-archived snapshot to the archive volume, verified by
#      a per-snapshot sha256 manifest — the permanent archive (optional: it needs
#      COM8_SNAPSHOT_VOL; with none configured every snapshot stays local)
#   3. prunes the LOCAL copy to the newest N snapshots, deleting one only when the
#      archive volume is MOUNTED and holds a checksum-verified copy whose bytes
#      match the local files. A marker alone never permits a deletion. Nothing is
#      ever deleted from the archive.
#   4. appends one line to $COM8_SNAPSHOT_LOG
# Restore with `tsr snap-YYYY-MM-DD-HHMM` (from local; or `com8-snapshot restore
# <name|date>` to pull it back from the archive first — a copy that fails its
# checksum is refused and nothing is written).
#
# NAMING. Snapshots taken before the 6-hourly cadence are named
# `nightly-YYYY-MM-DD`; every subcommand still finds, archives, prunes, verifies,
# lists and restores those legacy names alongside the current `snap-` ones. The
# two schemes are ordered by their embedded timestamp, never lexically — sorting
# bare names would put every `nightly-` before every `snap-` whatever the date.
#
# Subcommands:
#   run [name]   snapshot now + archive + prune (default name: snap-YYYY-MM-DD-HHMM).
#   archive      mirror any not-yet-archived snapshots to the archive + prune (catch-up).
#   restore <s>  copy a verified snapshot back from the archive into the sessions dir.
#                <s> = a full name, YYYY-MM-DD-HHMM, or a bare YYYY-MM-DD.
#   verify       checksum-verify every snapshot in the archive.
#   status       schedule, archive state, local/archived counts, recent log.
#   log [-f]     print (or follow) the snapshot log.
#   list         list LOCAL snapshots, newest first (* = archived).
#   prune [N]    keep newest N local snapshots; delete older ones only when verified archived.
#   schedule preview|install|uninstall|status   the explicit, owned, reversible schedule
#                (never installed by profile installation; see schedule.py).
#
# Configuration — private, in ~/.config/com8/profiles/local.sh (sourced here):
#   COM8_PROFILE_STATE     where tss saves: <state>/sessions        (default ~/.local/state/com8/workstation)
#   COM8_SNAPSHOT_DIR      local snapshots                          (default $COM8_PROFILE_STATE/sessions)
#   COM8_SNAPSHOT_LOG      the log                                  (default $COM8_PROFILE_STATE/snapshots.log)
#   COM8_SNAPSHOT_KEEP     local window, in snapshots               (default 56 = 14 days at 4/day)
#   COM8_SNAPSHOT_VOL      the archive volume's mount point          (default: none — archiving off)
#   COM8_SNAPSHOT_ARCHIVE  the archive directory                     (default $COM8_SNAPSHOT_VOL/com8-snapshots)
#

if [ "${BASH_VERSINFO[0]:-0}" -lt 4 ]; then
  for _b in /opt/homebrew/bin/bash /usr/local/bin/bash; do
    [ ! -x "$_b" ] || exec "$_b" "$0" "$@"
  done
  echo "com8-snapshot needs Bash 4+" >&2; exit 1
fi

set -uo pipefail

# launchd hands jobs a minimal PATH (tmux is Homebrew's; mount is in /sbin). The
# invoking PATH stays first so a shell — or a test — decides what is found.
export PATH="${PATH:-}:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
# tss talks to tmux's default socket dir; the interactive server uses /tmp too,
# so an unset TMUX (launchd) still reaches the same server.
export TMUX_TMPDIR="${TMUX_TMPDIR:-/tmp}"
# tss separates its TSV columns with tabs in tmux `-F` format strings. In the
# C/POSIX locale (launchd's default) tmux sanitizes the tab to "_", mangling
# every column so agent detection fails silently. Force a UTF-8 locale.
export LANG="${LANG:-en_US.UTF-8}"
export LC_ALL="${LC_ALL:-en_US.UTF-8}"

_HS_HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
COM8_PROFILE_CONFIG="${COM8_PROFILE_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/com8/profiles}"
# Private configuration is trusted shell, the same file every profile tool loads.
[ ! -f "$COM8_PROFILE_CONFIG/local.sh" ] || . "$COM8_PROFILE_CONFIG/local.sh"
COM8_PROFILE_STATE="${COM8_PROFILE_STATE:-${XDG_STATE_HOME:-$HOME/.local/state}/com8/workstation}"
FNS="${COM8_SNAPSHOT_FNS:-$_HS_HERE/../../fns/snapshots}"   # defines tss/tsr and their helpers
SESS_DIR="${COM8_SNAPSHOT_DIR:-$COM8_PROFILE_STATE/sessions}" # tss writes here; tsr reads here
LOG="${COM8_SNAPSHOT_LOG:-$COM8_PROFILE_STATE/snapshots.log}"
# Local fast-access window, counted in SNAPSHOTS (not days): 56 = 14 days at the
# 6-hourly cadence.
KEEP="${COM8_SNAPSHOT_KEEP:-56}"
# The archive volume = the permanent archive. Generic installs have none.
VOL="${COM8_SNAPSHOT_VOL:-}"
ARCHIVE_DIR="${COM8_SNAPSHOT_ARCHIVE:-${VOL:+$VOL/com8-snapshots}}"

# The schedule's label is scoped per installation home by schedule.py; the
# status line asks it rather than guessing.

# Current scheme, and the pre-cadence one that must keep working forever.
SNAP_GLOB='snap-[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]-[0-9][0-9][0-9][0-9]'
LEGACY_GLOB='nightly-[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]'
SCHEDULE_DESC='every 6h at 03:00, 09:00, 15:00, 21:00 (missed runs fire once on next wake)'

_now() { date '+%Y-%m-%dT%H:%M:%S'; }

# Remove a snapshot-sized directory that this script created. Both parts of the
# path must be non-empty and the directory must live inside the sessions dir:
# the guard that makes an rm here unable to reach anything else.
_drop_dir() { # <sessions_dir> <entry>
  [[ -n "$1" && -n "$2" && "$2" != */* && "$2" != .. && "$2" != . ]] || return 1
  [[ -d "$1/$2" || -L "$1/$2" ]] || return 0
  rm -rf -- "${1:?}/${2:?}"
}

# PRIVACY. Everything this script creates — state parents, the sessions dir,
# the log, the run lock, manifests, .archived markers, the archive dir — is
# created under a scoped `umask 077` (a subshell, never the caller's umask:
# the module is also sourced), so a launchd run inherits nothing permissive.
# Existing files and directories are never re-moded; a snapshot dir keeps the
# mode tss gave it, and rsync -a keeps the source's modes on every copy, so a
# copy that was never private is restored as it is, not claimed private.

# Every snapshot dir under <root>, oldest first, across BOTH naming schemes.
# Sorting the bare names would be lexicographic and therefore wrong: it puts
# every `nightly-*` before every `snap-*` regardless of date. Sort on an
# explicit YYYY-MM-DD-HHMM key instead (legacy nights ran at 03:00).
_snap_dirs() { # <root> [-r]
  local root="$1" rev=""
  [[ "${2:-}" == "-r" ]] && rev="-r"
  find "$root" -maxdepth 1 -type d \( -name "$SNAP_GLOB" -o -name "$LEGACY_GLOB" \) 2>/dev/null \
    | while IFS= read -r d; do
        local b="${d##*/}"
        case "$b" in
          snap-*)    printf '%s\t%s\n' "${b#snap-}"          "$d" ;;
          nightly-*) printf '%s\t%s\n' "${b#nightly-}-0300"  "$d" ;;
        esac
      done | sort $rev | cut -f2-
}

# Append one aligned line to the log AND echo it (so the job's stdout log shows it too).
_logline() { # <status> <detail>
  local line; line="$(printf '%s  %-5s  %s' "$(_now)" "$1" "$2")"
  ( umask 077; mkdir -p "$(dirname "$LOG")" && printf '%s\n' "$line" >> "$LOG" ) 2>/dev/null
  printf '%s\n' "$line"
}

# Resolve symlinks in every existing ancestor of a path (the leaf may not
# exist yet); the roots below are compared only in this form.
_realpath() { python3 -c 'import os, sys; print(os.path.realpath(sys.argv[1]))' "$1"; }

# 0 iff <path> is exactly a mount point in mount(8)'s table: the whole
# mount-point field is compared, never a prefix or a pattern. The table is
# read into a variable first — a pipe into grep -q can end with SIGPIPE, which
# pipefail reports as "not mounted".
_is_mounted() { # <path>
  local want="$1" real table line mp
  real="$(_realpath "$1")"
  table="$(mount 2>/dev/null)" || return 1
  while IFS= read -r line; do
    mp="${line#* on }"; [[ "$mp" != "$line" ]] || continue
    mp="${mp% (*}"            # macOS/BSD: "... on /path (opts)"
    mp="${mp% type *}"        # Linux:     "... on /path type fs (opts)"
    [[ "$mp" == "$want" || "$mp" == "$real" ]] && return 0
  done <<< "$table"
  return 1
}

# 0: the archive volume is genuinely mounted and writable (not a leftover empty
# mount-point directory on the internal disk); 1: configured but not mounted;
# 2: no archive volume configured at all.
_drive_ready() {
  [[ -n "$VOL" ]] || return 2
  [[ -d "$VOL" && -w "$VOL" ]] || return 1
  _is_mounted "$VOL" || return 1
}

# 0 iff the archive directory resolves inside the mounted volume and the local
# sessions directory and the archive are disjoint — neither is the other, an
# ancestor or a descendant, symlinks resolved. Otherwise "archiving" would read
# the very bytes prune is about to delete, or write off the volume it claims.
# Sets $_ROOTS_WHY when it refuses.
_ROOTS_WHY=""
_archive_roots_ok() {
  local vol arch sess
  vol="$(_realpath "$VOL")"; arch="$(_realpath "$ARCHIVE_DIR")"; sess="$(_realpath "$SESS_DIR")"
  case "$arch" in
    "$vol"|"$vol"/*) ;;
    *) _ROOTS_WHY="archive $ARCHIVE_DIR resolves to $arch, outside the archive volume $vol"; return 1 ;;
  esac
  case "$arch" in
    "$sess"|"$sess"/*) _ROOTS_WHY="archive $arch is the local sessions dir $sess, or inside it"; return 1 ;;
  esac
  case "$sess" in
    "$arch"|"$arch"/*) _ROOTS_WHY="local sessions dir $sess is inside the archive $arch"; return 1 ;;
  esac
  return 0
}

# 0 iff the archive can be used: mounted (1: not; 2: none configured) and its
# roots sound (3: refused, see $_ROOTS_WHY). _archive_state says which.
_archive_usable() {
  _drive_ready || return $?
  _archive_roots_ok || return 3
}
_archive_state() {
  _archive_usable
  case $? in
    0) printf 'archive volume mounted at %s' "$VOL" ;;
    2) printf 'no archive volume configured (COM8_SNAPSHOT_VOL)' ;;
    3) printf 'archive REFUSED: %s' "$_ROOTS_WHY" ;;
    *) printf 'archive volume %s not mounted' "$VOL" ;;
  esac
}

_safe_name() { [[ "$1" =~ ^[A-Za-z0-9._-]+$ && "$1" != *..* ]]; }

# Resolve a user-supplied token to ONE snapshot name present under <root>.
# Accepts a full name (snap-… / nightly-…), a YYYY-MM-DD-HHMM, or a bare
# YYYY-MM-DD — which may name the day's one legacy nightly, or several snaps.
_resolve_snap() { # <root> <token>
  local root="$1" tok="$2" d
  case "$tok" in
    snap-*|nightly-*) printf '%s' "$tok"; return 0 ;;
    [0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]-[0-9][0-9][0-9][0-9]) printf 'snap-%s' "$tok"; return 0 ;;
    [0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]) : ;;
    *) echo "not a snapshot name or date: $tok" >&2; return 1 ;;
  esac
  local -a cands=()
  [[ -d "$root/nightly-$tok" ]] && cands+=("nightly-$tok")
  while IFS= read -r d; do
    [[ "${d##*/}" == snap-"$tok"-* ]] && cands+=("${d##*/}")
  done < <(_snap_dirs "$root")
  case ${#cands[@]} in
    0) echo "no snapshot for $tok under $root" >&2; return 1 ;;
    1) printf '%s' "${cands[0]}"; return 0 ;;
    *) { printf '%s is ambiguous — %d snapshots that day:\n' "$tok" "${#cands[@]}"
         printf '  %s\n' "${cands[@]}"; } >&2; return 1 ;;
  esac
}

# Write a sha256 manifest covering every file in a snapshot dir.
_manifest() { # <dir>
  ( umask 077; cd "$1" && find . -type f ! -name '.manifest.sha256' ! -name '.archived' -print0 \
      | sort -z | xargs -0 shasum -a 256 > .manifest.sha256 )
}

# 0 iff <dir> is exactly what its manifest says: the manifest is a regular
# file of "<sha256>  ./relative" lines (or "*./relative", shasum's binary mode
# — both GNU formats existing manifests use) whose paths stay inside the
# snapshot, every listed file matches, the regular-file inventory (marker and
# manifest aside) is exactly the listing, and nothing else — no symlink, no
# special entry — is present. 2 without a manifest.
_verify_dir() { # <dir>
  local dir="$1" m="$1/.manifest.sha256" want have stray
  [[ -f "$m" && ! -L "$m" ]] || return 2
  [[ -z "$(grep -Ev '^[0-9a-f]{64} [ *]\./[^/]' "$m")" ]] || return 1
  want="$(sed -E 's/^[0-9a-f]{64} [ *]//' "$m")"
  [[ -z "$(printf '%s\n' "$want" | grep -E '(^|/)\.\.(/|$)|/\./|//')" ]] || return 1
  stray="$(cd "$dir" && find . -mindepth 1 ! -type f ! -type d | head -n 1)"
  [[ -z "$stray" ]] || return 1
  ( cd "$dir" && shasum -a 256 -c --status .manifest.sha256 ) || return 1
  have="$(cd "$dir" && find . -type f ! -name '.manifest.sha256' ! -name '.archived' | sort)"
  [[ "$(printf '%s\n' "$want" | sort)" == "$have" ]]
}

# 0 iff the archive holds <name> as an exact, verified copy of the local <dir>:
# the archive copy passes _verify_dir, the local files satisfy that same
# manifest, the local regular-file inventory is exactly its listing, and the
# local copy holds no symlink or special entry (nothing the archive could have
# carried). Only then is the archive copy byte-identical to what would be
# deleted. The caller has already checked that the archive is usable.
_archived_verified() { # <local_dir> <name>
  local dest="$ARCHIVE_DIR/$2" stray want have
  [[ -d "$dest" && ! -L "$dest" ]] || return 1
  _verify_dir "$dest" || return 1
  stray="$(cd "$1" && find . -mindepth 1 ! -type f ! -type d | head -n 1)"
  [[ -z "$stray" ]] || return 1
  ( cd "$1" && shasum -a 256 -c --status "$dest/.manifest.sha256" ) || return 1
  want="$(sed -E 's/^[0-9a-f]{64} [ *]//' "$dest/.manifest.sha256" | sort)"
  have="$(cd "$1" && find . -type f ! -name '.manifest.sha256' ! -name '.archived' | sort)"
  [[ "$want" == "$have" ]]
}

_take_snapshot() { # <name>  -> logs OK/SKIP/ERROR; returns 0 unless a hard error
  local name="$1"
  command -v tmux >/dev/null 2>&1 || { _logline SKIP  "tmux not on PATH";       return 0; }
  tmux list-sessions >/dev/null 2>&1 || { _logline SKIP "no tmux server running"; return 0; }
  [[ -r "$FNS" ]]                  || { _logline ERROR "tmux helpers missing: $FNS"; return 1; }

  # Atomic lock (mkdir): a wake-from-sleep double-fire or overlapping manual run
  # can't race the same snapshot dir.
  local lock="$SESS_DIR/.${name}.lock"
  if ! ( umask 077; mkdir "$lock" 2>/dev/null ); then _logline SKIP "locked ($name already in progress)"; return 0; fi

  # Snapshot to a temp name, then atomically promote — a crash mid-write can't
  # leave a half-valid final snapshot. Subshell so sourcing the helpers can't
  # leak. tss saves under $COM8_PROFILE_STATE/sessions; point that at our dir.
  local tmp="${name}.partial" out rc state="${SESS_DIR%/sessions}"
  _drop_dir "$SESS_DIR" "$tmp"
  out="$( set +u; export COM8_PROFILE_STATE="$state"; source "$FNS" >/dev/null 2>&1; tss "$tmp" 2>&1 )"; rc=$?
  if [[ $rc -eq 0 && ! -f "$SESS_DIR/$tmp/meta.tsv" && -f "$state/sessions/$tmp/meta.tsv" ]]; then
    mv "$state/sessions/$tmp" "$SESS_DIR/$tmp"   # a sessions dir not named "sessions"
  fi
  if [[ $rc -eq 0 && -f "$SESS_DIR/$tmp/meta.tsv" ]]; then
    _drop_dir "$SESS_DIR" "$name"; mv "$SESS_DIR/$tmp" "$SESS_DIR/$name"
  else
    _drop_dir "$SESS_DIR" "$tmp"; rmdir "$lock" 2>/dev/null
    _logline ERROR "tss failed (rc=$rc): ${out//$'\n'/ | }"; return 1
  fi
  rmdir "$lock" 2>/dev/null

  local meta="$SESS_DIR/$name/meta.tsv" s w p a
  s=$(awk -F'\t' '$1=="sessions"{print $2}' "$meta")
  w=$(awk -F'\t' '$1=="windows"{print $2}'  "$meta")
  p=$(awk -F'\t' '$1=="panes"{print $2}'    "$meta")
  a=$(awk -F'\t' '$1=="agents"{print $2}'   "$meta")
  _logline OK "sessions=$s windows=$w panes=$p agents=$a  -> $name"
}

# Mirror every not-yet-archived local snapshot to the archive, verified.
cmd_archive() {
  _archive_usable; local dr=$?
  if (( dr != 0 )); then
    _logline "$([[ $dr == 3 ]] && echo ERROR || echo ARCH)" "$(_archive_state) — keeping all local, nothing pruned"
    return 1
  fi
  ( umask 077; mkdir -p "$ARCHIVE_DIR" ) || { _logline ERROR "cannot create archive dir $ARCHIVE_DIR"; return 1; }
  local snap name dest new=0 already=0 fail=0
  while IFS= read -r snap; do
    name="$(basename "$snap")"; dest="$ARCHIVE_DIR/$name"
    if [[ -f "$snap/.archived" ]] && _archived_verified "$snap" "$name"; then already=$((already+1)); continue; fi
    _manifest "$snap"
    if rsync -a --exclude='.archived' "$snap/" "$dest/" 2>/dev/null && _archived_verified "$snap" "$name"; then
      ( umask 077; printf '%s\n' "$(_now)" > "$snap/.archived" ); new=$((new+1))
    else
      fail=$((fail+1)); _logline ERROR "archive FAILED for $name (kept local, will retry)"
    fi
  done < <(_snap_dirs "$SESS_DIR")
  _logline ARCH "mirrored $new new, $already already, $fail failed -> $ARCHIVE_DIR"
  [[ $fail -eq 0 ]]
}

# Keep newest N local snapshots; delete an older one only when the mounted
# archive holds a verified, byte-identical copy of it.
cmd_prune() {
  local keep="${1:-$KEEP}"
  [[ "$keep" =~ ^[0-9]+$ ]] || { echo "prune: N must be a number" >&2; return 1; }
  local -a dirs=()
  while IFS= read -r d; do dirs+=("$d"); done < <(_snap_dirs "$SESS_DIR")   # oldest first
  local total=${#dirs[@]} n=0 removed=0 kept=0 i
  (( total > keep )) && n=$(( total - keep ))
  if (( n > 0 )); then
    _archive_usable; local dr=$?
    if (( dr != 0 )); then
      echo "prune: $(_archive_state) — nothing deleted ($n older than the keep window kept locally)"
      return 0
    fi
  fi
  for (( i=0; i<n; i++ )); do
    if _archived_verified "${dirs[i]}" "${dirs[i]##*/}"; then
      _drop_dir "$SESS_DIR" "${dirs[i]##*/}" && removed=$((removed+1))
    else kept=$((kept+1)); fi
  done
  echo "prune: removed $removed verified-archived old snapshots; kept newest $keep + $kept not-yet-verified locally"
}

cmd_run() {
  local name="${1:-snap-$(date '+%Y-%m-%d-%H%M')}"
  _safe_name "$name" || { _logline ERROR "refusing unsafe snapshot name: $name"; return 1; }
  ( umask 077; mkdir -p "$SESS_DIR" )
  local rc=0
  _take_snapshot "$name" || rc=1
  # Always mirror the backlog to the archive, then prune only what is verified
  # there — this runs even when there is no new snapshot, so a reconnected
  # archive catches up. A failed snapshot still fails the run.
  cmd_archive || true
  cmd_prune "$KEEP" >/dev/null
  return $rc
}

cmd_restore() {
  local tok="${1:-}" name
  [[ -n "$tok" ]] || { echo "restore: usage: com8-snapshot restore <name|YYYY-MM-DD|YYYY-MM-DD-HHMM>" >&2; return 1; }
  # Anything already local needs no archive at all.
  if name="$(_resolve_snap "$SESS_DIR" "$tok" 2>/dev/null)" && [[ -d "$SESS_DIR/$name" ]]; then
    echo "restore: $name already present locally — run: tsr $name"; return 0
  fi
  _archive_usable || { echo "restore: $(_archive_state)" >&2; return 1; }
  name="$(_resolve_snap "$ARCHIVE_DIR" "$tok")" || return 1
  _safe_name "$name" || { echo "restore: bad name" >&2; return 1; }
  [[ -d "$ARCHIVE_DIR/$name" ]] || { echo "restore: $name not in the archive" >&2; return 1; }
  # A copy that does not satisfy its own manifest is not restored: the
  # destination stays exactly as it was (absent), and the archive is left alone.
  if ! _verify_dir "$ARCHIVE_DIR/$name"; then
    echo "restore: REFUSED — archived $name fails checksum verification (or has no manifest); nothing written to $SESS_DIR/$name" >&2
    return 1
  fi
  ( umask 077; mkdir -p "$SESS_DIR" )
  local tmpname=".$name.restoring" tmp="$SESS_DIR/.$name.restoring"
  _drop_dir "$SESS_DIR" "$tmpname"
  if rsync -a "$ARCHIVE_DIR/$name/" "$tmp/" 2>/dev/null && _verify_dir "$tmp"; then
    ( umask 077; printf '%s\n' "$(_now)" > "$tmp/.archived" )
    mv "$tmp" "$SESS_DIR/$name" \
      && echo "restored $name from the archive (verified) -> run: tsr $name   (or: com8-workstation shell tsr $name)"
  else
    _drop_dir "$SESS_DIR" "$tmpname"
    echo "restore: FAILED copying $name; nothing written to $SESS_DIR/$name" >&2
    return 1
  fi
}

cmd_verify() {
  _archive_usable || { echo "verify: $(_archive_state)" >&2; return 1; }
  local d ok=0 bad=0 nomani=0
  while IFS= read -r d; do
    if _verify_dir "$d"; then ok=$((ok+1))
    elif [[ -f "$d/.manifest.sha256" ]]; then bad=$((bad+1)); echo "CORRUPT: $(basename "$d")"
    else nomani=$((nomani+1)); fi
  done < <(_snap_dirs "$ARCHIVE_DIR")
  echo "verify: $ok ok, $bad corrupt, $nomani without manifest  ($ARCHIVE_DIR)"
  [[ $bad -eq 0 ]]
}

# "<label> <yes|no|foreign <path>|unknown>" from schedule.py's read-only status.
_schedule_brief() {
  python3 "$_HS_HERE/schedule.py" status --home "$HOME" --brief 2>/dev/null \
    || printf '%s unknown\n' "com.communicate.com8.snapshots"
}

cmd_status() {
  local brief label state loaded
  brief="$(_schedule_brief)"; label="${brief%% *}"; state="${brief#* }"
  case "$state" in
    yes)       loaded="yes" ;;
    foreign*)  loaded="a job with this label is loaded from another file: ${state#foreign }" ;;
    unknown)   loaded="unknown (service manager not available)" ;;
    *)         loaded="no  (run: com8-snapshot schedule install)" ;;
  esac
  local local_n arch_n
  local_n=$(_snap_dirs "$SESS_DIR" | wc -l | tr -d ' ')
  if _archive_usable; then arch_n=$(_snap_dirs "$ARCHIVE_DIR" | wc -l | tr -d ' '); else arch_n="?"; fi
  printf 'label:     %s\n' "$label"
  printf 'loaded:    %s\n' "$loaded"
  printf 'schedule:  %s\n' "$SCHEDULE_DESC"
  printf 'local:     %s  (keep newest %s snapshots in %s)\n' "$local_n" "$KEEP" "$SESS_DIR"
  printf 'archive:   %s snapshots in %s  [%s]\n' "$arch_n" "${ARCHIVE_DIR:-<none>}" "$(_archive_state)"
  printf 'log:       %s\n' "$LOG"
  printf -- '--- recent log ---\n'
  tail -n 8 "$LOG" 2>/dev/null || echo "(no log yet)"
}

cmd_log() {
  if [[ "${1:-}" == "-f" ]]; then tail -f "$LOG"; else cat "$LOG" 2>/dev/null || echo "(no log yet at $LOG)"; fi
}

cmd_list() {
  local d m ts counts mark
  _snap_dirs "$SESS_DIR" -r | while read -r d; do
    m="$d/meta.tsv"; ts="?"; counts=""
    [[ -f "$d/.archived" ]] && mark="*" || mark=" "
    if [[ -f "$m" ]]; then
      ts=$(awk -F'\t' '$1=="saved"{print $2}' "$m")
      counts=$(awk -F'\t' '$1=="sessions"{s=$2}$1=="windows"{w=$2}$1=="panes"{p=$2}$1=="agents"{a=$2}END{printf "s=%s w=%s p=%s a=%s",s,w,p,a}' "$m")
    fi
    printf '%s %-26s  %s  %s\n' "$mark" "$(basename "$d")" "$ts" "$counts"
  done
  echo "(* = archived)"
}

# Sourced by the test suite: define the helpers, dispatch nothing. Executed
# normally (including by the schedule), fall through to the dispatcher below.
[[ "${BASH_SOURCE[0]}" == "$0" ]] || return 0

case "${1:-run}" in
  run)            shift; cmd_run "$@" ;;
  archive)        cmd_archive; cmd_prune "$KEEP" >/dev/null ;;
  restore)        shift; cmd_restore "$@" ;;
  verify)         cmd_verify ;;
  status)         cmd_status ;;
  log)            shift; cmd_log "$@" ;;
  list|ls)        cmd_list ;;
  prune)          shift; cmd_prune "$@" ;;
  # The invocation's HOME is the selected installation (an isolated wrapper
  # stays scoped); a later --home from the caller still wins.
  schedule)       shift; exec python3 "$_HS_HERE/schedule.py" --home "$HOME" "$@" ;;
  -h|--help|help) sed -n '2,48p' "$0" | sed 's/^#\{0,1\} \{0,1\}//' ;;
  *) echo "com8-snapshot: unknown command '${1}' (try: run archive restore verify status log list prune schedule)" >&2; exit 2 ;;
esac
