# FZF device hub (unified: Tailscale + manual hosts)
_mesh_hub() {
  # Tailscale refresh is optional — manual hosts work without it
  _mesh_refresh 2>/dev/null

  local devices
  devices=$(_mesh_all_devices ssh)
  [[ -z "$devices" ]] && { echo "mesh: no devices available."; return 1; }

  local src
  src=$(_mesh_src)

  local fzf_opts=()
  # Only a real pane gets fzf's own popup; inside a display-popup (the `prefix m`
  # keybinding runs `mesh` -> _mesh_hub) $TMUX_PANE is empty, so use plain fzf and
  # avoid a popup-inside-a-popup.
  [[ -n "$TMUX" && -n "$TMUX_PANE" ]] && fzf_opts+=(--tmux 80%,60%)

  local selected
  selected=$(echo "$devices" | \
    fzf "${fzf_opts[@]}" \
      --expect "ctrl-v" \
      --header "enter: ssh  ctrl-v: vnc  ctrl-p: ping  ctrl-i: info" \
      --delimiter $'\t' \
      --with-nth 1,2,3,4 \
      --preview "source '$src' && _mesh_preview {1} {3}" \
      --preview-window "right:50%" \
      --bind "ctrl-p:execute(
        if [[ {3} == manual ]]; then
          ping -c 3 \$(echo {4} | cut -d@ -f2) 2>&1 | head -10
        else
          tailscale ping -c 3 {4} 2>&1 | head -10
        fi
      )+refresh-preview" \
      --bind "ctrl-i:execute(
        source '$src' && _mesh_preview {1} {3} | less
      )") || return 0

  # With --expect, the first line is the key pressed (empty for plain enter),
  # the second line is the selected row.
  local key row
  key=$(printf '%s\n' "$selected" | sed -n 1p)
  row=$(printf '%s\n' "$selected" | sed -n 2p)

  local device status
  IFS=$'\t' read -r device _ status _ _ _ <<< "$row"
  [[ -z "$device" ]] && return 0

  if [[ "$key" == "ctrl-v" ]]; then
    if [[ "$status" == "manual" ]]; then
      _mesh_vnc_manual "$device"
    else
      _mesh_vnc "$device"
    fi
  else
    if [[ "$status" == "manual" ]]; then
      _mesh_ssh_manual "$device"
    else
      _mesh_ssh "$device"
    fi
  fi
}

# Inline status table (shows probe data when available)
_mesh_status() {
  _mesh_refresh || { echo "mesh: cannot reach tailscale."; return 1; }

  local green='\033[32m'
  local dim='\033[2m'
  local bold='\033[1m'
  local cyan='\033[36m'
  local reset='\033[0m'
  local profile_dir="${COM8_PROFILE_STATE:-${XDG_STATE_HOME:-$HOME/.local/state}/com8/workstation}/mesh/profiles"

  printf "${bold}  %-24s %-8s %-8s %-18s %-7s %s${reset}\n" \
    "DEVICE" "OS" "STATUS" "IP" "LOAD" "MEM"

  while IFS=$'\t' read -r name os status ip relay is_self; do
    local indicator name_display load_str mem_str

    if [[ "$status" == "online" ]]; then
      indicator="${green}●${reset}"
    else
      indicator="${dim}○${reset}"
    fi

    if [[ "$is_self" == "self" ]]; then
      name_display="$name *"
    else
      name_display="$name"
    fi

    # Pull probe data if cached
    load_str="--"
    mem_str="--"
    local profile="$profile_dir/$name.json"
    if [[ -f "$profile" ]] && ! jq -e '.error' "$profile" >/dev/null 2>&1; then
      local l1 mem_used mem_total
      l1=$(jq -r '.load[0]' "$profile" 2>/dev/null)
      mem_used=$(jq -r '.mem_used_mb' "$profile" 2>/dev/null)
      mem_total=$(jq -r '.mem_total_mb' "$profile" 2>/dev/null)
      [[ "$l1" != "null" && -n "$l1" ]] && load_str="$l1"
      if [[ "$mem_total" != "null" && -n "$mem_total" && "$mem_total" != "0" ]]; then
        mem_str="$(( mem_used / 1024 ))G/$(( mem_total / 1024 ))G"
      fi
    fi

    if [[ "$status" == "online" ]]; then
      printf "${indicator} %-24s %-8s ${green}%-8s${reset} %-18s %-7s %s\n" \
        "$name_display" "$os" "$status" "$ip" "$load_str" "$mem_str"
    else
      printf "${indicator} ${dim}%-24s %-8s %-8s %-18s %-7s %s${reset}\n" \
        "$name_display" "$os" "$status" "$ip" "--" "--"
    fi
  done < <(_mesh_devices all)
}

# Per-device SSH overrides for Tailscale devices live in mesh/users.json:
#   { "dev": "user" }                            user only
#   { "dev": { "user": "u", "port": 8022 } }     either key optional
# The port form exists for devices whose sshd cannot sit on 22, e.g. a phone
# running Termux (8022). Manual hosts carry their own port in hosts.json.

# Resolve SSH user for a Tailscale device
_mesh_device_user() {
  local device="$1"
  if _mesh_is_manual "$device"; then
    jq -r --arg n "$device" '.[] | select(.name == $n) | .user' "$COM8_PROFILE_CONFIG/mesh/hosts.json"
    return
  fi
  local users_file="${COM8_PROFILE_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/com8/profiles}/mesh/users.json"
  if [[ -f "$users_file" ]]; then
    local user
    user=$(jq -r --arg name "$device" '
      .[$name] // empty | if type == "object" then (.user // empty) else . end
    ' "$users_file" 2>/dev/null)
    [[ -n "$user" ]] && { echo "$user"; return; }
  fi
  echo "${MESH_SSH_USER:-$USER}"
}

# Resolve SSH port override for a Tailscale device; empty when unset or 22.
_mesh_device_port() {
  local device="$1"
  if _mesh_is_manual "$device"; then
    jq -r --arg n "$device" '.[] | select(.name == $n) | .port // 22' "$COM8_PROFILE_CONFIG/mesh/hosts.json"
    return
  fi
  local users_file="${COM8_PROFILE_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/com8/profiles}/mesh/users.json"
  [[ -f "$users_file" ]] || return 0
  local port
  port=$(jq -r --arg name "$device" '
    .[$name] // empty | if type == "object" then (.port // empty) else empty end
  ' "$users_file" 2>/dev/null)
  [[ -n "$port" && "$port" != "22" ]] && echo "$port"
  return 0
}

# ssh options for a device, as words: "-p <port>" or nothing.
_mesh_ssh_opts() {
  local port; port=$(_mesh_device_port "$1")
  [[ -n "$port" ]] && echo "-p $port"
  return 0
}

# Resolve Tailscale device name to its IP
_mesh_device_ip() {
  local device="$1"
  if _mesh_is_manual "$device"; then
    jq -r --arg n "$device" '.[] | select(.name == $n) | .host' "$COM8_PROFILE_CONFIG/mesh/hosts.json"
    return
  fi
  local cache="${COM8_PROFILE_STATE:-${XDG_STATE_HOME:-$HOME/.local/state}/com8/workstation}/mesh/devices.json"
  jq -r --arg name "$device" '
    [.Self, (.Peer | to_entries[].value)] |
    map(select((.DNSName | split(".")[0]) == $name)) |
    .[0].TailscaleIPs[0] // empty
  ' "$cache"
}

# SSH into a device
_mesh_ssh() {
  local window_mode=false
  local device=""

  # Parse flags
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -w) window_mode=true; shift ;;
      *)  device="$1"; shift ;;
    esac
  done

  [[ -z "$device" ]] && { device=$(_mesh_pick) || return 1; }

  # Self: just open a local shell
  if _mesh_is_self "$device"; then
    echo "mesh: $device is this machine."
    return 0
  fi

  local ip
  ip=$(_mesh_device_ip "$device")
  [[ -z "$ip" ]] && { echo "mesh: cannot resolve IP for $device"; return 1; }

  local suser sopts
  suser=$(_mesh_device_user "$device")
  sopts=$(_mesh_ssh_opts "$device")
  local -a ssh_args=(); read -ra ssh_args <<< "$sopts"
  local ssh_cmd; printf -v ssh_cmd '%q ' ssh "${ssh_args[@]}" -- "$suser@$ip"

  # Outside tmux: direct SSH
  if [[ -z "$TMUX" ]]; then
    ssh "${ssh_args[@]}" -- "$suser@$ip"
    return
  fi

  # Inside tmux: new pane or window
  if $window_mode; then
    local pane_id
    pane_id=$(tmux new-window -n "$device" -P -F '#{pane_id}')
    tmux send-keys -t "$pane_id" "$ssh_cmd" C-m
  else
    local pane_id
    pane_id=$(tmux split-window -h -P -F '#{pane_id}')
    tmux send-keys -t "$pane_id" "$ssh_cmd" C-m
  fi
}

# SSH into a manual (non-Tailscale) host
_mesh_ssh_manual() {
  local window_mode=false
  local name=""

  while [[ $# -gt 0 ]]; do
    case "$1" in
      -w) window_mode=true; shift ;;
      *)  name="$1"; shift ;;
    esac
  done

  local hosts_file="${COM8_PROFILE_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/com8/profiles}/mesh/hosts.json"
  local host user port
  read -r host user port < <(
    jq -r --arg name "$name" '
      .[] | select(.name == $name) |
      [.host, .user, (.port // 22 | tostring)] | @tsv
    ' "$hosts_file"
  )

  [[ -z "$host" ]] && { echo "mesh: unknown host '$name'"; return 1; }

  local -a ssh_args=()
  [[ "$port" != "22" ]] && ssh_args+=(-p "$port")
  local ssh_cmd; printf -v ssh_cmd '%q ' ssh "${ssh_args[@]}" -- "$user@$host"

  # Outside tmux: direct SSH
  if [[ -z "$TMUX" ]]; then
    ssh "${ssh_args[@]}" -- "$user@$host"
    return
  fi

  # Inside tmux: new pane or window
  if $window_mode; then
    local pane_id
    pane_id=$(tmux new-window -n "$name" -P -F '#{pane_id}')
    tmux send-keys -t "$pane_id" "$ssh_cmd" C-m
  else
    local pane_id
    pane_id=$(tmux split-window -h -P -F '#{pane_id}')
    tmux send-keys -t "$pane_id" "$ssh_cmd" C-m
  fi
}

# Unified SSH: routes to tailscale or manual based on host type
_mesh_connect() {
  local name=""
  local flags=()

  while [[ $# -gt 0 ]]; do
    case "$1" in
      -w) flags+=("-w"); shift ;;
      *)  name="$1"; shift ;;
    esac
  done

  [[ -z "$name" ]] && { name=$(_mesh_pick) || return 1; }

  if _mesh_is_manual "$name"; then
    _mesh_ssh_manual "${flags[@]}" "$name"
  else
    _mesh_ssh "${flags[@]}" "$name"
  fi
}

# ------------------------------------------------------------------------------
# VNC / screen sharing
# ------------------------------------------------------------------------------

# Open a VNC session to a host/IP.
# macOS: built-in Screen Sharing via `open vnc://`. Linux: $MESH_VNC_CMD or vncviewer.
# Usage: _mesh_open_vnc <host-or-ip> [user]
_mesh_open_vnc() {
  local target="$1" port="${2:-${MESH_VNC_PORT:-}}" user="$3"
  [[ -z "$target" ]] && { echo "mesh: no VNC target."; return 1; }

  local hostport="$target"
  [[ -n "$port" ]] && hostport="$target:$port"

  if [[ "$(uname)" == "Darwin" ]]; then
    local url="vnc://"
    [[ -n "$user" ]] && url+="$user@"
    url+="$hostport"
    echo "mesh: opening $url"
    open "$url"
  elif [[ -n "$MESH_VNC_CMD" ]]; then
    MESH_VNC_TARGET="$hostport" MESH_VNC_HOST="$target" MESH_VNC_USER="$user" \
      eval "$MESH_VNC_CMD"
  elif command -v vncviewer >/dev/null 2>&1; then
    vncviewer "$hostport"
  else
    echo "mesh: no VNC client found. Set MESH_VNC_CMD or install vncviewer."
    return 1
  fi
}

# VNC into a Tailscale device
_mesh_vnc() {
  local device="$1"
  [[ -z "$device" ]] && { device=$(_mesh_pick) || return 1; }

  if ! _mesh_is_manual "$device" && _mesh_is_self "$device"; then
    echo "mesh: $device is this machine."
    return 0
  fi

  local ip
  ip=$(_mesh_device_ip "$device")
  [[ -z "$ip" ]] && { echo "mesh: cannot resolve IP for $device"; return 1; }

  _mesh_open_vnc "$ip"
}

# VNC into a manual (non-Tailscale) host.
#
# Manual hosts ride untrusted networks (no Tailscale/WireGuard wrapper), so by
# default we tunnel VNC through SSH: the (weakly-encrypted) VNC stream rides
# inside the SSH pipe, and the remote VNC server only needs to listen on its
# own localhost — never exposed to the network. Opt out with MESH_VNC_NO_TUNNEL=1
# (e.g. a trusted LAN where the server is reachable directly).
_mesh_vnc_manual() {
  local name="$1"
  local hosts_file="${COM8_PROFILE_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/com8/profiles}/mesh/hosts.json"
  local host user port
  read -r host user port < <(
    jq -r --arg name "$name" '
      .[] | select(.name == $name) | [.host, .user, (.port // 22 | tostring)] | @tsv
    ' "$hosts_file" 2>/dev/null
  )

  [[ -z "$host" ]] && { echo "mesh: unknown host '$name'"; return 1; }

  if [[ "$MESH_VNC_NO_TUNNEL" == "1" ]]; then
    echo "mesh: WARNING — VNC in the clear (no SSH tunnel). Auth + session are unencrypted."
    _mesh_open_vnc "$host"
    return
  fi

  local remote_port="${MESH_VNC_PORT:-5900}"
  local local_port="${MESH_VNC_LOCAL_PORT:-5901}"
  local wait="${MESH_VNC_TUNNEL_WAIT:-10}"

  # Reuse an existing tunnel if something is already listening locally,
  # otherwise stand one up. `sleep N` keeps it alive long enough to connect;
  # ssh then holds it open for the session and exits after you disconnect.
  if { exec 3<>"/dev/tcp/127.0.0.1/$local_port"; } 2>/dev/null; then
    exec 3>&- 3<&-
    echo "mesh: reusing existing tunnel on localhost:$local_port"
  else
    echo "mesh: tunneling VNC over SSH ($user@$host:$remote_port -> localhost:$local_port)"
    if ! ssh -f -o ExitOnForwardFailure=yes \
          -L "$local_port:localhost:$remote_port" \
          -p "$port" "$user@$host" "sleep $wait"; then
      echo "mesh: SSH tunnel failed — is a VNC server on $name listening on localhost:$remote_port?"
      return 1
    fi
  fi

  _mesh_open_vnc localhost "$local_port"
}

# Unified VNC: routes to tailscale or manual based on host type
_mesh_vnc_connect() {
  local name="$1"
  [[ -z "$name" ]] && { name=$(_mesh_pick) || return 1; }

  if _mesh_is_manual "$name"; then
    _mesh_vnc_manual "$name"
  else
    _mesh_vnc "$name"
  fi
}

# Run a command on a remote device
_mesh_run() {
  local device="$1"

  if [[ -z "$device" ]]; then
    device=$(_mesh_pick) || return 1
    echo "Command to run on $device:"
    read -r cmd
    [[ -z "$cmd" ]] && return 1
  else
    shift
    local cmd="$*"
    [[ -z "$cmd" ]] && { echo "Usage: mesh run <device> <command>"; return 1; }
  fi

  if ! _mesh_is_manual "$device" && _mesh_is_self "$device"; then
    echo "--- $device (local) ---"
    eval "$cmd"
  else
    echo "--- $device ---"
    local ip; ip=$(_mesh_device_ip "$device")
    local suser; suser=$(_mesh_device_user "$device")
    local -a sopts=(); read -ra sopts <<< "$(_mesh_ssh_opts "$device")"
    [[ -n "$ip" ]] || { echo "mesh: cannot resolve $device" >&2; return 1; }
    ssh "${sopts[@]}" -- "$suser@$ip" "$cmd"
  fi
}

# Ping device(s) via Tailscale
_mesh_ping() {
  local device="$1"

  if [[ -n "$device" ]]; then
    if _mesh_is_self "$device"; then
      echo "mesh: $device is this machine."
      return 0
    fi
    # Shared-in names don't resolve through MagicDNS; the cached IP always does.
    local ip
    ip=$(_mesh_device_ip "$device")
    tailscale ping -c 3 "${ip:-$device}"
    return
  fi

  # No device specified: ping all online compute devices
  _mesh_refresh || return 1
  local self_name
  self_name=$(jq -r '.Self.DNSName | split(".")[0]' "${COM8_PROFILE_STATE:-${XDG_STATE_HOME:-$HOME/.local/state}/com8/workstation}/mesh/devices.json")

  while IFS=$'\t' read -r name os status ip relay is_self; do
    [[ "$is_self" == "self" ]] && continue
    printf "%-24s " "$name"
    local result
    result=$(tailscale ping -c 1 --timeout 3s "${ip:-$name}" 2>&1 | head -1)
    echo "$result"
  done < <(_mesh_devices compute)
}

# Force cache refresh
_mesh_force_refresh() {
  local meta_file="${COM8_PROFILE_STATE:-${XDG_STATE_HOME:-$HOME/.local/state}/com8/workstation}/mesh/devices.meta"
  rm -f "$meta_file"
  _mesh_refresh && echo "mesh: cache refreshed." || echo "mesh: refresh failed."
}

# Live device detail popup (refreshes every 5s)
_mesh_detail() {
  local device="${1:-$(_mesh_pick)}"
  [[ -z "$device" ]] && return 1
  [[ -z "$TMUX" ]] && { echo "mesh detail requires tmux."; return 1; }

  # Export functions so the subshell can use them
  tmux display-popup -E -w 60% -h 50% -T " $device " \
    "bash -c '
      source \"${COM8_PROFILE_RUNTIME}/fns/mesh\"
      while true; do
        clear
        _mesh_probe \"$device\" >/dev/null 2>&1
        _mesh_probe_display \"$device\"
        echo \"  Press q to close, r to refresh now\"
        read -t 5 -n 1 key
        case \"\$key\" in
          q) break ;;
          r) rm -f \"\${COM8_PROFILE_STATE:-${XDG_STATE_HOME:-$HOME/.local/state}/com8/workstation}/mesh/profiles/$device.json\" ;;
        esac
      done
    '"
}

# Mesh monitor layout: main pane + stacked device monitors on right
# Usage: mesh monitor [command] [device1 device2 ...]
_mesh_terminal_command() {
  local device="$1" cmd="$2" ip suser port
  if ! _mesh_is_manual "$device" && _mesh_is_self "$device"; then
    printf '%s' "$cmd"
    return
  fi
  ip=$(_mesh_device_ip "$device")
  [[ -n "$ip" ]] || { printf 'mesh: cannot resolve %s\n' "$device" >&2; return 1; }
  suser=$(_mesh_device_user "$device")
  port=$(_mesh_device_port "$device")
  local -a args=(-t)
  [[ -z "$port" ]] || args+=(-p "$port")
  # The remote command is explicit shell input; preserve it as one SSH argument.
  printf '%q ' ssh "${args[@]}" -- "$suser@$ip" "$cmd"
}

_mesh_monitor() {
  [[ -z $TMUX ]] && { echo "mesh monitor requires tmux."; return 1; }

  local cmd="${1:-btop}"
  shift 2>/dev/null
  local -a devices

  # Use remaining args as device list, or auto-detect
  if [[ $# -gt 0 ]]; then
    devices=("$@")
  else
    while IFS=$'\t' read -r name _; do
      devices+=("$name")
    done < <(_mesh_devices compute)
  fi

  if (( ${#devices[@]} < 1 )); then
    echo "mesh: no online compute devices found."
    return 1
  fi

  # Resolve every target before changing the window.
  local -a commands=()
  local dev line i
  for dev in "${devices[@]}"; do
    line=$(_mesh_terminal_command "$dev" "$cmd") || return
    commands+=("$line")
  done
  local main_pane="$TMUX_PANE"
  tmux rename-window -t "$main_pane" "mesh-monitor"

  # First device gets right pane at 40%
  local side_pane
  side_pane=$(tmux split-window -h -p 40 -t "$main_pane" -P -F '#{pane_id}')

  local first_device="${devices[0]}"
  tmux send-keys -l -t "$side_pane" -- "${commands[0]}"
  tmux send-keys -t "$side_pane" Enter

  local mesh_map="$side_pane:$first_device"

  # Stack remaining devices vertically in the right column
  local prev="$side_pane"
  for ((i=1; i<${#devices[@]}; i++)); do
    local new_pane dev="${devices[$i]}"
    new_pane=$(tmux split-window -v -t "$prev" -P -F '#{pane_id}')

    tmux send-keys -l -t "$new_pane" -- "${commands[$i]}"
    tmux send-keys -t "$new_pane" Enter

    mesh_map+=",$new_pane:$dev"
    prev="$new_pane"
  done

  # Store pane-to-device mapping
  tmux set-option -w @mesh_panes "$mesh_map"
  tmux select-pane -t "$main_pane"
}

# Deploy an AI agent on a remote device
# Usage: mesh deploy <ai_command> [device]
_mesh_deploy() {
  local ai="$1"
  [[ -z "$ai" ]] && { echo "Usage: mesh deploy <ai_command> [device]"; return 1; }
  [[ -z $TMUX ]] && { echo "mesh deploy requires tmux."; return 1; }

  local device="${2:-$(_mesh_pick)}"
  [[ -z "$device" ]] && return 1

  local pane_id line
  line=$(_mesh_terminal_command "$device" "$ai") || return
  pane_id=$(tmux new-window -n "ai@$device" -P -F '#{pane_id}')
  tmux send-keys -l -t "$pane_id" -- "$line"
  tmux send-keys -t "$pane_id" Enter
}
