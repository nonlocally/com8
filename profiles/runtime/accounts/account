#!/usr/bin/env bash
# COM8 optional account module; adapted from Anu 80d3c86 (profiles/NOTICE.md).
# com8-account — which subscription an agent pane runs on, and rotating it when
# a usage wall hits. Two providers: `claude` (the default everywhere) and
# `codex`, which works differently enough to be worth reading about below.
#
#   com8-account ls [--provider claude|codex]    every account with its windows
#   com8-account pick [--provider claude|codex] [--need any|fable]
#                    [--exclude <name>] [--json] [--stale]
#   com8-account launch [--provider claude|codex] [--as <name>]
#                      [--need auto|any|fable] [--box] [--cd <dir>]
#                       [--fallback-keychain] [--keep-wall] -- <cli args>
#                                              (--cd/--keep-wall are codex-only; --keep-wall
#                                              is what a rotate/switch relaunch types)
#   com8-account rotate <pane> [--force]         resume a walled pane under the next account
#                                              exit 0 rotated, 2 nothing has room (the pane is
#                                              left parked, claude resumes at reset), 1 anything
#                                              else (refused, dashboard unreachable, relaunch
#                                              died). There is no polling verb: unattended
#                                              rotation is the `limited` arm of `com8-account-pane watchd`,
#                                              gated by the tmux option @anu_autorotate.
#   com8-account switch <pane> [--as <name>] [--need any|fable] [--continue] [--force]
#                                              move a pane to another account right now — idle or
#                                              limited only unless --force; continues only a
#                                              limited pane (or any pane with --continue)
#   com8-account rebalance [<pane>] [--dry-run]  move IDLE panes to the ranked best account when it
#                                              is clearly better (see "rebalance" below): one row
#                                              per managed pane — PANE PROVIDER ACCOUNT BEST
#                                              REASON OUTCOME — then how many unmanaged panes
#                                              were skipped; moves unless --dry-run. Unattended,
#                                              it is an arm of `com8-account-pane watchd`, paused on a server
#                                              by the tmux option @anu_rebalance 0 (on otherwise)
#   com8-account rebalance <pane> --tick         internal: that arm's worker — one decision, at most
#                                              one log line (a move, or a block other than
#                                              "nothing better"); exit 0 moved, 2 stayed,
#                                              3 dashboard unreachable, 1 the move failed
#   com8-account status                          which account each pane is on
#   com8-account add [--provider claude|codex] <name>
#                    [--label t] [--shared] [--email e] [--no-register]
#                                              claude: store a pasted `claude setup-token`, sync,
#                                              and register the account on the serving host.
#                                              codex: create this device's own CODEX_HOME for the
#                                              account as a VIEW of your own ~/.codex (every entry
#                                              linked but auth.json and config.toml; a re-add folds
#                                              a home's stray state back in), run `codex login
#                                              --device-auth`, and render its config.toml from your
#                                              own ~/.codex/config.toml plus the pre-trusted hooks.
#                                              A codex login is PER DEVICE — nothing is synced.
#   com8-account doctor [--provider codex] [--fix]
#                                              name every codex home here that is not yet a view of
#                                              ~/.codex, and the entries that are not links; --fix
#                                              folds them in as a launch would. Exit 0 when all are.
#   com8-account sync [device|local|cache]       warm a launcher token cache: a named device gets
#                                              ITS OWN cache warmed over ssh; 'local'/'self'/'cache'
#                                              all just warm this device's own, no device touched
#   com8-account token <name> [--refresh]        print the token (scripts only; --refresh
#                                              bypasses the cache and re-fetches)
#   com8-account hook session-start              internal: Claude Code's own SessionStart hook
#                                              (added to managed host launches) calls
#                                              this on startup/resume/clear/compact/fork to
#                                              stamp @anu_session/@anu_session_source/
#                                              @anu_generation from the truth Claude itself just
#                                              reported — never blocks Claude, always exits 0
#   com8-account hook codex session-start        internal: Codex's own SessionStart hook (declared
#                                              in each codex account home's config.toml by `add
#                                              --provider codex`) — stamps @anu_session,
#                                              @anu_transcript and @anu_rollout_offset. Codex has
#                                              no --session-id, so this is the ONLY place anu ever
#                                              learns the id a rotation needs. Always exits 0.
#   com8-account hook codex user-prompt          internal: Codex's own UserPromptSubmit hook —
#                                              stamps @anu_turn/@anu_prompted, so a wall record in
#                                              the rollout can be matched to the turn in flight.
#                                              Both codex hooks first compare their inherited
#                                              $ANU_LAUNCH_NONCE with the pane's
#                                              @anu_launch_nonce and exit 0 silently on a
#                                              mismatch: Codex fires SessionStart lazily, at the
#                                              first prompt, so a hook can outlive its own launch.
#   com8-account hook stop-failure               internal: Claude Code's own StopFailure hook
#                                              (added to managed host launches with
#                                              matcher `rate_limit`) — stamps @anu_wall_event
#                                              on the pane when the turn died on a rate limit,
#                                              corroborating watchd's screen read so it can
#                                              rotate a tick sooner. Always exits 0.
#
# Truth about limits is the dashboard ($ANU_USAGE_URL, /api/usage/pick — the
# rule lives there). Tokens are one-year setup-tokens in Infisical at
# /anu/agents/claude/accounts, one key per account (NAME uppercased). The
# dashboard does NOT read a launch-token mirror — `sync` exists only to warm
# a device's own launcher cache (below), never the dashboard's own account
# data. Configure the existing usage service explicitly; COM8 does not host it.
#
# `launch`/`token` are cache-first against a per-device file (0600, dir 0700)
# at ${XDG_STATE_HOME:-~/.local/state}/com8/accounts/tokens.json
# (ANU_ACCOUNT_CACHE overrides): `com8-account sync cache` warms a device in
# one shot, `add` warms it immediately for the minting device, and once warm
# a launch never touches the network — a miss falls back to Infisical and
# caches the result, and `token --refresh` bypasses the cache on purpose.
#
# Each account entry on the dashboard host carries up to TWO separate
# credentials, because a `claude setup-token` cannot read usage limits (403
# oauth_scope_insufficient):
#   - token   — a launch setup-token, stored by `com8-account add` here and
#               exported by `launch`. Runs Claude Code as the account; can't
#               poll limits.
#   - configDir — a poll grant, a separate OAuth profile under
#               ~/.claude-profiles/<name> on the serving host, set up there by
#               `npm run add-claude -- <name>`. Lets the dashboard poll
#               limits for the account; not used to launch panes.
# `com8-account add` only ever writes `token` — run `npm run add-claude` on
# the serving host once per account to also get poll data on the dashboard.
#
# --- the codex branch ------------------------------------------------------
# A Codex account is a DIRECTORY, not a token. `codex login` writes auth.json
# inside its own $CODEX_HOME, so `launch --provider codex` points the CLI at
# $ANU_ACCOUNT_CODEX_DIR/<name> (default
# ${XDG_STATE_HOME:-~/.local/state}/com8/accounts/codex/<name>, 0700) and never
# reads, holds or exports a credential at all — auth.json is only ever tested
# for existence. Every home is a VIEW of the human's own ~/.codex: each entry
# but auth.json and config.toml is a symlink into it, so conversations,
# history and memories are one set for every account and for plain `codex`,
# and any account can `codex resume` any conversation — the whole reason a
# handoff is possible. `add` and every launch fold a home's stray real entries
# back in (merged or moved, never deleted); `doctor` names what is left. Codex
# logins do NOT travel: nothing about them is synced to Infisical or
# registered on the dashboard, so `add --provider codex <name>` is run once
# per machine.
#
# A home's config.toml is RENDERED, not hand-kept: at `add` and at every
# `launch --provider codex` it is rebuilt as the human's own
# ~/.codex/config.toml (hooks stripped), then anu's hook tables and their
# trust entries, then whatever Codex itself wrote into that home and the base
# does not define. Codex reads exactly one config file out of a CODEX_HOME and
# offers no include, no second config path and no config.d (0.156.1, verified
# against `codex doctor`), so a home holding only the hook block is a Codex
# with none of the human's model, reasoning effort or MCP servers — which is
# precisely what pointing `cdx` at an account home first shipped. The render
# reads ~/.codex/config.toml and never writes it.
#
# Every launch exports ANU_PROVIDER beside ANU_ACCOUNT, and an inherited
# account is honoured only by the provider that exported it: a shell opened in
# a Claude pane carries a CLAUDE account name, and reading it as a codex --as
# is what made `cdxx` there die on "no codex home for <claude account>". An
# unset ANU_PROVIDER means a launch from before this existed, and every one of
# those was claude. An account that fails the test is not an error — the launch
# simply picks as if nothing had been inherited.
#
# A launch with no --as INTERSECTS the dashboard's ranked picks with the
# accounts logged in HERE (the same preflight a rotation makes: an auth.json,
# hook tables Codex will run, this directory trusted in that home) and takes
# the first that survives. The dashboard ranks a pool; only the device knows
# which of it can be authenticated as. Taking the top pick blind is what made
# `cdxx` refuse outright on a laptop with two perfectly good codex accounts.
# Refusing is reserved for the case where NONE of the ranked accounts is
# logged in here — exit 1, a local credential problem, naming the ranked
# accounts and one that is logged in; an exhausted pool stays its own exit 3.
#
# The hook commands are written as the ABSOLUTE path of the anu-account that
# installed them, resolved through symlinks. Codex 0.156.0 stopped handing the
# hooks it spawns the launching shell's PATH, so a command naming `anu` by name
# resolved to the wrong binary — or to none — and the hook did nothing at all,
# silently: no stamp, so the pane never learned its own session id and no
# rotation could resume it. Move the bin and the preflight reads those homes as
# stale; re-run `add`.
#
# The wall is not on the screen and no hook reports it. Codex's quota branch
# ends the turn through an internal error path that fires no lifecycle hook at
# all; the only record is a `task_complete` line with `codex_error_info:
# usage_limit_exceeded` in the session's rollout. `com8-account-pane watchd` tails that file
# (the pane's @anu_transcript, from a byte cursor the SessionStart hook sets)
# and stamps @anu_wall_pending, which is what `pane state` reads as `limited`.
# That stamp is cleared only by a launch: nothing anu can read ever says a
# Codex limit has LIFTED, so a pane whose window resets mid-launch keeps
# reading `limited` until it is relaunched.
# ACTING on it is opt-in separately: `tmux set -g @anu_codex_autorotate 1`,
# because no live Codex wall handoff has passed a matrix yet. The manual verbs
# work either way.
#
# A rotation's relaunch is judged by the pane's own processes — a new codex
# pid still alive five seconds later — and one that is not is THAT candidate
# failing, never the rotation: the preflight cannot see a login chatgpt.com
# has stopped honouring (auth.json is tested for existence only, and no
# preflight makes a network call), so the relaunch is the test. The candidate
# goes on the tried list and the next one down the same ranking is tried from
# the shell it left behind, in the same worker. The relaunch line carries
# `--keep-wall`, so @anu_wall_pending survives every relaunch that dies and is
# cleared only once one is confirmed alive; if none is, the pane is left at a
# shell with ONE line saying why and how to resume, rotate exits 1, and the
# watchd reap raises that line as its notice on the next tick. Launch `-c`
# overrides are not replayed: @anu_launch is a whitelist of codex flags.
# Boxed codex panes are out of scope — no hook runs inside a box, so a wall
# there would be invisible, and `launch --provider codex --box`
# refuses rather than promise a rotation that could never fire.
#
# --- rebalance -------------------------------------------------------------
# Between a launch and a wall, budgets move: a week resets somewhere, or the
# account a pane is on creeps toward a wall that will land mid-turn. The
# human's ruling: "at any moment there is always a ranked best account, and
# that is the one we should be using". So an IDLE pane — the one moment moving
# it is free — goes to the ranked best B (picks[0] of the dashboard's pick for
# the pane's own provider and need) when B beats the pane's account C by
#   (1) an imminent wall: C has <= 15 left and B >= 30; or
#   (2) a sooner reset:   B's weekly reset is >= 24h earlier than C's.
# A null resetsAt is +infinity, never the sooner one. How much of C is spent is
# not a condition. C absent from the picks is gated — a wall, rotation's job —
# and is skipped. It is model-switcher 0.3.4's rule, read off the pick's own
# fields. This supersedes "only a wall moves work" for IDLE panes only: a
# working pane is still never moved. Guards, each a REASON when it blocks: the
# pane is managed (@anu_account — an unmanaged pane is only counted), has a
# session id, is not boxed, is running its CLI (a pane its human exited to a
# shell is never relaunched), was not rebalanced in 6h (@anu_rebalance_at,
# stamped before the move so a refused one still costs it) nor relaunched in
# 30m (@anu_rotating: a rotation off a wall, or any switch), reads idle at the
# decision AND again just before the move, and is not the pane a human is
# typing in (an attached client's current pane with a key in the last 5 min).
# B must pass the preflight `switch --as` runs — a token on this device, or
# for codex the `_codex_candidate_ok` chain — and one that fails is passed
# over for the next ranked pick that still beats C. The move IS `com8-account
# switch <pane> --as <dest>`: the pane lock, its re-checks, the same relaunch,
# no continuation. A move that dies leaving the pane at a shell is resumed on C.
# The ranking is cached per server in @anu_rebalance_rank_<provider> (plus
# _<need> past any) as "<fetched> <expires> <best> <json>", good until
# `expires`: 15 min, or sooner if a cached resetsAt passes first. `com8-account-pane watchd`
# runs this unattended, one worker per server at a time; the verb itself is the
# human's and moves whatever the gate says, as `rotate` ignores @anu_autorotate.
#
# `rotate`/`switch` hold a real mkdir-based lock on the pane
# (${XDG_STATE_HOME:-~/.local/state}/com8/accounts/locks, ANU_ACCOUNT_LOCKDIR
# overrides — named after the TARGET pane's own tmux socket, never the
# caller's; stale locks >10min old with a dead holder pid, or with no
# readable holder file at all, are reclaimed atomically) for the whole
# relaunch, so two rotations can never race the same pane; before actually
# leaving the old account they preflight the next ranked pick (and an
# explicit `switch --as`) locally — a resolvable token, not tried in the
# last 30 min (@anu_tried, bounded to 3, appended once the pane is
# confirmed to have left) — and re-check the pane's generation and state
# right before typing anything, so a pane that changed underneath the call
# gets nothing typed at all. `launch`'s own outcomes are distinct: nothing
# has room (exit 3, no keychain fallback unless --fallback-keychain), the
# dashboard is unreachable (falls back to a recent — under 10min,
# need-matched — successful pick if its token still resolves locally, else
# the keychain with a warning), and an explicit --as account with no token
# (exit 1). A pick is bounded tighter than any other dashboard read —
# --connect-timeout 3 and 6s in all (ANU_PICK_TIMEOUT; ANU_USAGE_TIMEOUT,
# default 15, still bounds `ls`) — so a dead tailnet costs a launch seconds.
#
# The codex launch never has a keychain, and "cdx must never be strictly
# worse than plain codex": with the dashboard unreachable and no --as or
# inherited codex account, it falls back, in order, to (1) the last codex
# pick for that need under 10 min old, (2) the home this device last launched
# or rotated to (last-launch.codex beside last-pick.*, 0600, written on every
# codex launch that reaches exec) unless this pane recorded it walled in the
# last 30 min, (3) the first logged-in home by name — each only if it passes
# the rotation preflight, each saying "launching as <name> without a room
# check", each a fully MANAGED launch. Only a device with no codex home at
# all still exits 1 ("pass --as <name>"), which is the case `cdx` itself
# turns into plain `codex`.

# anu:bash-guard — needs bash 4+; re-exec under Homebrew's when PATH hands us macOS /bin/bash 3.2
if [ "${BASH_VERSINFO[0]:-0}" -lt 4 ]; then
  for _anu_bash in ${ANU_BASH_CANDIDATES:-/opt/homebrew/bin/bash /usr/local/bin/bash ${HOMEBREW_PREFIX:+$HOMEBREW_PREFIX/bin/bash} $(command -v bash)}; do
    [ -x "$_anu_bash" ] && "$_anu_bash" -c '[ "${BASH_VERSINFO[0]}" -ge 4 ]' >/dev/null 2>&1 && exec "$_anu_bash" "$0" "$@"
  done; echo "anu: needs bash 4+ — brew install bash" >&2; exit 1
fi

set -euo pipefail

COM8_ACCOUNT_RUNTIME="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
COM8_ACCOUNT_SELF="${ANU_ACCOUNT_BIN:-$COM8_ACCOUNT_RUNTIME/account}"
COM8_ACCOUNT_PANE="${COM8_ACCOUNT_PANE:-$COM8_ACCOUNT_RUNTIME/pane}"
pane() { "$COM8_ACCOUNT_PANE" "$@"; }
printf -v COM8_ACCOUNT_LAUNCH_COMMAND '%q' "$COM8_ACCOUNT_SELF"
USAGE_URL="${COM8_USAGE_URL:-${ANU_USAGE_URL:-}}"
export ANU_ACCOUNT_BOX_BIN="${ANU_ACCOUNT_BOX_BIN:-${COM8_BOX_LAUNCHER:-}}"
SECRETS_BIN="${COM8_SECRETS_BIN:-${ANU_SECRETS_BIN:-$COM8_ACCOUNT_RUNTIME/secrets-client}}"
TOKEN_PATH="${COM8_ACCOUNT_TOKEN_PATH:-/anu/agents/claude/accounts}"
SYNC_DEVICE="${COM8_USAGE_HOST:-${ANU_USAGE_HOST:-}}"
USAGE_REPO="${COM8_USAGE_REPO:-${ANU_USAGE_REPO:-}}"
CLAUDE_SETTINGS="${CLAUDE_CONFIG_DIR:-$HOME/.claude}/settings.json"
ACCOUNT_CACHE="${ANU_ACCOUNT_CACHE:-${XDG_STATE_HOME:-$HOME/.local/state}/com8/accounts/tokens.json}"
LOCKDIR="${ANU_ACCOUNT_LOCKDIR:-${XDG_STATE_HOME:-$HOME/.local/state}/com8/accounts/locks}"
LAST_PICK_DIR="$(dirname "$ACCOUNT_CACHE")"   # same dir as the token cache —
  # last-pick.<need> lives beside tokens.json, so ANU_ACCOUNT_CACHE already
  # isolates it for tests.
# The one line typed into a relaunched pane once it's confirmed idle again —
# a resumed transcript may be stale relative to what actually happened right
# before the wall (a tool result the model never saw land), so this asks for
# a look before picking the task back up, not a blind "continue".
CONTINUATION_TEXT="You were resumed on another account after a usage wall. Check the last tool results and the current state of the files before repeating any action, then continue where you left off."

_die()  { printf 'anu account: %s\n' "$*" >&2; exit 1; }
_die_code() {  # like _die but with a caller-chosen exit code — cmd_launch's
  # distinct outcomes (pool exhausted vs. dashboard down vs. bad --as) are
  # not all "exit 1".
  local code="$1"; shift
  printf 'anu account: %s\n' "$*" >&2
  exit "$code"
}
_have() { command -v "$1" >/dev/null 2>&1; }
_key()  { printf '%s' "$1" | tr '[:lower:]' '[:upper:]' | sed 's/[^A-Z0-9]/_/g'; }
_bounded() {  # $1 = seconds, $2… = the command to run under that bound. macOS
  # ships no timeout(1), so this is the portable stand-in: run the command in
  # the background, poll `kill -0` every 0.2s, and on expiry kill it and
  # return 124 (timeout(1)'s own code). Two details matter:
  #   - the bound is measured against bash's own $SECONDS, not a count of
  #     sleeps, so a `sleep` that returns early cannot shorten it;
  #   - stdout is staged through a scratch file rather than inherited. A
  #     killed command's own children would otherwise keep a caller's
  #     command-substitution pipe open long past the bound — which is exactly
  #     what the bound exists to prevent. stderr is left alone, so a caller's
  #     own 2>/dev/null still applies.
  local secs="$1"; shift
  case "$secs" in ''|*[!0-9]*|0) secs=10 ;; esac
  local out; out="$(mktemp 2>/dev/null)" || out=""
  [ -n "$out" ] || { "$@"; return $?; }   # no scratch file: unbounded beats broken
  chmod 600 "$out" 2>/dev/null || true    # a token can pass through here
  "$@" >"$out" &
  local p=$! start=$SECONDS rc=0
  while kill -0 "$p" 2>/dev/null; do
    if [ $((SECONDS - start)) -ge "$secs" ]; then
      kill "$p" 2>/dev/null || true
      rm -f "$out" 2>/dev/null
      return 124
    fi
    sleep 0.2 2>/dev/null || true
  done
  wait "$p" 2>/dev/null || rc=$?
  cat "$out" 2>/dev/null
  rm -f "$out" 2>/dev/null
  return "$rc"
}
_token_timeout() {  # how long _token_for's store fallback may take. Fixed at
  # 10s in normal use; a test may shorten it (gated like every other
  # test-only knob here) so the timeout path costs a second, not ten.
  if [ "${ANU_ACCOUNT_TEST:-0}" = 1 ] && [ -n "${ANU_ACCOUNT_TEST_TOKEN_TIMEOUT:-}" ]; then
    printf '%s' "$ANU_ACCOUNT_TEST_TOKEN_TIMEOUT"; return 0
  fi
  printf '10'
}
_api()  { [ -n "$USAGE_URL" ] || return 1; curl -fsS --connect-timeout 3 -m "${ANU_USAGE_TIMEOUT:-15}" "$USAGE_URL$1"; }
_api_pick() {  # a PICK sits in front of a pane the human is waiting on, so a
  # dead tailnet must cost seconds, not the 15 a full usage read may take:
  # 3s to connect, 6s in all (ANU_PICK_TIMEOUT overrides the total).
  [ -n "$USAGE_URL" ] || return 1
  curl -fsS --connect-timeout 3 -m "${ANU_PICK_TIMEOUT:-6}" "$USAGE_URL$1"
}
_epoch_ms() {  # a generation stamp — millisecond epoch where available, so two
  # relaunches of the same pane a moment apart still get distinct values.
  # Falls back to whole-second resolution (still monotonic, just coarser) on
  # a box with neither python3 nor perl.
  if _have python3; then
    python3 -c 'import time; print(int(time.time()*1000))' 2>/dev/null && return 0
  fi
  if _have perl; then
    perl -MTime::HiRes=time -e 'printf "%d\n", time()*1000' 2>/dev/null && return 0
  fi
  printf '%s000\n' "$(date +%s)"
}
_need_from_settings() {  # need=auto: --model <m> in the claude args, then $ANTHROPIC_MODEL, then settings.json
  local claude_model=""
  while [ $# -gt 0 ]; do
    [ "$1" = --model ] && [ $# -ge 2 ] && claude_model="$2"
    shift
  done
  case "$claude_model" in *fable*|*Fable*) echo fable; return 0 ;; esac
  case "${ANTHROPIC_MODEL:-}" in *fable*|*Fable*) echo fable; return 0 ;; esac
  local m=""; [ -f "$CLAUDE_SETTINGS" ] && m="$(jq -r '.model // ""' "$CLAUDE_SETTINGS" 2>/dev/null || true)"
  case "$m" in *fable*|*Fable*) echo fable ;; *) echo any ;; esac
}

# ------------------------------------------------------------------ lock ----
# A real, atomic (mkdir) lock so two rotations/switches can never race the
# SAME pane — the softer @anu_rotating cooldown (a tmux option, always
# readable, useful for "was this pane just touched") stays as a separate,
# best-effort guard; this is the hard one. One pane, one lock dir:
# $LOCKDIR/<socket-basename>-<pane-number>.
_mtime() {  # portable file/dir modification epoch: BSD stat (macOS) then GNU
  # stat (Linux); 0 if neither works — never blocks the caller, it just makes
  # a broken stat look "recent" so nothing gets wrongly reclaimed. Tried by
  # OUTPUT, not exit status: GNU stat's `-f` means something else entirely
  # (a filesystem-type format), so `stat -f %m` on Linux prints a bare "?"
  # and still exits 0 — an exit-status chain would never fall through to
  # `stat -c %Y` there at all.
  local out
  out="$(stat -f %m "$1" 2>/dev/null)"
  if [[ "$out" =~ ^[0-9]+$ ]]; then printf '%s' "$out"; return 0; fi
  out="$(stat -c %Y "$1" 2>/dev/null)"
  if [[ "$out" =~ ^[0-9]+$ ]]; then printf '%s' "$out"; return 0; fi
  printf '0'
}
_socket_name() {  # $1 = pane id. The socket the TARGET pane's tmux server is
  # actually attached to — NOT the caller's own $TMUX. A caller outside tmux
  # (a `pane watchd` worker) and a human inside tmux both have to land on the SAME lock
  # name for the same pane, and only the pane itself can say which server
  # that is. Falls back to a stable name when tmux can't answer (no tmux at
  # all, or the pane has already vanished).
  local pid="$1" sp
  sp="$(tmux display-message -p -t "$pid" '#{socket_path}' 2>/dev/null || true)"
  if [ -n "$sp" ]; then basename "$sp"; else printf 'default'; fi
}
_lock_pane() {  # $1 = pane id (e.g. %4). On success sets $_lock_dir (global)
  # and arms the EXIT trap that removes it — so a lock is released on every
  # exit path (success, _die, a timeout) without every caller having to
  # remember to unlock. A lock older than 10 minutes whose holder pid is no
  # longer alive is reclaimed automatically (a crashed rotation must not
  # wedge the pane forever); a holder-less dir (crashed before it could even
  # write the holder file) falls back to the DIRECTORY's own mtime for that
  # age check. The holder pid is $BASHPID, not $$ — a rotation dispatched
  # from inside a subshell (a `( cmd_rotate "$pid" )` wrapper) would
  # otherwise record the long-lived supervisor's pid, which never dies, so a
  # crashed rotation could never be reclaimed by the dead-pid rule at all.
  #
  # Reclaim is rename-away-then-mkdir, but `mv` alone is NOT the atomicity
  # guarantee — it only proves we moved *a* directory that happened to sit
  # at $dir at that instant, not that it was still the exact stale snapshot
  # we judged a moment earlier. Two reclaimers can otherwise both "win": A
  # renames the stale dir away, relocks fresh; B — descheduled between its
  # own staleness verdict and its own `mv` — then renames A's brand-new,
  # LIVE lock away (the path exists again, `mv` doesn't care who put it
  # there) and relocks over it too. So after every successful `mv`, the
  # moved-aside copy is RE-VALIDATED against exactly what was judged stale
  # (the captured holder line, or "still holder-less with an old enough
  # mtime") before it's discarded; any mismatch means we raced past
  # someone else's legitimate new lock, so it's moved straight back
  # (best-effort) and this call loses the race honestly.
  local pane="$1"
  local dir="$LOCKDIR/$(_socket_name "$pane")-${pane#%}"
  mkdir -p "$LOCKDIR" 2>/dev/null || true
  chmod 700 "$LOCKDIR" 2>/dev/null || true
  if mkdir "$dir" 2>/dev/null; then
    chmod 700 "$dir" 2>/dev/null || true
    printf '%s %s\n' "$BASHPID" "$(date +%s)" > "$dir/holder" 2>/dev/null || true
    chmod 600 "$dir/holder" 2>/dev/null || true
    _lock_dir="$dir"
    trap '_unlock_pane' EXIT
    return 0
  fi
  local holder_pid="" holder_epoch="" holder_line="" had_holder=0 now
  if [ -f "$dir/holder" ]; then
    had_holder=1
    holder_line="$(cat "$dir/holder" 2>/dev/null)"
    read -r holder_pid holder_epoch <<< "$holder_line"
  fi
  now="$(date +%s)"
  [ -n "$holder_epoch" ] || holder_epoch="$(_mtime "$dir")"
  # "0" is _mtime's own failure sentinel (stat couldn't read the dir at
  # all) — never trust that as "definitely ancient"; treat it the same as
  # not knowing the age at all, which fails the reclaim safely closed.
  [ "$holder_epoch" = 0 ] && holder_epoch=""
  if [[ "$holder_epoch" =~ ^[0-9]+$ ]] && [ $((now - holder_epoch)) -ge 600 ] \
      && { [ -z "$holder_pid" ] || ! kill -0 "$holder_pid" 2>/dev/null; }; then
    # TEST-ONLY: widen the window between the staleness verdict above and
    # the `mv` below, so a genuine two-process race can be reproduced
    # deterministically (a second process is guaranteed to land here after
    # the first has already re-locked) rather than relying on timing luck.
    if [ "${ANU_ACCOUNT_TEST:-0}" = 1 ] && [ -n "${ANU_ACCOUNT_TEST_PAUSE_AFTER_STALE_CHECK:-}" ]; then
      sleep "$ANU_ACCOUNT_TEST_PAUSE_AFTER_STALE_CHECK"
    fi
    local away="$dir.stale.$BASHPID.$RANDOM"
    if mv "$dir" "$away" 2>/dev/null; then
      local revalidated=1
      if [ "$had_holder" = 1 ]; then
        local away_line=""
        [ -f "$away/holder" ] && away_line="$(cat "$away/holder" 2>/dev/null)"
        [ "$away_line" = "$holder_line" ] || revalidated=0
      else
        if [ -f "$away/holder" ]; then
          revalidated=0   # someone else already reclaimed and re-locked it
        else
          local away_mtime away_now
          away_mtime="$(_mtime "$away")"
          away_now="$(date +%s)"
          if ! [[ "$away_mtime" =~ ^[0-9]+$ ]] || [ "$away_mtime" = 0 ] \
              || [ $((away_now - away_mtime)) -lt 600 ]; then
            revalidated=0
          fi
        fi
      fi
      if [ "$revalidated" = 1 ]; then
        rm -rf "$away" 2>/dev/null || true
        if mkdir "$dir" 2>/dev/null; then
          chmod 700 "$dir" 2>/dev/null || true
          printf '%s %s\n' "$BASHPID" "$(date +%s)" > "$dir/holder" 2>/dev/null || true
          chmod 600 "$dir/holder" 2>/dev/null || true
          _lock_dir="$dir"
          trap '_unlock_pane' EXIT
          return 0
        fi
      else
        # Put the live dir back — unless a third locker has already re-created
        # $dir, in which case `mv` would NEST $away inside it (POSIX mv onto an
        # existing directory) and leave two holders; then the moved-aside copy
        # is simply dropped (its holder was live, so its owner still holds).
        [ -e "$dir" ] || mv "$away" "$dir" 2>/dev/null || true
        return 1
      fi
    fi
  fi
  return 1
}
cmd__test_lock_hold() {  # TEST-ONLY, undocumented, GATED on ANU_ACCOUNT_TEST=1
  # (refuses otherwise, one line, no raw `set -u` unbound-variable error):
  # acquire the lock on $1, hold it for $2 seconds (default 2), print
  # "locked" and exit 0 on success, or print "busy" and exit 1 if another
  # holder already has it. Exists so the test suite can exercise a REAL
  # two-process race on _lock_pane over an actual fork/exec boundary —
  # never a real user-facing verb, never documented in `help`, never
  # reachable without the test gate even if someone typed the verb by hand.
  [ "${ANU_ACCOUNT_TEST:-0}" = 1 ] || _die "__test_lock_hold: test-only, set ANU_ACCOUNT_TEST=1"
  [ $# -ge 1 ] || _die "usage: anu-account __test_lock_hold <pane> [hold-seconds]"
  local pane="$1" hold="${2:-2}"
  if _lock_pane "$pane"; then
    printf 'locked\n'
    sleep "$hold"
    exit 0
  fi
  printf 'busy\n'
  exit 1
}
_unlock_pane() {  # removes exactly the lock this process holds — only if the
  # dir's own holder file still names OUR pid ($BASHPID): never a blind
  # `rm -rf`, since a reclaimer could already have taken the dir over from
  # underneath a caller that took unusually long to get back here. Wired to
  # fire on EXIT (only once a lock is actually held; see _lock_pane), so
  # `_die`, a timeout, or plain success all release it.
  [ -n "${_lock_dir:-}" ] || return 0
  local hp=""
  [ -f "$_lock_dir/holder" ] && { read -r hp _ < "$_lock_dir/holder" 2>/dev/null || true; }
  [ "$hp" = "$BASHPID" ] && rm -rf "$_lock_dir" 2>/dev/null
  _lock_dir=""
}

# ------------------------------------------------------------- last pick ----
# `launch`'s memory of its own most recent successful pick, so a launch that
# hits an unreachable dashboard can still credential itself instead of
# falling straight to the keychain — honored only when under 10 minutes old.
# Checked pane-first (this exact pane's own last pick, if it has one) then a
# device-local file per need (works headless, or from a different pane).
_last_pick_write() {  # $1 = key, $2 = account name. Called only once the
  # picked account's credential has actually resolved (never for the mere fact
  # of a dashboard pick) — best-effort, never fails the launch that's warming
  # it. The key is the need, namespaced by provider off claude ("any",
  # "fable", "codex:any"): a launch for one need — or one PROVIDER — must
  # never let a different one's stale pick answer for it.
  local need="$1" name="$2" now; now="$(date +%s)"
  if [ -n "${TMUX_PANE:-}" ]; then
    tmux set-option -p -t "$TMUX_PANE" @anu_last_pick "$need:$name:$now" 2>/dev/null || true
  fi
  mkdir -p "$LAST_PICK_DIR" 2>/dev/null || true
  printf '%s %s\n' "$name" "$now" > "$LAST_PICK_DIR/last-pick.${need//:/-}" 2>/dev/null || true
}
_last_pick_read() {  # $1 = key. Prints the cached name if under 10 minutes
  # old AND recorded for the SAME key; prints nothing and returns 1
  # otherwise.
  local need="$1" now name epoch raw raw_need rest
  now="$(date +%s)"
  if [ -n "${TMUX_PANE:-}" ]; then
    raw="$(_opt "$TMUX_PANE" @anu_last_pick)"
    if [ -n "$raw" ]; then
      # Parsed from the RIGHT: the key itself may carry a colon
      # ("codex:any"), while the epoch and the name never do.
      epoch="${raw##*:}"; rest="${raw%:*}"
      name="${rest##*:}"; raw_need="${rest%:*}"
      [ "$rest" = "$name" ] && raw_need=""
      if [ "$raw_need" = "$need" ] && [ -n "$name" ] && [[ "$epoch" =~ ^[0-9]+$ ]] && [ $((now - epoch)) -lt 600 ]; then
        printf '%s' "$name"; return 0
      fi
    fi
  fi
  local f="$LAST_PICK_DIR/last-pick.${need//:/-}"
  if [ -f "$f" ]; then
    name=""; epoch=""
    read -r name epoch < "$f" 2>/dev/null || true
    if [ -n "$name" ] && [[ "$epoch" =~ ^[0-9]+$ ]] && [ $((now - epoch)) -lt 600 ]; then
      printf '%s' "$name"; return 0
    fi
  fi
  return 1
}

# ------------------------------------------------------------ last launch --
# Which home this DEVICE last launched a codex pane as (a fresh launch or a
# rotation's relaunch — both go through `launch`), so an offline launch has
# an honest second choice after the 10-minute last pick. "name epoch", 0600,
# atomic, beside last-pick.*; written only once a launch has reached exec.
# No age limit: it answers "most recent", not "still has room".
_last_launch_write() {  # $1 = provider, $2 = account name. Best-effort.
  local f="$LAST_PICK_DIR/last-launch.$1"
  ( umask 077; mkdir -p "$LAST_PICK_DIR" && printf '%s %s\n' "$2" "$(date +%s)" > "$f.tmp" ) 2>/dev/null \
    && mv -f "$f.tmp" "$f" 2>/dev/null || rm -f "$f.tmp" 2>/dev/null || true
  return 0
}
_last_launch_read() {  # $1 = provider. Prints the name, or returns 1.
  local f="$LAST_PICK_DIR/last-launch.$1" name="" epoch=""
  [ -f "$f" ] || return 1
  read -r name epoch < "$f" 2>/dev/null || true
  [ -n "$name" ] && [[ "$epoch" =~ ^[0-9]+$ ]] || return 1
  printf '%s' "$name"
}

# ------------------------------------------------------------- token cache --
# A device-local mirror of every token this device has needed, so a launch
# never waits on Infisical once warm. Shape matches the tokens file: a flat
# {KEY: token} object. Always atomic tmp+rename, dir 0700, file 0600 (umask
# 077 covers both — mv preserves the tmp file's own mode). Every helper here
# is best-effort: a cache write failure is logged to stderr and swallowed —
# it must never abort the real operation (a launch, a refresh, a sync, an
# add) that's warming it, so nothing below ever returns non-zero.
_cache_write() {  # $1 = whole-cache JSON object; overwrites the cache. Silent
  # on success — a launch/refresh/add warming the cache along the way is a
  # quiet side effect, not news. Sets $_cache_write_ok (1/0) as a global for
  # the one caller that DOES want to say so (`sync`, below); every other
  # caller ignores it and stays quiet either way.
  _cache_write_ok=0
  local dir; dir="$(dirname "$ACCOUNT_CACHE")"
  if ( umask 077; mkdir -p "$dir" && printf '%s\n' "$1" > "$ACCOUNT_CACHE.tmp" ) 2>/dev/null \
      && mv -f "$ACCOUNT_CACHE.tmp" "$ACCOUNT_CACHE" 2>/dev/null; then
    _cache_write_ok=1
    return 0
  fi
  rm -f "$ACCOUNT_CACHE.tmp" 2>/dev/null || true
  printf 'anu account: cache write failed (%s)\n' "$ACCOUNT_CACHE" >&2
  return 0
}
_cache_read() {  # prints the cache as a JSON object, '{}' if missing. A file
  # that fails to parse is moved aside to <path>.corrupt-<epoch> (never just
  # silently dropped) so one bad write can't quietly erase every other
  # device's cached tokens without a trace.
  [ -f "$ACCOUNT_CACHE" ] || { printf '{}'; return 0; }
  local cur; cur="$(cat "$ACCOUNT_CACHE" 2>/dev/null || true)"
  if printf '%s' "$cur" | jq -e . >/dev/null 2>&1; then
    printf '%s' "$cur"
    return 0
  fi
  local moved="$ACCOUNT_CACHE.corrupt-$(date +%s 2>/dev/null || echo now)"
  if mv -f "$ACCOUNT_CACHE" "$moved" 2>/dev/null; then
    printf 'anu account: cache at %s was not valid JSON — moved it to %s and starting fresh\n' \
      "$ACCOUNT_CACHE" "$moved" >&2
  else
    printf 'anu account: cache at %s was not valid JSON — ignoring it\n' "$ACCOUNT_CACHE" >&2
  fi
  printf '{}'
  return 0
}
_cache_put() {  # $1 = key, $2 = token; upsert one key without disturbing the
  # rest. The token never touches argv (ps-visible): it travels through a
  # 0600 scratch file that jq reads via --rawfile, removed on every exit path.
  local key="$1" tok="$2" cur dir scratch
  cur="$(_cache_read)"
  dir="$(dirname "$ACCOUNT_CACHE")"
  ( umask 077; mkdir -p "$dir" ) 2>/dev/null || true
  scratch="$(mktemp "$dir/.token.XXXXXX" 2>/dev/null || true)"
  [ -n "$scratch" ] || scratch="$(mktemp 2>/dev/null || true)"
  if [ -z "$scratch" ]; then
    printf 'anu account: cache write failed (%s): could not create a scratch file\n' "$ACCOUNT_CACHE" >&2
    return 0
  fi
  chmod 600 "$scratch" 2>/dev/null || true
  printf '%s' "$tok" > "$scratch" 2>/dev/null || true
  local merged; merged="$(printf '%s' "$cur" | jq -c --arg k "$key" --rawfile v "$scratch" '.[$k] = $v' 2>/dev/null || true)"
  rm -f "$scratch" 2>/dev/null || true
  if [ -z "$merged" ]; then
    printf 'anu account: cache write failed (%s): could not merge the new key\n' "$ACCOUNT_CACHE" >&2
    return 0
  fi
  _cache_write "$merged"
}
_token_for() {  # $1 = account name; prints the token, cache-first. A miss (no
  # file, no key, or an empty value) falls back to anu-secrets and upserts
  # that one key into the cache so the next launch skips the network.
  #
  # That fallback is a NETWORK call to Infisical, and it is on the path of
  # `_pick_next`'s preflight walk (one call per ranked candidate) and of
  # `switch --as`. An unreachable store or a wedged CLI would otherwise park
  # a rotation for ever holding the pane's lock, so it is bounded: a timeout
  # reads exactly like a miss — "no token locally" — and the caller moves to
  # the next candidate. `token --refresh` is the deliberate, unbounded way to
  # wait on the store.
  local name="$1" key; key="$(_key "$name")"
  local cache_json tok
  cache_json="$(_cache_read)"
  tok="$(printf '%s' "$cache_json" | jq -r --arg k "$key" '.[$k] // empty' 2>/dev/null || true)"
  if [ -z "$tok" ]; then
    tok="$(_bounded "$(_token_timeout)" "$SECRETS_BIN" get "$TOKEN_PATH" "$key" --show 2>/dev/null)" || return 1
    [ -n "$tok" ] || return 1
    _cache_put "$key" "$tok"
  fi
  printf '%s' "$tok"
}

# --------------------------------------------------------------- provider ----
# anu names the two providers the way its own verbs do (`claude`, `codex`);
# the dashboard names them by the vendor whose limits it polls (`claude`,
# `openai`). One translation, here, so no call site has to remember which
# vocabulary it is in.
_provider_api() { case "$1" in codex) printf 'openai' ;; *) printf 'claude' ;; esac; }
# The account a launch INHERITS from its shell, but only when that account
# belongs to the provider being launched. Prints it, or nothing (returns 1).
#
# Every pane `anu account launch` starts exports ANU_ACCOUNT, and every shell
# opened inside that pane inherits it. Read bare, it is a trap: a `cdxx` typed
# in a Claude pane inherits a CLAUDE account name, and the codex launcher took
# it as an explicit `--as` and died with "no codex home for 'account_alpha'" — on a
# machine with perfectly good codex accounts, and without ever asking the
# dashboard or intersecting the ranked picks with the local homes. The name was
# never wrong; it just belonged to somebody else.
#
# ANU_PROVIDER, exported beside it, is what says WHOSE name it is. Its absence
# means a launch from before this existed, and every one of those was claude —
# so the claude side honours an unset provider and the codex side does not.
# An account that fails this test is not an error; it is simply not an answer,
# and the launch picks as if nothing had been inherited at all.
_inherited_account() {  # $1 = the provider being launched
  [ -n "${ANU_ACCOUNT:-}" ] || return 1
  case "$1" in
    codex)  [ "${ANU_PROVIDER:-}" = codex ] || return 1 ;;
    *)      case "${ANU_PROVIDER:-}" in ''|claude) ;; *) return 1 ;; esac ;;
  esac
  printf '%s' "$ANU_ACCOUNT"
}
_provider_check() {  # $1 = verb (for the message), $2 = the value as given
  case "$2" in
    claude|codex) return 0 ;;
    *) _die "$1: --provider must be claude or codex" ;;
  esac
}

# ----------------------------------------------------------------- codex ----
# A Codex account is a DIRECTORY, not a token. `codex login` writes `auth.json`
# inside its own $CODEX_HOME, so anu points the CLI at that home and never
# reads, holds, or passes on a credential at all — `auth.json` is only ever
# tested for EXISTENCE here, never opened.
#
# One home per account under $CODEX_ACCOUNT_DIR (0700), and every home a VIEW
# of the human's own ~/.codex: only auth.json and config.toml are its own (see
# "one ~/.codex, every account" below). That is what makes a rotation
# possible: the spike verified live that home B, sharing home A's rollouts,
# resumes A's conversation by id under the SAME session id. Without it every
# account would see only its own rollouts and a handoff would have nothing to
# resume.
#
# Logins do NOT travel. Nothing here is synced to Infisical or registered on
# the dashboard: a device-auth login is bound to the device that ran it, so
# `add --provider codex` is a per-device act and says so.
CODEX_ACCOUNT_DIR="${ANU_ACCOUNT_CODEX_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/com8/accounts/codex}"
# The human's own Codex home — never $CODEX_HOME, which inside an agent pane is
# already pointed at an account home.
CODEX_USER_DIR="$HOME/.codex"
_codex_home()     { printf '%s/%s' "$CODEX_ACCOUNT_DIR" "$1"; }
_codex_config()   { printf '%s/config.toml' "$(_codex_home "$1")"; }
_codex_authed()   { [ -f "$(_codex_home "$1")/auth.json" ]; }   # existence ONLY
_codex_local_accounts() {  # every account this device is actually logged in as
  local d
  for d in "$CODEX_ACCOUNT_DIR"/*/; do
    [ -f "$d/auth.json" ] || continue
    printf '%s\n' "$(basename "$d")"
  done
}

# -------------------------------------------- one ~/.codex, every account ----
# An account home IS the human's own ~/.codex with a different auth.json and a
# rendered config.toml: the Claude side's rule (every account shares ~/.claude,
# only the token differs), carried over whole. Every other top-level entry of
# ~/.codex is a SYMLINK in every home, so conversations, history, memories,
# archived sessions, skills, AGENTS.md and whatever a later Codex adds are one
# set whichever account a pane runs as, and `codex resume` in a managed pane
# sees exactly what plain `codex` sees. (A home used to link only `sessions`,
# and at a store of anu's own rather than ~/.codex, so `codex resume <id>` of a
# conversation begun in plain codex answered "No saved session found".) The
# old store path, $CODEX_ACCOUNT_DIR/sessions, stays as a link to
# ~/.codex/sessions, because homes on other machines still point at it.
#
# The share runs at `add` and at EVERY launch. On a home that already is a
# view it is a pass of builtin tests: nothing is written and nothing is
# printed. A home holding a real entry where a link belongs (made before this
# rule, or a link some writer replaced by a rename) is folded back, and every
# repair says so on stderr:
#   * a name ~/.codex has too is MERGED into ~/.codex's copy, the home's own is
#     kept beside the link as <name>.pre-link.<stamp>, and the link goes in:
#       a directory    copy-if-absent by relative path, never overwriting. A
#                      copy is a HARD LINK wherever the filesystem allows, so a
#                      merge costs no space (a home's .tmp can hold gigabytes
#                      of stale clones) and a rollout a live pane is still
#                      appending to keeps growing where the view sees it. A
#                      byte copy would freeze it at the merge, and the next
#                      resume would lose every turn after.
#       *.jsonl        the lines ~/.codex's copy lacks are appended to it
#       a database     NEVER merged: kept whole, -wal/-shm with it, under the
#                      backup name
#       anything else  never merged either; kept under the backup name
#   * a name only the home has is MOVED into ~/.codex and linked back, once it
#     has sat unchanged for a minute: a temp file a live Codex is about to
#     rename into place is not state, and must never be carried off mid-write.
# Nothing is deleted. Every byte a home held ends up in ~/.codex or in a backup
# beside the link, and a file (a database above all) is swapped for its link
# by ONE rename with its backup name hard-linked first, so a process opening it
# never finds the name missing and quietly starts an empty one.
#
# Verified on Codex 0.156.1, against a scratch home whose every entry was a
# link, across a startup, a turn and an exit: every link survived. SQLite
# resolves a linked database to its real path and keeps -wal/-shm beside THAT
# file (so every process, through any home, shares one WAL); history.jsonl is
# appended through its link; config.toml is rewritten by a rename, but of the
# link's TARGET; version.json is rewritten in place.

# The ONE list of names that never become links — minimal on purpose:
#   auth.json     the account: the one thing that differs between homes. Any
#                 name built on it too, so a credential left mid-write by a
#                 token refresh can never be carried into ~/.codex.
#   config.toml   rendered per home — the human's config, anu's hook block and
#                 that home's own trust rows (_codex_render_config)
# and names that are not entries at all: SQLite's -wal/-shm/-journal (they
# belong beside the REAL database, which is where SQLite keeps them), and
# anu's own backups and scratch files.
_codex_unshared() {
  case "$1" in
    auth.json|auth.json.*|.auth.json*)     return 0 ;;
    config.toml)                           return 0 ;;
    *-wal|*-shm|*-journal)                 return 0 ;;
    *.pre-link.*|.anu-*|config.toml.tmp-*) return 0 ;;
  esac
  return 1
}
_CODEX_SETTLE=60   # seconds a home-only entry must sit unchanged before it moves
_CODEX_STAMP=""    # one backup stamp per share, set under the lock
_codex_say()    { printf 'anu account: %s\n' "$*" >&2; }
# perl makes a few steps exact (rename(2), symlink(2), flock(2)) and the merge
# one process; every one of them has a plain-shell fallback, which a test can
# force.
_codex_perl()   { _have perl && ! { [ "${ANU_ACCOUNT_TEST:-0}" = 1 ] && [ -n "${ANU_ACCOUNT_TEST_NO_PERL:-}" ]; }; }
_codex_exists() { [ -e "$1" ] || [ -L "$1" ]; }   # a dangling link is still a name
_tilde() { case "$1" in "$HOME"/*) printf '~/%s' "${1#"$HOME"/}" ;; *) printf '%s' "$1" ;; esac; }

# A name that can be a home: never the old store, a backup, a dotfile or a path.
_codex_home_name_ok() { case "$1" in ''|sessions|.*|*/*|*.pre-link.*) return 1 ;; esac; }
_codex_user_dir_ready() {  # ~/.codex with a sessions/, made 0700 when anu is the first to need it
  [ -d "$CODEX_USER_DIR/sessions" ] && return 0
  ( umask 077; mkdir -p "$CODEX_USER_DIR/sessions" ) 2>/dev/null
}
_codex_backup_name() {  # $1 = path. A free name beside it — free for a database's sidecars too.
  local b="$1.pre-link.$_CODEX_STAMP" i=1
  while _codex_exists "$b" || _codex_exists "$b-wal" || _codex_exists "$b-shm" || _codex_exists "$b-journal"; do
    b="$1.pre-link.$_CODEX_STAMP-$i"; i=$((i + 1))
  done
  printf '%s' "$b"
}
_codex_settled() {  # $1 = path: unchanged — its WAL included — for _CODEX_SETTLE seconds
  local now m f; now="$(date +%s)"
  for f in "$1" "$1-wal"; do
    [ -e "$f" ] || continue
    m="$(_mtime "$f")"
    [ "$m" != 0 ] && [ $((now - m)) -ge "$_CODEX_SETTLE" ] || return 1
  done
}
_codex_is_db() {  # $1 = a regular file
  case "$1" in *.sqlite|*.sqlite3|*.db) return 0 ;; esac
  [ "$(head -c 15 "$1" 2>/dev/null || true)" = "SQLite format 3" ]
}
# Rename $1 to EXACTLY $2: never INTO a directory that appeared at $2 (what
# mv(1) does), never over a file there. rename(2) through perl where it can;
# mv(1) is the fallback, and the path that crosses filesystems.
_codex_rename() {
  _codex_exists "$2" && return 1
  if _codex_perl && perl -e 'exit(rename($ARGV[0], $ARGV[1]) ? 0 : 1)' "$1" "$2" 2>/dev/null; then return 0; fi
  _codex_exists "$1" || return 1
  _codex_exists "$2" && return 1
  mv "$1" "$2" 2>/dev/null
}
# A link at EXACTLY $2: symlink(2) fails where ln(1) would quietly put the
# link inside a directory that appeared there.
_codex_symlink() {
  if _codex_perl; then perl -e 'exit(symlink($ARGV[0], $ARGV[1]) ? 0 : 1)' "$1" "$2" 2>/dev/null; return; fi
  _codex_exists "$2" && return 1
  ln -s "$1" "$2" 2>/dev/null
}
# Replace the regular file $1 with a link to $2 in ONE rename, so the name is
# never missing. $3, when given, is a backup name, hard-linked first (copied
# only where the filesystem cannot link).
_codex_swap_file() {
  local f="$1" c="$2" bk="${3:-}" tmp="${1%/*}/.anu-link.${BASHPID:-$$}"
  if [ -n "$bk" ]; then ln "$f" "$bk" 2>/dev/null || cp -p "$f" "$bk" 2>/dev/null || return 1; fi
  rm -f "$tmp"
  if ln -s "$c" "$tmp" 2>/dev/null && mv -f "$tmp" "$f" 2>/dev/null; then return 0; fi
  rm -f "$tmp"; [ -z "$bk" ] || rm -f "$bk"   # the original is untouched; the extra name goes
  return 1
}
# Copy-if-absent, $1 into $2, by relative path, never overwriting: every
# directory $2 lacks is made, and every file is HARD-LINKED in (a symlink is
# re-made as itself). A link never compares contents, which is the point:
# rsync's --link-dest links a file only while its size still matches the file
# list, so a rollout a live pane appends to mid-merge would be byte-copied and
# frozen. A name $2 already holds, as anything, is left alone, and a subtree
# under it stays only in the backup. Across filesystems, where nothing can be
# linked, an absent file is copied instead. $3 = `recent` touches only the
# directories changed in the last minute: the second pass, after the swap,
# for a file a live pane created while the first one ran.
#
# One perl process where there is perl — a home's .tmp can hold thousands of
# directories of stale clones — else one ln(1) per directory.
_codex_merge_dir() {
  local src="$1" dst="$2" recent="${3:-}" rel sd dd f
  if _codex_perl; then
    perl -MFile::Find -MErrno -e '
      my ($src, $dst, $recent, $copy) = @ARGV; my $now = time; my %live;
      find({ no_chdir => 1, wanted => sub {
        my $p = $File::Find::name; my $d = $dst . substr($p, length $src);
        if (-d $p && !-l $p) {
          if (!-e $d && !-l $d) { unless (mkdir $d) { $File::Find::prune = 1; return } }
          elsif (!-d $d) { $File::Find::prune = 1; return }
          $live{$p} = 1 if !$recent || $now - (lstat $p)[9] < 60;
          return;
        }
        return unless $live{$File::Find::dir} && !-e $d && !-l $d;
        if (-l $p) { my $t = readlink $p; symlink($t, $d) if defined $t; return }
        return if !$copy && link($p, $d);
        system("cp", "-p", $p, $d) if $copy || $!{EXDEV};
      } }, $src);' "$src" "$dst" "$recent" \
      "$( [ "${ANU_ACCOUNT_TEST:-0}" = 1 ] && [ -n "${ANU_ACCOUNT_TEST_CROSS_DEVICE:-}" ] && echo 1 )" 2>/dev/null \
      && return 0   # a perl that died falls through to the walk below
  fi
  local sdev ddev   # GNU stat first: its -f is the FILESYSTEM's status, not the file's
  sdev="$(stat -c %d "$src" 2>/dev/null || stat -f %d "$src" 2>/dev/null)" || sdev=""
  ddev="$(stat -c %d "$dst/" 2>/dev/null || stat -f %d "$dst/" 2>/dev/null)" || ddev=""
  if [ "${ANU_ACCOUNT_TEST:-0}" = 1 ] && [ -n "${ANU_ACCOUNT_TEST_CROSS_DEVICE:-}" ]; then ddev="x$ddev"; fi
  while IFS= read -r -d '' rel; do
    rel="${rel#.}"; sd="$src$rel"; dd="$dst$rel"
    if ! _codex_exists "$dd"; then mkdir "$dd" 2>/dev/null || continue; fi
    [ -d "$dd" ] || continue
    if [ -n "$sdev" ] && [ "$sdev" = "$ddev" ]; then
      ln -P -- "$sd"/* "$sd"/.[!.]* "$sd"/..?* "$dd"/ >/dev/null 2>&1 || true
    else
      for f in "$sd"/* "$sd"/.[!.]* "$sd"/..?*; do
        _codex_exists "$f" || continue
        { [ -d "$f" ] && ! [ -L "$f" ]; } && continue           # a directory: the walk reaches it
        _codex_exists "$dd/${f##*/}" || cp -pP "$f" "$dd/${f##*/}" 2>/dev/null || true
      done
    fi
  done < <(cd "$src" && if [ "$recent" = recent ]; then find . -type d -mmin -1 -print0; else find . -type d -print0; fi 2>/dev/null)
  return 0
}
# Append to ~/.codex's $2 the lines of the home's $1 it lacks; prints how many.
# Under an exclusive flock(2) where perl is there to take one, and always on a
# line of its own, even when the file's last line has no newline yet.
_codex_merge_jsonl() {
  local src="$1" dst="$2" add n
  add="$(mktemp 2>/dev/null)" || return 1
  if ! awk 'FILENAME == ARGV[1] { seen[$0] = 1; next } !($0 in seen) { seen[$0] = 1; print }' \
      "$dst" "$src" > "$add" 2>/dev/null; then
    rm -f "$add"; return 1
  fi
  n="$(awk 'END { print NR }' "$add")"
  if [ "$n" -gt 0 ]; then
    if _codex_perl; then
      perl -MFcntl=:flock -e '
        open(my $o, ">>", $ARGV[0]) or exit 1; flock($o, LOCK_EX) or exit 1;
        my $pre = "";
        if (open(my $r, "<", $ARGV[0])) {
          my $s = -s $r;
          if ($s) { seek($r, $s - 1, 0); read($r, my $l, 1); $pre = "\n" if $l ne "\n"; }
          close($r);
        }
        open(my $i, "<", $ARGV[1]) or exit 1; my $d = do { local $/; <$i> };
        print {$o} $pre . $d or exit 1; close($o) or exit 1;' "$dst" "$add" \
        || { rm -f "$add"; return 1; }
    else
      { if [ -s "$dst" ] && [ "$(tail -c 1 "$dst" | wc -l | tr -d ' ')" = 0 ]; then printf '\n'; fi
        cat "$add"; } >> "$dst" || { rm -f "$add"; return 1; }
    fi
  fi
  rm -f "$add"
  printf '%s' "$n"
}
# Keep a home's database whole under the backup name — every part hard-linked
# there BEFORE the swap, so the backup is never missing its WAL — and put the
# link to ~/.codex's in its place with one rename. A process that still has the
# old database open goes on writing to it, under the backup name, where
# nothing is lost; every open from here on lands in ~/.codex's.
_codex_keep_db() {  # $1 = the home's database, $2 = ~/.codex's, $3 = the backup name
  local h="$1" c="$2" bk="$3" sfx
  for sfx in -wal -shm -journal; do
    [ -e "$h$sfx" ] || continue
    ln "$h$sfx" "$bk$sfx" 2>/dev/null || { rm -f "$bk-wal" "$bk-shm" "$bk-journal"; return 1; }
  done
  _codex_swap_file "$h" "$c" "$bk" || { rm -f "$bk-wal" "$bk-shm" "$bk-journal"; return 1; }
  for sfx in -wal -shm -journal; do rm -f "$h$sfx"; done   # still there, under the backup name
}
# Move the home's file $1 to $2 (free) in ~/.codex, then link it back. A
# database moves as hard links, sidecars first — it must never appear in
# ~/.codex without its WAL — and stays put rather than cross a filesystem.
_codex_move_file() {
  local h="$1" c="$2" sfx tmp
  if _codex_is_db "$h"; then
    for sfx in -wal -shm -journal; do _codex_exists "$c$sfx" && return 1; done
    for sfx in -wal -shm -journal; do
      [ -e "$h$sfx" ] || continue
      ln "$h$sfx" "$c$sfx" 2>/dev/null || { rm -f "$c-wal" "$c-shm" "$c-journal"; return 1; }
    done
    ln "$h" "$c" 2>/dev/null || { rm -f "$c-wal" "$c-shm" "$c-journal"; return 1; }
    _codex_swap_file "$h" "$c" || return 1
    for sfx in -wal -shm -journal; do rm -f "$h$sfx"; done
    return 0
  fi
  if ! ln "$h" "$c" 2>/dev/null; then
    _codex_exists "$c" && return 1
    tmp="${c%/*}/.anu-move.${BASHPID:-$$}"
    { cp -p "$h" "$tmp" 2>/dev/null && _codex_rename "$tmp" "$c"; } || { rm -f "$tmp"; return 1; }
  fi
  _codex_swap_file "$h" "$c"
}

# One entry of the view. $1 = the directory holding it (a home, or
# $CODEX_ACCOUNT_DIR for the old store), $2 = its name, $3 = fix|check.
# `check` changes nothing and, when the entry is not what the view needs,
# prints `<kind><TAB><name>` — kind is `real` (a real entry where the link
# belongs), `here` (a name only the home holds), `elsewhere` (a link that
# resolves somewhere else) or `missing` (no link yet); `fix` makes it so.
_codex_share_entry() {
  local dir="$1" n="$2" mode="$3" h c bk added
  h="$dir/$n"; c="$CODEX_USER_DIR/$n"
  if _codex_exists "$c"; then
    # Already the same thing as ~/.codex's — the view, or ~/.codex's own entry
    # linked the other way, at this one. Either way there is nothing to fold.
    [ "$h" -ef "$c" ] && return 0
    if [ -L "$h" ]; then
      [ "$(readlink "$h")" = "$c" ] && return 0          # ~/.codex's own entry dangles; the link is right
      [ "$mode" = check ] && { printf 'elsewhere\t%s\n' "$n"; return 0; }
      bk="$(_codex_backup_name "$h")"
      if _codex_rename "$h" "$bk" && _codex_symlink "$c" "$h"; then
        _codex_say "$(_tilde "$h") pointed at $(readlink "$bk"); it now points at $(_tilde "$c") (the old link is kept as ${bk##*/})"
        return 0
      fi
      _codex_say "could not relink $(_tilde "$h") at $(_tilde "$c")"; return 1
    fi
    if ! [ -e "$h" ]; then
      [ "$mode" = check ] && { printf 'missing\t%s\n' "$n"; return 0; }
      ln -s "$c" "$h" 2>/dev/null || { _codex_say "could not link $(_tilde "$h") at $(_tilde "$c")"; return 1; }
      return 0
    fi
    [ "$mode" = check ] && { printf 'real\t%s\n' "$n"; return 0; }
    bk="$(_codex_backup_name "$h")"
    if [ -d "$h" ]; then
      if [ -d "$c" ] && ! _codex_merge_dir "$h" "$c"; then
        _codex_say "could not merge $(_tilde "$h") into $(_tilde "$c"); left it as it is"; return 1
      fi
      if ! _codex_rename "$h" "$bk"; then
        _codex_say "could not set $(_tilde "$h") aside; left it as it is"; return 1
      fi
      if ! _codex_symlink "$c" "$h"; then
        _codex_say "set $(_tilde "$h") aside as ${bk##*/} but could not link it at $(_tilde "$c")"; return 1
      fi
      # A file a live pane created while the first pass ran is in the backup
      # now; one more pass over what changed in the last minute links it too.
      [ -d "$c" ] && _codex_merge_dir "$bk" "$c" recent
      if [ -d "$c" ]; then
        _codex_say "merged $(_tilde "$h") into $(_tilde "$c") and linked it; the original is kept beside it as ${bk##*/}"
      else
        _codex_say "$(_tilde "$h") is a directory where $(_tilde "$c") is not; kept it as ${bk##*/} and linked ~/.codex's"
      fi
      return 0
    fi
    if _codex_is_db "$h"; then
      _codex_keep_db "$h" "$c" "$bk" \
        || { _codex_say "could not set the database $(_tilde "$h") aside; left it as it is"; return 1; }
      _codex_say "kept the database $(_tilde "$h") as ${bk##*/} (a database is never merged) and linked $(_tilde "$c")"
      return 0
    fi
    if [ "${n%.jsonl}" != "$n" ] && [ -f "$c" ]; then
      added="$(_codex_merge_jsonl "$h" "$c")" \
        || { _codex_say "could not append $(_tilde "$h") to $(_tilde "$c"); left it as it is"; return 1; }
      _codex_swap_file "$h" "$c" "$bk" \
        || { _codex_say "appended $(_tilde "$h") to $(_tilde "$c") but could not link it; left it in place"; return 1; }
      _codex_say "appended the $added line(s) of $(_tilde "$h") that $(_tilde "$c") lacked and linked it; the original is kept beside it as ${bk##*/}"
      return 0
    fi
    _codex_swap_file "$h" "$c" "$bk" \
      || { _codex_say "could not set $(_tilde "$h") aside; left it as it is"; return 1; }
    _codex_say "kept $(_tilde "$h") as ${bk##*/} (only directories and .jsonl are merged) and linked $(_tilde "$c")"
    return 0
  fi
  # ~/.codex has no such entry.
  if [ -L "$h" ]; then
    # One of the view's own links whose entry has left ~/.codex: dropping a
    # link that dangles loses nothing. A link anyone else made is theirs.
    [ "$mode" = fix ] && [ "$(readlink "$h")" = "$c" ] && rm -f "$h"
    return 0
  fi
  _codex_exists "$h" || return 0
  [ "$mode" = check ] && { printf 'here\t%s\n' "$n"; return 0; }
  _codex_settled "$h" || return 0                        # still being written: a later pass moves it
  if [ -d "$h" ]; then
    _codex_rename "$h" "$c" \
      || { _codex_say "could not move $(_tilde "$h") into $(_tilde "$CODEX_USER_DIR"); left it as it is"; return 1; }
    _codex_symlink "$c" "$h" \
      || { _codex_say "moved $(_tilde "$h") to $(_tilde "$c") but could not link it back"; return 1; }
  else
    _codex_move_file "$h" "$c" \
      || { _codex_say "could not move $(_tilde "$h") into $(_tilde "$CODEX_USER_DIR"); left it as it is"; return 1; }
  fi
  _codex_say "moved $(_tilde "$h") into $(_tilde "$CODEX_USER_DIR"), which had none, and linked it back"
}
# Every entry of one home: everything ~/.codex has, then what only the home
# has. $1 = the home, $2 = fix|check.
_codex_share_home() {
  local home="$1" mode="${2:-fix}" p n rc=0
  { [ -d "$home" ] && ! [ -L "$home" ]; } || return 0
  [ "$home" -ef "$CODEX_USER_DIR" ] && return 1          # ~/.codex is the store, never a view of itself
  for p in "$CODEX_USER_DIR"/* "$CODEX_USER_DIR"/.[!.]* "$CODEX_USER_DIR"/..?*; do
    _codex_exists "$p" || continue
    n="${p##*/}"
    _codex_unshared "$n" && continue
    _codex_share_entry "$home" "$n" "$mode" || rc=1
  done
  for p in "$home"/* "$home"/.[!.]* "$home"/..?*; do
    _codex_exists "$p" || continue
    n="${p##*/}"
    _codex_unshared "$n" && continue
    _codex_exists "$CODEX_USER_DIR/$n" && continue       # the first pass had it
    _codex_share_entry "$home" "$n" "$mode" || rc=1
  done
  return "$rc"
}
# An exclusive mkdir lock over every change to the view, so two launches of one
# account (a swarm spawns several at once) never fold the same entry twice.
# A holder that died is reclaimed — moved aside and dropped only if it still
# names the pid judged dead — and a wait past 30s gives up rather than hang a
# launch.
_codex_share_lock() {
  local d="$CODEX_ACCOUNT_DIR/.share.lock" tries=0 hp m
  while ! mkdir "$d" 2>/dev/null; do
    hp=""; [ -f "$d/pid" ] && hp="$(cat "$d/pid" 2>/dev/null || true)"
    if [ -n "$hp" ] && ! kill -0 "$hp" 2>/dev/null; then _codex_share_reclaim "$d" "$hp"; continue; fi
    if [ -z "$hp" ]; then
      m="$(_mtime "$d")"
      if [ "$m" != 0 ] && [ $(( $(date +%s) - m )) -ge 60 ]; then _codex_share_reclaim "$d" ""; continue; fi
    fi
    tries=$((tries + 1)); [ "$tries" -lt 150 ] || return 1
    sleep 0.2
  done
  printf '%s\n' "${BASHPID:-$$}" > "$d/pid"
}
_codex_share_reclaim() {  # $1 = the lock dir, $2 = the pid it was judged stale for
  local away="$1.stale.${BASHPID:-$$}" now=""
  mv "$1" "$away" 2>/dev/null || return 0
  [ -f "$away/pid" ] && now="$(cat "$away/pid" 2>/dev/null || true)"
  if [ "$now" != "$2" ]; then
    [ -e "$1" ] || mv "$away" "$1" 2>/dev/null || true   # a live holder's: put it back
  fi
  rm -rf "$away" 2>/dev/null || true
}
_codex_share_unlock() {
  local d="$CODEX_ACCOUNT_DIR/.share.lock" hp=""
  [ -f "$d/pid" ] && hp="$(cat "$d/pid" 2>/dev/null || true)"
  [ "$hp" = "${BASHPID:-$$}" ] && rm -rf "$d"
  return 0
}
# Make the old store and one account's home views of ~/.codex. Lock-free,
# write-free and silent when they already are. $1 = the account name (empty:
# the old store alone).
_codex_share_all() {
  local home="" pending rc=0
  if [ -n "${1:-}" ]; then
    _codex_home_name_ok "$1" || { _codex_say "'$1' cannot name a codex home"; return 1; }
    home="$(_codex_home "$1")"
  fi
  _codex_user_dir_ready || { _codex_say "could not create $(_tilde "$CODEX_USER_DIR"), the store every codex home is a view of"; return 1; }
  pending="$(_codex_share_entry "$CODEX_ACCOUNT_DIR" sessions check
             [ -z "$home" ] || _codex_share_home "$home" check)" || true
  [ -n "$pending" ] || return 0
  if ! _codex_share_lock; then
    _codex_say "another anu is folding codex state into $(_tilde "$CODEX_USER_DIR"); nothing was changed this time"
    return 1
  fi
  _CODEX_STAMP="$(date +%Y%m%d-%H%M%S)"
  _codex_share_entry "$CODEX_ACCOUNT_DIR" sessions fix || rc=1
  [ -z "$home" ] || _codex_share_home "$home" fix || rc=1
  _codex_share_unlock
  return "$rc"
}

# The lifecycle events anu subscribes to, as "<Table> <event_snake> <sub-verb>
# <timeout>". Only what anu READS is registered. A usage-limit turn fires no
# Stop hook at all (Codex ends that turn through an internal error path) and
# leaves its record in the rollout instead, so a Stop or SessionEnd table here
# would be a hook that never says anything anu acts on — and every installed
# hook is one more command Codex runs outside its sandbox.
_CODEX_EVENTS='SessionStart	session_start	session-start	600
UserPromptSubmit	user_prompt_submit	user-prompt	600'

# The command an installed hook runs: the ABSOLUTE path of the anu-account
# that is doing the installing, resolved through symlinks, and never a name
# anybody has to look up.
#
# It used to write `anu account …` when the dispatcher was on PATH. Codex
# 0.156.0 ended that: the hooks it spawns no longer see the launching shell's
# PATH, so the installed command resolved to a different `anu` — or to none —
# and the hook did nothing at all. Silently, which is the worst part: a hook
# that fails to run is a hook that writes no stamp, so the pane simply never
# learned its own session id and no rotation could ever resume it. (The
# model-switcher was unaffected for exactly this reason: it writes absolute
# binary paths.)
#
# `$0` is resolved through symlinks so a home installed by way of a link and
# one installed directly agree, and so the recorded command still names a file
# that exists after the link is gone. `realpath` is used where it exists; the
# fallback resolves the directory with `pwd -P` and the final component by
# hand, which covers the one link layer an install actually uses.
#
# The path is baked into the trust hash, so moving the binary is what makes an
# installed hook read as stale and get re-installed — rather than sitting there
# untrusted, or pointing at nothing.
_codex_hook_prefix() {
  if [ -n "${ANU_ACCOUNT_HOOK_CMD:-}" ]; then printf '%s' "$ANU_ACCOUNT_HOOK_CMD"; return 0; fi
  local self=""
  self="$(realpath "$0" 2>/dev/null)" || self=""
  if [ -z "$self" ]; then
    local d b; d="$(cd "$(dirname "$0")" 2>/dev/null && pwd -P)" || d=""
    b="$(basename "$0")"
    if [ -n "$d" ] && [ -L "$d/$b" ]; then
      local t; t="$(readlink "$d/$b")"
      case "$t" in
        /*) self="$t" ;;
        *)  self="$(cd "$(dirname "$d/$t")" 2>/dev/null && pwd -P)/$(basename "$t")" ;;
      esac
    elif [ -n "$d" ]; then
      self="$d/$b"
    fi
  fi
  [ -n "$self" ] || self="$COM8_ACCOUNT_SELF"
  printf '%q' "$self"
}
_codex_hook_command() { printf '%s hook codex %s' "$(_codex_hook_prefix)" "$1"; }

# The `trusted_hash` Codex computes for one hook, as `sha256:<64 hex>`.
#
# VERIFIED recipe (the 2026-09-16 spike record's Addendum, matched against all
# four hashes the Codex TUI wrote for itself): the sha256 of the compact JSON
# of the hook, keys sorted recursively, no trailing newline. `async` is always
# false and `type` always "command" because that is the only hook shape anu
# installs; a matcher or a statusMessage would add keys here, and anu sets
# neither. Codex refuses to RUN a hook whose hash it cannot match ("⚠ N hooks
# need review"), so writing the hash ourselves is what saves the human from
# opening `/settings` and pressing `t` in every account home.
_codex_trusted_hash() {  # $1 = event_snake, $2 = command, $3 = timeout
  local canonical hex
  canonical="$(jq -cn --arg e "$1" --arg c "$2" --argjson t "$3" \
    '{event_name:$e, hooks:[{async:false, command:$c, timeout:$t, type:"command"}]}')" || return 1
  hex="$(printf '%s' "$canonical" | shasum -a 256 2>/dev/null | awk '{print $1}')"
  [ -n "$hex" ] || return 1
  printf 'sha256:%s' "$hex"
}
_toml_str() {  # a TOML basic string: only " and \ need escaping in the values
  # written here (absolute paths and a command line).
  printf '"%s"' "$(printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g')"
}

# The markers around the block anu owns in a home's config.toml. Everything
# between them is ours to rewrite; every other byte is the human's — the file
# also carries their model, approval policy, MCP servers and the
# `[projects."<cwd>"]` trust rows a launch pre-writes, and a round trip
# through a parser-and-printer would reformat the hash keys and cost them
# their hook trust.
_CODEX_BEGIN='# anu-codex-hooks-begin (anu account — do not edit between the markers)'
_CODEX_END='# anu-codex-hooks-end'

# One targeted scan of a config.toml, as TSV on stdout — a direct port of the
# model-switcher scanner, not a TOML parser (a zero-dependency tool that had to
# parse TOML to read four lines it wrote itself would be carrying a parser for
# nothing). Emits:
#   MARK<TAB>begin|end<TAB><lineno>
#   EV<TAB><Event><TAB><index><TAB><hooks = … line, comment stripped>
#   ST<TAB><key><TAB><trusted_hash>
#   UNK<TAB><line>      a `hooks` header this scanner cannot attribute
# `UNK` is a REFUSAL, never a guess: every unread spelling can shift the
# matcher index the trust key is built from, and a wrong index does not fail
# loudly — it writes a hash for somebody else's hook and leaves ours silently
# untrusted, or collides with a key the human already has and makes the whole
# file unparseable to Codex (which then drops ALL of it).
_codex_scan() {
  awk '
    function strip(line,   i, c, basic, literal) {
      basic = 0; literal = 0
      for (i = 1; i <= length(line); i++) {
        c = substr(line, i, 1)
        if (basic)   { if (c == "\\") i++; else if (c == "\"") basic = 0; continue }
        if (literal) { if (c == "\047") literal = 0; continue }
        if (c == "\"") basic = 1
        else if (c == "\047") literal = 1
        else if (c == "#") return substr(line, 1, i - 1)
      }
      return line
    }
    function trim(s) { sub(/^[ \t]+/, "", s); sub(/[ \t]+$/, "", s); return s }
    function unquote(k,   b) {
      b = substr(k, 2, length(k) - 2)
      if (substr(k, 1, 1) == "\047") return b
      gsub(/\\"/, "\"", b); gsub(/\\\\/, "\\", b); return b
    }
    {
      raw = $0
      if (raw ~ /^[ \t]*# anu-codex-hooks-begin/) { print "MARK\tbegin\t" NR; next }
      if (raw ~ /^[ \t]*# anu-codex-hooks-end/)   { print "MARK\tend\t" NR; next }
      line = trim(strip(raw))
      if (line == "") next
      if (line ~ /^\[/ && line ~ /\]$/) {
        cur = ""; tkey = ""
        if (match(line, /^\[\[[ \t]*(hooks|"hooks"|\047hooks\047)[ \t]*\.[ \t]*[A-Za-z0-9_"\047-]+[ \t]*\]\]$/)) {
          inner = line; sub(/^\[\[[ \t]*/, "", inner); sub(/[ \t]*\]\]$/, "", inner)
          sub(/^(hooks|"hooks"|\047hooks\047)[ \t]*\.[ \t]*/, "", inner)
          gsub(/^["\047]|["\047]$/, "", inner)
          cur = inner; n[cur]++; idx = n[cur] - 1
          print "EV\t" cur "\t" idx "\t"
          next
        }
        if (match(line, /^\[[ \t]*(hooks|"hooks"|\047hooks\047)[ \t]*\.[ \t]*(state|"state"|\047state\047)[ \t]*\.[ \t]*("([^"\\]|\\.)*"|\047[^\047]*\047)[ \t]*\]$/)) {
          inner = line; sub(/^\[[ \t]*/, "", inner); sub(/[ \t]*\]$/, "", inner)
          sub(/^(hooks|"hooks"|\047hooks\047)[ \t]*\.[ \t]*(state|"state"|\047state\047)[ \t]*\.[ \t]*/, "", inner)
          tkey = unquote(trim(inner))
          next
        }
        if (line ~ /hooks/) print "UNK\t" line
        next
      }
      if (cur != "" && line ~ /^hooks[ \t]*=/) { print "EVCMD\t" cur "\t" (n[cur] - 1) "\t" line; next }
      if (tkey != "" && match(line, /^trusted_hash[ \t]*=[ \t]*"[^"]*"$/)) {
        v = line; sub(/^trusted_hash[ \t]*=[ \t]*"/, "", v); sub(/"$/, "", v)
        print "ST\t" tkey "\t" v
      }
    }
  ' "$1" 2>/dev/null
}

# The block anu owns, markers included, for a file whose PREFIX already has
# $2 SessionStart tables and $3 UserPromptSubmit tables ahead of ours (the
# matcher index the trust key is built from).
_codex_block() {  # $1 = config path, $2… = "<Event>=<index>" pairs
  local cfg="$1"; shift
  local -a idx=("$@")
  local table snake sub timeout cmd key hash tables="" trust="" i n
  printf '%s\n' "$_CODEX_BEGIN"
  printf '%s\n\n' "# anu installs its own Codex hooks here and pre-trusts them; re-run \`com8-account add --provider codex <name>\` to refresh."
  while IFS="$(printf '\t')" read -r table snake sub timeout; do
    [ -n "$table" ] || continue
    cmd="$(_codex_hook_command "$sub")"
    printf '[[hooks.%s]]\nhooks = [{ type = "command", command = %s }]\n\n' "$table" "$(_toml_str "$cmd")"
  done <<EOF
$_CODEX_EVENTS
EOF
  while IFS="$(printf '\t')" read -r table snake sub timeout; do
    [ -n "$table" ] || continue
    cmd="$(_codex_hook_command "$sub")"
    n=0
    for i in "${idx[@]}"; do case "$i" in "$table="*) n="${i#*=}" ;; esac; done
    key="$cfg:$snake:$n:0"
    hash="$(_codex_trusted_hash "$snake" "$cmd" "$timeout")" || return 1
    printf '[hooks.state.%s]\ntrusted_hash = %s\n\n' "$(_toml_str "$key")" "$(_toml_str "$hash")"
  done <<EOF
$_CODEX_EVENTS
EOF
  printf '%s\n' "$_CODEX_END"
}

# ------------------------------------------------- the rendered config.toml --
# An account home is a CODEX_HOME, and Codex reads exactly one configuration
# file out of it: `$CODEX_HOME/config.toml`. Verified on 0.156.1 — `codex
# doctor` names that one path, there is no include directive, no second
# config env var, no `config.d`, and the only other layer at all is the
# system-wide `/etc/codex/managed_config.toml` enterprise policy (one fixed
# root-owned path, so it can neither carry a per-account layer nor follow a
# human's own file). So a home that holds only anu's hook tables is a Codex
# running with NONE of the human's configuration: no model, no reasoning
# effort, no MCP servers. That is what shipping the codex launch did, and the
# status bar reading "default" instead of "max" was the visible half of it.
#
# The answer is to RENDER the home's config.toml rather than to edit it: at
# `add` and at every `launch --provider codex`, it is rebuilt as
#
#   (a) the human's own ~/.codex/config.toml, hooks tables stripped
#   (b) the hook tables and trust entries anu owns, hashes recomputed
#   (c) everything Codex itself wrote into THIS home that (a) does not define
#
# in that order, so the human's model, reasoning effort, features and MCP
# servers follow every account, and a change they make to their own file is
# live on the next launch. The render is two awk passes over two small files;
# it never writes to ~/.codex, and base always wins a collision — the home's
# copy of a table the human also defines is theirs to lose, and Codex will
# rewrite its own state the moment it needs it again.
#
# Hooks are the one thing (a) does not get to contribute. A hook in the base
# is either a duplicate of ours — which would run anu's hook twice per event —
# or a foreign command with no launch nonce, which anu's own hooks would
# refuse anyway. Stripping them is also what keeps the matcher index (the
# number the trust key is built from, and the number Codex checks a hash
# against) a function of this home alone.
_codex_base_config() {
  # An explicitly EMPTY override means "no base", which is what a test wants
  # and what a human who keeps no ~/.codex/config.toml already has.
  if [ -n "${ANU_CODEX_BASE_CONFIG+x}" ]; then printf '%s' "$ANU_CODEX_BASE_CONFIG"; return 0; fi
  # $CODEX_HOME is deliberately NOT read: inside an agent pane it is already
  # pointed at an account home, and rendering a home from itself would make
  # the human's file irrelevant exactly where it matters most.
  printf '%s/.codex/config.toml' "$HOME"
}

# One chunker, several projections — so the rule for where a table begins and
# ends is written once. A chunk is a top-level header (`[x]` or `[[x]]`) plus
# everything under it, with the run of blank and comment lines above the
# header counted as the header's own (a comment introducing a table travels
# with the table it introduces). Everything before the first header is the
# preamble, and the preamble is split again into ENTRIES — one per bare key —
# because `model = …` and `service_tier = …` have to be mergeable one at a
# time when the base defines one and the home the other.
#
# Modes: `preamble` (the whole preamble verbatim), `preamble_keys` (its bare
# key names), `preamble_sel` (its entries whose key is NOT in $3), `keys` (the
# header line of every non-hooks table), `hooks` / `nonhooks` (the chunks that
# are / are not rooted at `hooks`, minus any header listed in $3).
_codex_chunks() {  # $1 = file, $2 = mode, $3 = optional exclude-key file
  awk -v mode="$2" -v exclf="${3:-}" '
    function strip(line,   i, c, basic, literal) {
      basic = 0; literal = 0
      for (i = 1; i <= length(line); i++) {
        c = substr(line, i, 1)
        if (basic)   { if (c == "\\") i++; else if (c == "\"") basic = 0; continue }
        if (literal) { if (c == "\047") literal = 0; continue }
        if (c == "\"") basic = 1
        else if (c == "\047") literal = 1
        else if (c == "#") return substr(line, 1, i - 1)
      }
      return line
    }
    function trim(s) { sub(/^[ \t]+/, "", s); sub(/[ \t]+$/, "", s); return s }
    function blankish(raw,   t) { t = trim(strip(raw)); return (t == "") }
    function ishooks(k) { return (k ~ /^\[\[?[ \t]*("hooks"|\047hooks\047|hooks)[ \t]*[.\]]/) }
    function keyname(t,   k) {
      k = t; sub(/[ \t]*=.*$/, "", k); k = trim(k)
      if (substr(k, 1, 1) == "\"" || substr(k, 1, 1) == "\047") k = substr(k, 2, length(k) - 2)
      return k
    }
    # Leading blank lines are never emitted: chunks are joined with exactly
    # one blank line by the caller, so carrying the old spacing through would
    # make the render a function of base whitespace instead of base content
    # — and a second render would not be the same bytes as the first.
    function emit(c,   j, started) {
      started = 0
      for (j = 1; j <= last[c]; j++) {
        if (!started && L[c, j] ~ /^[ \t]*$/) continue
        started = 1; print L[c, j]
      }
    }
    BEGIN {
      if (exclf != "") { while ((getline l < exclf) > 0) if (l != "") excl[l] = 1; close(exclf) }
      nc = 0; N[0] = 0; last[0] = 0; K[0] = ""
    }
    {
      line = trim(strip($0))
      if (line ~ /^\[/ && line ~ /\]$/) {
        carry = 0
        for (j = last[nc] + 1; j <= N[nc]; j++) { carry++; hold[carry] = L[nc, j] }
        N[nc] = last[nc]
        nc++; N[nc] = 0; last[nc] = 0; K[nc] = line
        for (j = 1; j <= carry; j++) { N[nc]++; L[nc, N[nc]] = hold[j] }
        N[nc]++; L[nc, N[nc]] = $0; last[nc] = N[nc]
        next
      }
      N[nc]++; L[nc, N[nc]] = $0
      if (!blankish($0)) last[nc] = N[nc]
    }
    END {
      # The tail of the LAST chunk has no header to travel to, so a comment
      # closing the file stays in the chunk that holds it.
      for (j = N[nc]; j > last[nc]; j--) if (trim(L[nc, j]) != "") { last[nc] = j; break }
      if (mode == "preamble") { emit(0); exit }
      if (mode == "keys") { for (c = 1; c <= nc; c++) if (!ishooks(K[c])) print K[c]; exit }
      if (mode == "hooks" || mode == "nonhooks") {
        for (c = 1; c <= nc; c++) {
          if (mode == "hooks" && !ishooks(K[c])) continue
          if (mode == "nonhooks" && ishooks(K[c])) continue
          if (K[c] in excl) continue
          if (out++) print ""
          emit(c)
        }
        exit
      }
      # preamble_keys / preamble_sel — one entry per bare key.
      ne = 0; h = 0
      for (j = 1; j <= last[0]; j++) {
        raw = L[0, j]; t = trim(strip(raw))
        if (t ~ /^("([^"\\]|\\.)*"|\047[^\047]*\047|[A-Za-z0-9_-]+)[ \t]*=/) {
          ne++; EN[ne] = 0; EK[ne] = keyname(t)
          for (q = 1; q <= h; q++) { EN[ne]++; EL[ne, EN[ne]] = hold2[q] }
          h = 0
          EN[ne]++; EL[ne, EN[ne]] = raw
        } else if (ne == 0 || t == "") {
          h++; hold2[h] = raw
        } else {          # a continuation line of the entry above (an array over lines)
          for (q = 1; q <= h; q++) { EN[ne]++; EL[ne, EN[ne]] = hold2[q] }
          h = 0
          EN[ne]++; EL[ne, EN[ne]] = raw
        }
      }
      if (mode == "preamble_keys") { for (e = 1; e <= ne; e++) print EK[e]; exit }
      for (e = 1; e <= ne; e++) {
        if (EK[e] in excl) continue
        for (q = 1; q <= EN[e]; q++) print EL[e, q]
      }
    }
  ' "$1" 2>/dev/null
}

# Concatenate blocks with exactly one blank line between them, each block
# stripped of its own leading and trailing blank lines — so a second render
# of an unchanged home produces the same bytes as the first and "unchanged"
# stays honest.
_codex_cat_blocks() {  # $1… = files
  local f body first=1
  for f in "$@"; do
    [ -s "$f" ] || continue
    body="$(awk 'NF && !s { s = NR } s { l[++k] = $0; if (NF) last = k } END { for (i = 1; i <= last; i++) print l[i] }' "$f")"
    [ -n "$body" ] || continue
    if [ "$first" = 1 ]; then printf '%s\n' "$body"; first=0
    else printf '\n%s\n' "$body"; fi
  done
}
_codex_has_line() {  # $1 = needle, $2… = files it must not appear in
  local needle="$1"; shift
  awk -v needle="$needle" 'index($0, needle) { found = 1 } END { exit found ? 0 : 1 }' "$@" 2>/dev/null
}

# Render <home>/config.toml. Returns 1 WITHOUT writing a byte on any of the
# four refusals below; each prints its reason. Idempotent by construction: the
# render reads the home only for the parts of it the base does not define, and
# those parts come back out of a rendered file exactly as they went in.
_codex_render_config() {  # $1 = account name
  local name="$1" home cfg base
  home="$(_codex_home "$name")"; cfg="$(_codex_config "$name")"
  base="$(_codex_base_config)"
  # A base that is missing, empty or (by a mistaken override) this very file
  # is no base at all: the render is then hooks + home state, which is exactly
  # what the home held before any of this existed.
  if [ -z "$base" ] || [ ! -f "$base" ] || [ "$base" = "$cfg" ]; then base=""; fi
  ( umask 077; mkdir -p "$home" ) || { printf 'anu account: could not create %s\n' "$home" >&2; return 1; }
  chmod 700 "$home" 2>/dev/null || true
  [ -f "$cfg" ] || ( umask 077; : > "$cfg" )
  chmod 600 "$cfg" 2>/dev/null || true

  # 1. Where anu's own block sits today, so everything else in the home can be
  #    read back without it. A begin marker with no end is NOT ours to the end
  #    of the file: a half-written file or a hand edit would have everything
  #    below it swallowed, and the one thing this must never do is delete
  #    configuration it did not write.
  local scan begin=0 end=0 kind a b c
  scan="$(_codex_scan "$cfg")"
  while IFS="$(printf '\t')" read -r kind a b c; do
    [ "$kind" = MARK ] || continue
    case "$a" in begin) [ "$begin" = 0 ] && begin="$b" ;; end) [ "$begin" != 0 ] && [ "$end" = 0 ] && end="$b" ;; esac
  done <<EOF
$scan
EOF
  if [ "$begin" != 0 ] && [ "$end" = 0 ]; then
    printf "%s: a '%s' marker with no end marker; repair or remove that block by hand — refusing to overwrite everything below it\n" "$cfg" "anu-codex-hooks-begin" >&2
    return 1
  fi

  local d; d="$(mktemp -d)" || { printf 'anu account: no temp dir to render %s\n' "$cfg" >&2; return 1; }
  if [ "$begin" = 0 ]; then cat "$cfg" > "$d/home"
  else awk -v b="$begin" -v e="$end" 'NR < b || NR > e' "$cfg" > "$d/home"; fi
  : > "$d/base.pre"; : > "$d/base.keys"; : > "$d/base.prekeys"; : > "$d/base.tab"
  if [ -n "$base" ]; then
    _codex_chunks "$base" preamble       > "$d/base.pre"
    _codex_chunks "$base" preamble_keys  > "$d/base.prekeys"
    _codex_chunks "$base" keys           > "$d/base.keys"
    _codex_chunks "$base" nonhooks       > "$d/base.tab"
  fi
  # The home keeps only what the base does not claim. Its hooks tables go
  # AHEAD of anu's block and its other tables behind it, because the matcher
  # index in a trust key counts the tables for that event that PRECEDE ours —
  # so a hook the human installed in this home keeps index 0 and keeps the
  # trust they granted it through /settings.
  _codex_chunks "$d/home" preamble_sel "$d/base.prekeys" > "$d/home.pre"
  _codex_chunks "$d/home" hooks        "$d/base.keys"    > "$d/home.hooks"
  _codex_chunks "$d/home" nonhooks     "$d/base.keys"    > "$d/home.rest"
  _codex_cat_blocks "$d/base.pre" "$d/home.pre" "$d/base.tab" "$d/home.hooks" > "$d/prefix"

  # 2. A 'hooks' header this scanner cannot attribute is a REFUSAL, never a
  #    guess: an unread spelling shifts the matcher index, and a wrong index
  #    does not fail loudly — it writes a hash for somebody else's hook and
  #    leaves ours silently untrusted, or collides with a key the human
  #    already has and makes the whole file unparseable to Codex (which then
  #    drops ALL of it).
  local pscan; pscan="$(_codex_scan "$d/prefix")"
  local ukind ua
  while IFS="$(printf '\t')" read -r ukind ua b c; do
    [ "$ukind" = UNK ] || continue
    printf "%s: a 'hooks' table anu cannot read (%s); install the hooks by hand or simplify that table — refusing to guess\n" "$cfg" "$ua" >&2
    rm -rf "$d"; return 1
  done <<EOF
$pscan
EOF

  local table snake sub timeout cmd n
  # 3. A table already running OUR command outside the markers (a hand
  #    install, a copy from another home): appending would run the hook twice
  #    for every event, and dropping the stray table would silently delete
  #    trust the human granted through /settings.
  while IFS="$(printf '\t')" read -r table snake sub timeout; do
    [ -n "$table" ] || continue
    cmd="$(_codex_hook_command "$sub")"
    if _codex_has_line "command = $(_toml_str "$cmd")" "$d/prefix" "$d/home.rest"; then
      printf '%s: a hook already runs `%s` outside the anu-codex-hooks markers; remove that table by hand — refusing to install a duplicate\n' "$cfg" "$cmd" >&2
      rm -rf "$d"; return 1
    fi
  done <<EOF
$_CODEX_EVENTS
EOF

  local -a idx=()
  while IFS="$(printf '\t')" read -r table snake sub timeout; do
    [ -n "$table" ] || continue
    n="$(awk -F'\t' -v tbl="$table" '$1 == "EV" && $2 == tbl { c++ } END { print c + 0 }' <<EOF2
$pscan
EOF2
)"
    # 4. A trust entry for the EXACT key we are about to write, already in the
    #    file outside our block, would be a DUPLICATE TOML key — and Codex
    #    answers an invalid config.toml by dropping the whole of it, hooks,
    #    model and MCP servers included. Only the exact key collides: a human
    #    who granted trust to their OWN SessionStart hook through /settings
    #    owns `…:session_start:0:0`, and ours is `…:session_start:1:0`
    #    precisely because their table pushed the matcher index along.
    if _codex_has_line "[hooks.state.\"$cfg:$snake:$n:0\"]" "$d/prefix" "$d/home.rest"; then
      printf '%s: the trust entry [hooks.state."%s:%s:%s:0"] is already in this file outside the anu-codex-hooks markers; remove it by hand — refusing to write a duplicate key\n' \
        "$cfg" "$cfg" "$snake" "$n" >&2
      rm -rf "$d"; return 1
    fi
    idx+=("$table=$n")
  done <<EOF
$_CODEX_EVENTS
EOF

  if ! _codex_block "$cfg" "${idx[@]}" > "$d/block"; then
    printf 'anu account: could not compute the Codex hook trust hashes (jq/shasum)\n' >&2
    rm -rf "$d"; return 1
  fi
  local next; next="$(_codex_cat_blocks "$d/prefix" "$d/block" "$d/home.rest")"
  rm -rf "$d"
  [ "$next" = "$(cat "$cfg")" ] && return 0
  ( umask 077; printf '%s\n' "$next" > "$cfg.tmp-$$" ) && mv -f "$cfg.tmp-$$" "$cfg" || {
    rm -f "$cfg.tmp-$$" 2>/dev/null
    printf 'anu account: could not write %s\n' "$cfg" >&2
    return 1
  }
  chmod 600 "$cfg" 2>/dev/null || true
}

# True when anu's hooks are installed AND trusted in this home. Both halves
# matter and neither implies the other: tables without a matching
# `trusted_hash` are hooks Codex refuses to run, and a STALE hash is the same
# thing with a more confusing symptom, because the file LOOKS installed.
# Make `cwd` a directory this account's Codex trusts, and say whether that
# worked. A port of the model-switcher's `ensureCodexTrust`, and the reasons
# are its reasons: trust is PER HOME, so a tool that gives every account its
# own home meets the "Do you trust the contents of this directory?" modal once
# per (account, directory) pair — a modal no unattended rotation can answer.
# So the row is pre-written, by line scan and never by re-serialising: this
# file also holds the hook tables and their trust hashes, and a round trip
# through a parser-and-printer would reformat those keys and cost the human
# their hook trust.
#
# Exactly one of four things happens:
#   * no table for this project      → append one
#   * a table with no `trust_level`  → insert the key under its header
#   * a table already "trusted"      → nothing at all
#   * anything else                  → REFUSE, not one byte written
#
# Both refusals are the point. A `trust_level` the human set to something else
# is an ANSWER, and anu does not overrule a human's answer about their own
# directory. And a `projects` definition this scanner cannot attribute — an
# inline table, a bare `[projects]`, a malformed header — must never be
# appended beside, because two definitions of one table is invalid TOML and
# Codex responds to an invalid config.toml by dropping the WHOLE of it: hook
# tables, hook trust and every directory the human has already trusted.
# Refusing costs one candidate; appending blind costs all of that, silently.
_codex_trust() {  # $1 = account name, $2 = cwd. Prints its reason on failure.
  local name="$1" cwd="$2" home cfg resolved
  home="$(_codex_home "$name")"; cfg="$(_codex_config "$name")"
  # Codex records the directory it actually RESOLVED: a link and its target
  # are one project, and trusting the link leaves the modal waiting behind it.
  resolved="$(cd "$cwd" 2>/dev/null && pwd -P)" || resolved="$cwd"
  if [ ! -f "$cfg" ]; then
    ( umask 077; mkdir -p "$home" ) || return 1
    printf '[projects.%s]\ntrust_level = "trusted"\n' "$(_toml_str "$resolved")" > "$cfg" || return 1
    chmod 600 "$cfg" 2>/dev/null || true
    return 0
  fi
  local verdict; verdict="$(_codex_trust_scan "$cfg" "$resolved")"
  local kind a b
  IFS="$(printf '\t')" read -r kind a b <<EOF
$verdict
EOF
  case "$kind" in
    OPAQUE)
      printf "%s already defines 'projects' in a form anu will not edit (line %s); add [projects.%s] trust_level = \"trusted\" to it yourself\n" \
        "$cfg" "$a" "$(_toml_str "$resolved")" >&2
      return 1 ;;
    TRUSTED) return 0 ;;
    OTHER)
      printf '%s is marked %s in %s; edit it or land elsewhere\n' "$resolved" "$a" "$cfg" >&2
      return 1 ;;
    HEADER)   # the table is there but carries no trust_level
      # 0600 on the way in, not inherited from whatever umask this rotation
      # ran under: config.toml names every project this account is trusted in
      # and decides what runs unattended.
      local tmpf="$cfg.tmp-$$"
      ( umask 077
        awk -v h="$a" 'NR == h { print; print "trust_level = \"trusted\""; next } { print }' "$cfg" > "$tmpf" ) \
        && mv -f "$tmpf" "$cfg" || { rm -f "$tmpf" 2>/dev/null; return 1; }
      chmod 600 "$cfg" 2>/dev/null || true
      return 0 ;;
    *)        # no table for this project at all
      printf '\n[projects.%s]\ntrust_level = "trusted"\n' "$(_toml_str "$resolved")" >> "$cfg" || return 1
      return 0 ;;
  esac
}
# One verdict line for `_codex_trust`: OPAQUE<TAB><line>, TRUSTED,
# OTHER<TAB><value>, HEADER<TAB><line>, or nothing (no table for this project).
_codex_trust_scan() {
  awk -v want="$2" '
    function strip(line,   i, c, basic, literal) {
      basic = 0; literal = 0
      for (i = 1; i <= length(line); i++) {
        c = substr(line, i, 1)
        if (basic)   { if (c == "\\") i++; else if (c == "\"") basic = 0; continue }
        if (literal) { if (c == "\047") literal = 0; continue }
        if (c == "\"") basic = 1
        else if (c == "\047") literal = 1
        else if (c == "#") return substr(line, 1, i - 1)
      }
      return line
    }
    function trim(s) { sub(/^[ \t]+/, "", s); sub(/[ \t]+$/, "", s); return s }
    BEGIN { scope = "other"; root = 1; header = 0 }
    {
      if (done) next
      line = trim(strip($0))
      if (line ~ /^\[/) {
        root = 0
        # `[[projects…]]`, `[projects]`, `[projects.<bare>]` and any malformed
        # spelling are all shapes this writer cannot attribute.
        if (line ~ /^\[\[[ \t]*(projects|"projects"|\047projects\047)[ \t]*[.\]]/) { print "OPAQUE\t" NR; done = 1; next }
        if (line ~ /^\[[ \t]*(projects|"projects"|\047projects\047)[ \t]*\]$/)     { print "OPAQUE\t" NR; done = 1; next }
        if (line ~ /^\[[ \t]*(projects|"projects"|\047projects\047)[ \t]*\./) {
          if (line !~ /^\[[ \t]*(projects|"projects"|\047projects\047)[ \t]*\.[ \t]*("([^"\\]|\\.)*"|\047[^\047]*\047)[ \t]*\]$/) {
            print "OPAQUE\t" NR; done = 1; next
          }
          inner = line; sub(/^\[[ \t]*/, "", inner); sub(/[ \t]*\]$/, "", inner)
          sub(/^(projects|"projects"|\047projects\047)[ \t]*\.[ \t]*/, "", inner)
          inner = trim(inner)
          q = substr(inner, 1, 1)
          body = substr(inner, 2, length(inner) - 2)
          if (q == "\"") { gsub(/\\"/, "\"", body); gsub(/\\\\/, "\\", body) }
          if (body == want) { scope = "ours"; if (header == 0) header = NR }
          else scope = "theirs"
          next
        }
        scope = "other"; next
      }
      if (root && line ~ /^(projects|"projects"|\047projects\047)[ \t]*[.=]/) { print "OPAQUE\t" NR; done = 1; next }
      if (scope == "ours" && line ~ /^trust_level[ \t]*=/) {
        v = line; sub(/^trust_level[ \t]*=[ \t]*/, "", v); v = trim(v)
        gsub(/^["\047]|["\047]$/, "", v)
        if (v == "trusted") print "TRUSTED"; else print "OTHER\t" v
        done = 1; next
      }
    }
    END { if (!done && header > 0) print "HEADER\t" header }
  ' "$1" 2>/dev/null
}

# Everything that has to be true about a destination account BEFORE the pane
# leaves the one it is on. An untrusted or unauthenticated candidate is SKIPPED
# here, never "fixed" at relaunch: by relaunch time the old process is gone and
# a modal or a refused hook has nowhere to report itself.
# Every refusal says WHY, on stderr. A skipped candidate used to surface only
# as "nothing has room for any", which sends the reader to the dashboard to
# look for capacity that was never the problem — the account was there, ranked
# and with room, and anu declined to land on it. The three reasons are three
# different things to go and fix, and `_codex_trust`'s own message (a
# `trust_level` a human set, a `projects` table anu will not edit) names a
# line in a file.
_codex_candidate_ok() {  # $1 = account name, $2 = the pane's cwd
  local name="$1" cwd="$2" why
  if ! _codex_authed "$name"; then
    printf 'anu account: skipping %s — no auth.json in %s (com8-account add --provider codex %s)\n' \
      "$name" "$(_codex_home "$name")" "$name" >&2
    return 1
  fi
  # The preflight JUDGES a home; it never repairs one. The render at launch
  # would rewrite this block and make every question below answer yes — a
  # stale hash, a hook command edited without re-trusting it, a hook naming a
  # program that is gone would all read as healthy because the render had just
  # replaced them. Those are things a human has to see, and skipping the
  # candidate is how they see it. (The render is checked against this function
  # the other way round instead: a rendered home PASSES `_codex_hooks_ok`,
  # because the block it writes is the block this reads.)
  if ! _codex_hooks_ok "$name"; then
    printf 'anu account: skipping %s — its hook tables are missing, or their trust hashes do not match the commands in %s, so Codex would refuse to run them (com8-account add --provider codex %s)\n' \
      "$name" "$(_codex_config "$name")" "$name" >&2
    return 1
  fi
  if ! why="$(_codex_trust "$name" "$cwd" 2>&1)"; then
    printf 'anu account: skipping %s — %s\n' "$name" "${why:-could not record directory trust}" >&2
    return 1
  fi
  return 0
}

# The `command = "…"` of a `hooks = [{ … }]` line, unescaped. Anchored on
# `command` followed by `=`, so the `type = "command"` that precedes it on
# every one of these lines is not mistaken for the key.
_codex_line_command() {
  awk '{
    if (!match($0, /command[ \t]*=[ \t]*"/)) exit 1
    s = substr($0, RSTART + RLENGTH)
    out = ""
    for (k = 1; k <= length(s); k++) {
      c = substr(s, k, 1)
      if (c == "\\") {
        k++; d = substr(s, k, 1)
        if (d == "n") out = out "\n"
        else if (d == "t") out = out "\t"
        else out = out d
        continue
      }
      if (c == "\"") { print out; exit 0 }
      out = out c
    }
    exit 1
  }'
}
# The program a hook command would actually run, if anu can judge it at all.
#
# An ABSOLUTE path is a fact this process can check: the file is there and
# executable, or the hook is broken however anyone's PATH is set. A BARE NAME
# is not. It is resolved by the shell Codex spawns for the hook, whose PATH is
# not this process's to speak for — and resolving it against OUR PATH is
# exactly the bug this function exists to avoid: a watchd worker with a
# minimal environment would call every perfectly good home broken and park
# every rotation. So a bare name is accepted.
_codex_command_runnable() {  # $1 = the whole command string
  local prog
  prog="$(python3 -c 'import shlex,sys; print(shlex.split(sys.argv[1])[0])' "$1" 2>/dev/null)" || return 1
  case "$prog" in
    /*) [ -x "$prog" ] ;;
    *)  return 0 ;;
  esac
}

# True when anu's hooks are installed AND trusted in this home.
#
# The hash is recomputed from the command string THE FILE CARRIES, never from
# what this process would write today. Those are not the same string: `add`
# resolves `anu account …` when the dispatcher is on PATH and an absolute bin
# path otherwise, so a home installed from an interactive shell and checked by
# a watchd worker with a minimal PATH would disagree — and the check would fail
# on a home Codex is perfectly happy with, parking every automatic rotation on
# a healthy pool. What anu must verify is that the file's own hook is one of
# ours (its command ends in ` hook codex <sub>`), that the recorded
# `trusted_hash` really is that command's hash (so a tampered command, or one
# whose hash was left stale, is caught), and that a command naming an absolute
# program still has one.
_codex_hooks_ok() {  # $1 = account name
  local cfg; cfg="$(_codex_config "$1")"
  [ -f "$cfg" ] || return 1
  local scan; scan="$(_codex_scan "$cfg")"
  case "$scan" in *"UNK	"*) return 1 ;; esac
  local table snake sub timeout rows idx line candidate mine cmd key want got
  while IFS="$(printf '\t')" read -r table snake sub timeout; do
    [ -n "$table" ] || continue
    rows="$(awk -F'\t' -v tbl="$table" '$1 == "EVCMD" && $2 == tbl { print $3 "\t" $4 }' <<EOF
$scan
EOF
)"
    # Our table for this event is the one whose command ends in the sub-verb
    # this event is subscribed with — whatever prefix it was installed under.
    mine=""; cmd=""
    while IFS="$(printf '\t')" read -r idx line; do
      [ -n "$line" ] || continue
      candidate="$(printf '%s\n' "$line" | _codex_line_command)" || continue
      case "$candidate" in *" hook codex $sub") mine="$idx"; cmd="$candidate"; break ;; esac
    done <<EOF
$rows
EOF
    [ -n "$mine" ] && [ -n "$cmd" ] || return 1
    _codex_command_runnable "$cmd" || return 1
    key="$cfg:$snake:$mine:0"
    want="$(_codex_trusted_hash "$snake" "$cmd" "$timeout")" || return 1
    got="$(awk -F'\t' -v k="$key" '$1 == "ST" && $2 == k { print $3; exit }' <<EOF
$scan
EOF
)"
    [ "$got" = "$want" ] || return 1
  done <<EOF
$_CODEX_EVENTS
EOF
  return 0
}

# ------------------------------------------------------------------ pick ----
cmd_pick() {
  local need=any excl="" json=0 fresh=1 provider=claude
  while [ $# -gt 0 ]; do case "$1" in
    --need)     [ $# -ge 2 ] || _die "pick: --need needs a value"; need="$2"; shift 2 ;;
    --exclude)  [ $# -ge 2 ] || _die "pick: --exclude needs a value"; excl="$2"; shift 2 ;;
    --provider) [ $# -ge 2 ] || _die "pick: --provider needs a value"; provider="$2"; shift 2 ;;
    --json)     json=1; shift ;;
    --stale)    fresh=0; shift ;;
    *) _die "pick: unexpected '$1'" ;;
  esac; done
  _provider_check pick "$provider"
  # Fable is a Claude-only window. Asking for it on the codex side is not an
  # approximate request the chooser could round off — there is no such window
  # to rank by — so it is a usage error, exactly as a typo'd need is.
  if [ "$provider" = codex ] && [ "$need" = fable ]; then
    _die "pick: --need fable is Claude-only — a ChatGPT account has no Fable window"
  fi
  [ "$need" = any ] || [ "$need" = fable ] || _die "pick: --need must be any or fable"
  # `provider` goes LAST in the query on purpose: every existing caller and
  # test reads the prefix (need, fresh, exclude) and a dashboard that does not
  # know the parameter yet simply ignores it.
  local q="/api/usage/pick?need=$need&fresh=$fresh"
  [ -n "$excl" ] && q="$q&exclude=$excl"
  q="$q&provider=$(_provider_api "$provider")"
  local out; out="$(_api_pick "$q")" || _die "dashboard unreachable at $USAGE_URL"
  if [ "$json" = 1 ]; then printf '%s\n' "$out"; return 0; fi
  printf '%s' "$out" | jq -r '.picks[] | select(.name != null) | .name'
}

# ------------------------------------------------------- preflight (B → A) --
# Before a rotation leaves the current account for good, confirm locally that
# landing on the next one will actually work: it must resolve a token from
# THIS device (cache or store — the dashboard ranking says nothing about
# whether this launcher can authenticate as it) and must not be an account
# this same pane already bounced off within the last 30 minutes (walking
# straight back onto a still-walled account is pointless). `_pick_next` walks
# the dashboard's own ranked list and returns the first candidate that
# survives both checks.
_tried_opt() {  # the option a provider's tried-list lives in. Namespaced, so a
  # claude account bounced off five minutes ago can never make a codex
  # candidate of the same NAME (the human uses one name per person across both
  # providers) look freshly tried.
  case "${1:-claude}" in codex) printf '@anu_tried_codex' ;; *) printf '@anu_tried' ;; esac
}
_tried_has() {  # $1 = pane, $2 = candidate name, $3 = provider — true if the
  # provider's tried-list holds a "name:epoch" entry for it within 30 minutes.
  local pid="$1" name="$2" tried_str now entry n e
  tried_str="$(_opt "$pid" "$(_tried_opt "${3:-claude}")")"
  [ -n "$tried_str" ] || return 1
  now="$(date +%s)"
  for entry in $tried_str; do
    n="${entry%%:*}"; e="${entry##*:}"
    if [ "$n" = "$name" ] && [[ "$e" =~ ^[0-9]+$ ]] && [ $((now - e)) -lt 1800 ]; then
      return 0
    fi
  done
  return 1
}
_tried_append() {  # $1 = pane, $2 = account name just left, $3 = provider.
  # Appends "name:epoch", bounded to the last 3 entries (oldest dropped first).
  # ONE entry per account: an account already on the list is moved to the end
  # with the new epoch rather than listed twice. A duplicate says nothing the
  # later epoch does not, and in a list bounded at 3 it pushes a DIFFERENT
  # account off early — the 2026-09-23 drill left `account_gamma:… account_gamma:…` behind.
  local pid="$1" name="$2" opt; opt="$(_tried_opt "${3:-claude}")"
  local now tried_str e
  now="$(date +%s)"
  tried_str="$(_opt "$pid" "$opt")"
  local -a old=() entries=()
  [ -n "$tried_str" ] && read -r -a old <<< "$tried_str"
  for e in ${old[@]+"${old[@]}"}; do
    [ "${e%%:*}" = "$name" ] || entries+=("$e")
  done
  entries+=("$name:$now")
  local n="${#entries[@]}"
  if [ "$n" -gt 3 ]; then
    local start=$((n - 3))
    entries=("${entries[@]:$start:3}")
  fi
  tmux set-option -p -t "$pid" "$opt" "${entries[*]}" 2>/dev/null || true
}
_pick_next() {  # $1 = pane, $2 = need, $3 = exclude (current account),
  # $4 = provider (default claude), $5 = the pane's cwd (codex only). Prints
  # the first ranked pick (per the dashboard) that passes local preflight;
  # returns 1 (nothing printed on stdout — cmd_pick's own _die already wrote
  # its message straight to stderr, live, since stderr here is never
  # captured) when the dashboard call itself failed, 2 when every candidate
  # was ranked but none survives preflight, 0 with a name otherwise.
  #
  # What "preflight" means differs by provider, and both answer the same
  # question — can this launcher actually LAND there? For claude that is a
  # token this device can resolve. For codex it is a home with an auth.json,
  # a hook block Codex will actually run, and this directory already trusted
  # in that home: each of those, missing, is a modal or a silent no-op that a
  # rotation meets AFTER the old process is gone and cannot answer.
  local pid="$1" need="$2" excl="$3" provider="${4:-claude}" cwd="${5:-}" names_out rc=0
  names_out="$(cmd_pick --provider "$provider" --need "$need" --exclude "${excl:-none}")" || rc=$?
  if [ "$rc" -ne 0 ]; then return 1; fi
  _first_landable "$pid" "$excl" "$provider" "$cwd" "$names_out"
}
_first_landable() {  # $1 = pane, $2 = the account being left, $3 = provider,
  # $4 = the pane's cwd (codex only), $5 = ranked names, one per line. Prints
  # the first that passes local preflight (see _pick_next); returns 2 when
  # none does. Split out of _pick_next so a codex rotation can keep walking
  # the SAME ranking after a relaunch dies, instead of asking again.
  local pid="$1" excl="$2" provider="${3:-claude}" cwd="${4:-}" name
  while IFS= read -r name; do
    [ -n "$name" ] || continue
    # The account being LEFT is never a destination, whatever the ranking
    # says. The dashboard is asked to exclude it and the real route does, but
    # "where can this pane land" is the device's own answer: a ranking that
    # still lists it (a static one did, in the 2026-09-23 drill) relaunched a
    # walled pane straight back onto the account it was leaving.
    [ "$name" = "$excl" ] && continue
    _tried_has "$pid" "$name" "$provider" && continue
    if [ "$provider" = codex ]; then
      _codex_candidate_ok "$name" "$cwd" || continue
    else
      _token_for "$name" >/dev/null 2>&1 || continue
    fi
    printf '%s\n' "$name"
    return 0
  done <<< "$5"
  return 2
}

# -------------------------------------------------------------------- ls ----
cmd_ls() {
  local provider=claude
  while [ $# -gt 0 ]; do case "$1" in
    --provider) [ $# -ge 2 ] || _die "ls: --provider needs a value"; provider="$2"; shift 2 ;;
    *) _die "ls: unexpected '$1'" ;;
  esac; done
  _provider_check ls "$provider"
  local api; api="$(_provider_api "$provider")"
  local out; out="$(_api "/api/usage")" || _die "dashboard unreachable at $USAGE_URL"
  # The codex table drops the FABLE column rather than printing "-" in it: a
  # ChatGPT account has no Fable-scoped window at all, and a dash reads as
  # "zero used", which is a claim the data never made.
  {
    if [ "$provider" = codex ]; then
      printf 'NAME\tEMAIL\tPLAN\t5H\tWEEK\tRESETS\tSHARED\tSTATE\n'
    else
      printf 'NAME\tEMAIL\tPLAN\t5H\tWEEK\tFABLE\tRESETS\tSHARED\tSTATE\n'
    fi
    printf '%s' "$out" | jq -r --arg p "$api" '
      def pct(k): ([.windows[] | select(.key | startswith(k)) | .usedPercent] | first // "-") | tostring;
      def reset: ([.windows[] | select(.key | startswith("weekly_all")) | .resetsAt] | first // "-") | .[0:16];
      .accounts[] | select(.provider == $p)
      | [ (.name // "-"), (.email // "-"), (.plan // "-"),
          pct("session"), pct("weekly_all") ]
        + (if $p == "claude" then [pct("weekly_scoped")] else [] end)
        + [ reset, (if .shared then "shared" else "-" end), (.error // "ok") ]
      | @tsv'
  } | column -t -s "$(printf '\t')"
}

# ----------------------------------------------------------------- token ----
cmd_token() {
  local name="" refresh=0
  while [ $# -gt 0 ]; do case "$1" in
    --refresh) refresh=1; shift ;;
    -*) _die "token: unexpected '$1'" ;;
    *) [ -z "$name" ] || _die "token: unexpected '$1'"; name="$1"; shift ;;
  esac; done
  [ -n "$name" ] || _die "usage: com8-account token <name> [--refresh]"
  if [ "$refresh" = 1 ]; then
    local key tok; key="$(_key "$name")"
    tok="$("$SECRETS_BIN" get "$TOKEN_PATH" "$key" --show 2>/dev/null)" \
      || _die "no token for '$name' (com8-account add $name)"
    [ -n "$tok" ] || _die "no token for '$name' (com8-account add $name)"
    _cache_put "$key" "$tok"
    printf '%s\n' "$tok"
    return 0
  fi
  local tok; tok="$(_token_for "$name")" || _die "no token for '$name' (com8-account add $name)"
  printf '%s\n' "$tok"
}

# ------------------------------------------------------------------- add ----
# Upsert one entry into the serving host's accounts.json — the dashboard's own
# config file (a sibling of tokens.json, not the same file: tokens.json is the
# secret mirror `sync` ships, accounts.json is what `loadAccounts()` reads to
# know the entry exists at all). Runs entirely through jq on the host: the
# entry and its default label travel together as ONE JSON payload on stdin,
# so a label with quotes or an em dash never has to survive a shell string.
# The merge preserves a hand-edited label (and any field this script doesn't
# know about) unless --label was passed — see the filter below.
_register_host() {  # $1 = entry (compact JSON; label/shared omitted unless
  # --label/--shared were passed), $2 = default label (used only when the id
  # is new). Returns 1 (never exits) on failure — the token is already
  # stored+synced by the time this runs, so the caller explains THAT instead
  # of dying with a bare "failed".
  local entry="$1" default_label="$2" dev="$SYNC_DEVICE"
  [ -n "$dev" ] && { [ -n "$USAGE_REPO" ] || { { [ "$dev" = local ] || [ "$dev" = self ]; } && [ -n "${USAGE_ACCOUNTS_FILE:-}" ]; }; } || { echo "com8-account: registration needs COM8_USAGE_HOST and COM8_USAGE_REPO" >&2; return 1; }
  local payload; payload="$(jq -nc --argjson entry "$entry" --arg default_label "$default_label" \
    '{entry:$entry, default_label:$default_label}')"
  # shellcheck disable=SC2016 -- this is a jq program: every $name below is
  # jq's own variable, resolved by jq itself, never by this shell. Shared
  # defaults to false the same way label defaults to $default_label: `//`
  # only fills in when the merged value is null/false, so an existing
  # shared:true (hand-edited, or from an earlier --shared) survives a re-add
  # that doesn't pass --shared.
  local filter='
    $payload.entry as $entry
    | $payload.default_label as $default_label
    | (.accounts // []) as $accts
    | ($accts | map(.id) | index($entry.id)) as $i
    | (if $i == null then {} else $accts[$i] end) as $existing
    | ($existing * $entry) as $merged
    # One entry carries BOTH credentials on purpose: configDir is the poll
    # grant (npm run add-claude on the serving host, so the dashboard can
    # read usage limits) and token is the launch setup-token (anu account
    # add) — a setup-token alone is unable to read limits (403
    # oauth_scope_insufficient). A re-add with a token must not drop a
    # configDir already on the entry (task 15b; task 14a/bug 2 had this
    # backwards).
    | ($merged + {label: ($merged.label // $default_label), shared: ($merged.shared // false)}) as $final
    | .accounts = (if $i == null then $accts + [$final] else ($accts | .[$i] = $final) end)
  '
  if [ "$dev" = local ] || [ "$dev" = self ]; then
    local f="${USAGE_ACCOUNTS_FILE:-${USAGE_REPO/#\~/$HOME}/accounts.json}"
    mkdir -p "$(dirname "$f")"
    if [ -f "$f" ] && ! jq -e . "$f" >/dev/null 2>&1; then
      printf 'anu account: %s is not valid JSON — refusing to write\n' "$f" >&2
      return 1
    fi
    local cur; cur="$( [ -f "$f" ] && cat "$f" || echo '{"accounts":[]}' )"
    printf '%s' "$cur" | jq --argjson payload "$payload" "$filter" > "$f.tmp" && mv -f "$f.tmp" "$f" \
      || { rm -f "$f.tmp"; return 1; }
  else
    # The remote script below is built with $USAGE_REPO spliced in UNQUOTED
    # at the `f=` assignment (the same way `cmd_sync` builds its own remote
    # tokens-file path), so a literal leading ~ in its default value
    # tilde-expands on the REMOTE host's own $HOME, not this one. Every
    # other `$name` is backslash-escaped so it reaches the remote shell
    # literally, to be resolved there.
    local remote
    remote="set -e
f=$USAGE_REPO/accounts.json
mkdir -p \"\$(dirname \"\$f\")\"
if [ -f \"\$f\" ] && ! jq -e . \"\$f\" >/dev/null 2>&1; then
  echo \"anu account: \$f is not valid JSON — refusing to write\" >&2
  exit 1
fi
cur=\$( [ -f \"\$f\" ] && cat \"\$f\" || echo '{\"accounts\":[]}' )
payload=\$(cat)
printf '%s' \"\$cur\" | jq --argjson payload \"\$payload\" '$filter' > \"\$f.tmp\" && mv -f \"\$f.tmp\" \"\$f\""
    printf '%s' "$payload" | ssh "$dev" "$remote" || return 1
  fi
}

cmd_add_codex() {  # $1 = account name. A device-local act, start to finish.
  local name="$1" home cfg
  _codex_home_name_ok "$name" || _die "add: '$name' cannot name a codex account (it would collide with the shared store, a backup, or a path)"
  home="$(_codex_home "$name")"; cfg="$(_codex_config "$name")"
  _have codex || _die "codex is not on PATH"
  ( umask 077; mkdir -p "$home" ) || _die "could not create $home"
  chmod 700 "$CODEX_ACCOUNT_DIR" "$home" 2>/dev/null || true
  # The home becomes a view of ~/.codex BEFORE the login, so the CLI never gets
  # the chance to start a real sessions/, history.jsonl or database in it —
  # state no other account, and no plain `codex`, would ever see (which is the
  # same thing as "no rotation can ever resume it"). A re-add is also how a
  # home made before this rule is folded in, without waiting for a launch.
  _codex_share_all "$name" \
    || _die "$home is not yet a view of $(_tilde "$CODEX_USER_DIR") (see above) — nothing else was done; \`com8-account doctor --provider codex\` shows what is left"
  printf 'Logging in as %s. Finish the device authorization in the browser it opens.\n' "$name" >&2
  CODEX_HOME="$home" codex login --device-auth || _die "codex login failed for '$name' — nothing written"
  # auth.json is tested for EXISTENCE and never opened: anu points the CLI at
  # the home and never holds the credential itself.
  _codex_authed "$name" || _die "codex login left no auth.json in $home — nothing written"
  _codex_render_config "$name" || _die "could not render the Codex configuration into $cfg"
  printf 'codex account %s is ready on this device (%s).\n' "$name" "$home"
  printf 'its home is a view of %s: conversations, history and memories are shared with every account and with plain codex; only auth.json and config.toml are its own.\n' "$(_tilde "$CODEX_USER_DIR")"
  printf 'note: a Codex login is PER DEVICE — nothing about it is synced to Infisical or registered on the dashboard. Run `com8-account add --provider codex %s` again on every machine that should launch panes as %s.\n' "$name" "$name"
}

cmd_add() {
  local name="" label="" label_given=0 shared_given=0 email="" register=1 provider=claude
  while [ $# -gt 0 ]; do case "$1" in
    --label)       [ $# -ge 2 ] || _die "add: --label needs a value"; label="$2"; label_given=1; shift 2 ;;
    --provider)    [ $# -ge 2 ] || _die "add: --provider needs a value"; provider="$2"; shift 2 ;;
    --shared)      shared_given=1; shift ;;
    --email)       [ $# -ge 2 ] || _die "add: --email needs a value"; email="$2"; shift 2 ;;
    --no-register) register=0; shift ;;
    -*) _die "add: unexpected '$1'" ;;
    *) [ -z "$name" ] || _die "add: unexpected '$1'"; name="$1"; shift ;;
  esac; done
  _provider_check add "$provider"
  [ -n "$name" ] || _die "usage: com8-account add [--provider claude|codex] <name> [--label <text>] [--shared] [--email <addr>] [--no-register]"
  if [ "$provider" = codex ]; then cmd_add_codex "$name"; return $?; fi
  local key; key="$(_key "$name")"
  local display_label="${label:-Claude — $name}"

  printf 'In a browser logged in as the %s account, run `claude setup-token` and paste the token.\n' "$name" >&2
  local tok; read -rsp "token for $name: " tok; echo >&2
  [ -n "$tok" ] || _die "empty token"
  "$SECRETS_BIN" mkdir "$TOKEN_PATH" >/dev/null || _die "could not create $TOKEN_PATH in Infisical"
  printf '%s\n' "$tok" | "$SECRETS_BIN" set "$TOKEN_PATH" "$key" >/dev/null || _die "could not store the token"
  cmd_sync
  # cmd_sync just rebuilt the cache from a full Infisical export, which on a
  # real server already contains the token just stored above — but warm it
  # explicitly too, since we have the value in hand right here and this is
  # the minting device: it should never wait on that round-trip.
  _cache_put "$key" "$tok"

  # id/provider/name/token always travel; label and shared travel ONLY when
  # explicitly given (--label / --shared) — same reason for both: so a
  # re-add that doesn't pass the flag can't clobber a hand-edited label or
  # an already-true shared on the host (the host-side merge fills in the
  # $default_label / false fallback only when nothing survives from either
  # side — see _register_host).
  local entry
  entry="$(jq -nc --arg id "claude-$name" --arg name "$name" --arg key "$key" \
    '{id:$id, provider:"claude", name:$name, token:{key:$key}}')"
  [ "$shared_given" = 1 ] && entry="$(printf '%s' "$entry" | jq -c '. + {shared:true}')"
  [ "$label_given" = 1 ] && entry="$(printf '%s' "$entry" | jq -c --arg label "$label" '. + {label:$label}')"
  [ -n "$email" ] && entry="$(printf '%s' "$entry" | jq -c --arg email "$email" '. + {email:$email}')"

  if [ "$register" = 1 ]; then
    if _register_host "$entry" "$display_label"; then
      printf 'registered claude-%s on %s\n' "$name" "$SYNC_DEVICE"
      printf 'limits: this token cannot read usage; on the serving host run  npm run add-claude -- %s  once so the dashboard can poll %s\n' "$name" "$name"
    else
      # The token IS already stored and synced by this point — say so, so
      # the human doesn't think the whole `add` was a no-op, and give a
      # concrete way forward: retry once the host is fixed, or paste the
      # entry in by hand.
      local printed
      printed="$(printf '%s' "$entry" | jq -c --arg label "$display_label" \
        'if has("label") then . else . + {label:$label} end
         | if has("shared") then . else . + {shared:false} end')"
      {
        printf 'anu account: claude-%s is stored and synced, but registering it on %s failed.\n' "$name" "$SYNC_DEVICE"
        printf 'Fix the host, then re-run `com8-account add %s` (safe — storing the token again is harmless), or paste this entry into %s/accounts.json by hand:\n\n' "$name" "$USAGE_REPO"
        printf '%s\n' "$printed" | jq .
      } >&2
      exit 1
    fi
  else
    local printed
    printed="$(printf '%s' "$entry" | jq -c --arg label "$display_label" \
      'if has("label") then . else . + {label:$label} end
       | if has("shared") then . else . + {shared:false} end')"
    printf 'stored %s/%s and synced. Add this to accounts.json on the serving host:\n\n' "$TOKEN_PATH" "$key"
    printf '%s\n' "$printed" | jq .
  fi
}

# ------------------------------------------------------------------ sync ----
cmd_sync() {
  local dev="${1:-$SYNC_DEVICE}"
  local json; json="$("$SECRETS_BIN" env --scope "$TOKEN_PATH" --format json)" || _die "could not read $TOKEN_PATH"
  # infisical's json export is either {KEY: value} or [{key, value}]; normalise.
  json="$(printf '%s' "$json" | jq -c 'if type == "array" then map({(.key): .value}) | add // {} else . end')"
  # Always warm the local device cache first — before any device write, so a
  # failed/slow device write still leaves this device cache-warm. `sync
  # cache` (and `sync local`/`self`, an explicit name for this SAME device)
  # stop right here: they warm only the local cache, no device touched at
  # all — ACCOUNT_CACHE's default path already IS this device's own
  # launcher cache, so there is nothing left for `local`/`self` to do beyond
  # the write above. _cache_write itself is silent on success (a failure
  # still reports on stderr) and is best-effort — it never aborts this sync
  # even if the local write fails. `sync` is the one caller that narrates a
  # successful write.
  _cache_write "$json"
  [ "$_cache_write_ok" = 1 ] && printf 'cached %s\n' "$ACCOUNT_CACHE" >&2
  # No hosted account service is a valid installation. With no configured
  # sync host, keep this operation local instead of invoking ssh with "".
  case "$dev" in ''|cache|local|self) return 0 ;; esac
  # A named device gets ITS OWN launcher cache warmed over ssh — the same
  # shape and path `_cache_write` uses on this device
  # (${XDG_STATE_HOME:-~/.local/state}/com8/accounts/tokens.json), resolved
  # on the REMOTE host so ITS $XDG_STATE_HOME/$HOME apply, not this one; dir
  # 0700, file 0600 (umask 077 covers both), atomic tmp+mv. The dashboard no
  # longer reads a tokens mirror at all — this exists only so a device that
  # itself runs launcher panes (e.g. `anu account add` warming the serving
  # host) never waits on the network once synced.
  local remote='umask 077; mkdir -p "${XDG_STATE_HOME:-$HOME/.local/state}/com8/accounts" && cat > "${XDG_STATE_HOME:-$HOME/.local/state}/com8/accounts/tokens.json.tmp" && mv -f "${XDG_STATE_HOME:-$HOME/.local/state}/com8/accounts/tokens.json.tmp" "${XDG_STATE_HOME:-$HOME/.local/state}/com8/accounts/tokens.json"'
  printf '%s\n' "$json" | ssh "$dev" "$remote" || _die "sync to $dev failed"
  printf 'warmed the launcher cache on %s\n' "$dev" >&2
}

# ---------------------------------------------------------------- status ----
cmd_status() {
  if [ -n "${TMUX:-}" ]; then
    printf 'PANE\tACCOUNT\tNEED\tSESSION\n'
    tmux list-panes -a -F '#{pane_id}	#{@anu_account}	#{@anu_need}	#{@anu_session}' 2>/dev/null \
      | awk -F'\t' '$4 != ""' || true
    echo
  fi
  printf 'next for any:   %s\n' "$(cmd_pick --need any --stale | head -1)"
  printf 'next for fable: %s\n' "$(cmd_pick --need fable --stale | head -1)"
}

# ---------------------------------------------------------------- launch ----
# The only way a Claude Code process gets an account: resolve it, export the
# token, mint a session id (unless resuming), stamp the pane, exec claude.
_resume_id() {  # is there already an id in the args, or an explicit refusal to mint
  # one? --resume/-r/--session-id: the id after is optional (bare --resume opens
  # claude's own session picker) — only treat the next token as an id when one is
  # actually there AND it doesn't itself look like another flag. --continue/-c:
  # never followed by an id — caller wants claude's own last-session resume, so
  # stamp no session at all (an honest "" — rotate then refuses honestly).
  while [ $# -gt 0 ]; do case "$1" in
    --resume|-r|--session-id)
      if [ $# -ge 2 ] && [[ "$2" != -* ]]; then printf '%s' "$2"; fi
      return 0
      ;;
    --continue|-c)
      return 0
      ;;
  esac; shift; done
  return 1
}
_args_for_resume() {  # the launch args, reduced to a WHITELIST of claude flags worth
  # replaying on resume. A generic "flag then non-flag token is that flag's
  # value" heuristic can't tell a boolean flag's own trailing prompt positional
  # apart from a valued flag's actual value (`cxx "prompt"` — the single most
  # common alias shape — would keep the prompt as if it belonged to
  # --dangerously-skip-permissions), so stop guessing: only the flags below
  # survive, everything else (unknown flags, their values, and every bare
  # positional — the prompt, already in the transcript once resumed) is
  # dropped. shell-quoted (%q) so a value with spaces/quotes reparses exactly
  # when rotate types the stored string back into the shell.
  local -a keep=()
  while [ $# -gt 0 ]; do case "$1" in
    # --resume/-r/--session-id/--continue/-c and their values (if any) are
    # dropped — rotate supplies its own --resume. A bare --resume/--session-id
    # (no id following — e.g. the ordinary `claude --resume` session picker,
    # or the next token is itself another flag) has nothing to pair off;
    # `shift 2` there would fail without consuming $1, spinning forever. Only
    # consume a second token when one exists and doesn't look like a flag.
    --resume|-r|--session-id)
      if [ $# -ge 2 ] && [[ "$2" != -* ]]; then shift 2; else shift; fi
      ;;
    --continue|-c) shift ;;
    --dangerously-skip-permissions|--allow-dangerously-skip-permissions|--verbose)
      keep+=("$1"); shift ;;
    --permission-mode|--model|--effort|--add-dir|--mcp-config|--settings|--agent|--append-system-prompt|--system-prompt|--autocompact)
      if [ $# -ge 2 ]; then keep+=("$1" "$2"); shift 2; else keep+=("$1"); shift; fi
      ;;
    -*)
      # an unrecognized flag — drop it, and its value too if the next token
      # looks like one (not itself a flag), so the value can't get replayed
      # as a stray positional on the retyped line.
      if [ $# -ge 2 ] && [[ "$2" != -* ]]; then shift 2; else shift; fi
      ;;
    *) shift ;;   # a bare positional (the prompt) — drop it
  esac; done
  [ "${#keep[@]}" -gt 0 ] && printf '%q ' "${keep[@]}"
  return 0
}
_codex_resume_id() {  # the id in `codex resume <id>`, or nothing. `resume` is a
  # SUB-COMMAND, not a flag, so it is only the resume form when it is the first
  # bare word — `--model resume` is a value, not a verb.
  local first=1
  while [ $# -gt 0 ]; do
    case "$1" in
      -*) first=0 ;;
      resume)
        if [ "$first" = 1 ] && [ $# -ge 2 ] && [[ "$2" != -* ]]; then printf '%s' "$2"; fi
        return 0 ;;
      *) first=0 ;;
    esac
    shift
  done
  return 1
}
_codex_args_for_resume() {  # the launch args, reduced to the WHITELIST of codex
  # flags worth replaying on a resume: the ones that decide which model, how
  # much autonomy, and where. Everything else — `resume <id>`, the
  # continuation, the prompt, an unknown flag and its value — is dropped, for
  # exactly the reason the claude side stops guessing: a boolean flag's own
  # trailing prompt positional is indistinguishable from a valued flag's real
  # value, and replaying a prompt re-submits work the rollout already holds.
  local -a keep=()
  local first=1
  while [ $# -gt 0 ]; do case "$1" in
    resume)
      if [ "$first" = 1 ] && [ $# -ge 2 ] && [[ "$2" != -* ]]; then shift 2; else shift; fi
      first=0 ;;
    --full-auto|--yolo|--dangerously-bypass-approvals-and-sandbox)
      keep+=("$1"); shift; first=0 ;;
    --model|-m|--sandbox|-s|--ask-for-approval|-a|--cd|-C|--profile|-p)
      if [ $# -ge 2 ]; then keep+=("$1" "$2"); shift 2; else keep+=("$1"); shift; fi
      first=0 ;;
    -*)
      if [ $# -ge 2 ] && [[ "$2" != -* ]]; then shift 2; else shift; fi
      first=0 ;;
    *) shift; first=0 ;;
  esac; done
  [ "${#keep[@]}" -gt 0 ] && printf '%q ' "${keep[@]}"
  return 0
}
_launch_nonce() {  # one launch's identity, for the hooks it starts. Not a
  # secret and never used as one: it only answers "did this hook come from the
  # launch that is running right now, or from the one before it".
  local n=""
  _have uuidgen && n="$(uuidgen 2>/dev/null | tr -d '\n' | tr '[:upper:]' '[:lower:]')"
  [ -n "$n" ] || n="$(_epoch_ms)-$$-$RANDOM"
  printf '%s' "$n"
}
# Has THIS pane recorded <name> as walled in the last 30 minutes? The only
# per-account wall evidence anu keeps is pane-scoped: the rotation's
# @anu_tried_codex list ("name:epoch", appended when a pane leaves an account)
# and the pane's own @anu_wall_pending ("epoch:turn") against its stamped
# @anu_account. There is no device-wide record, so a launch outside a pane —
# or in a different one — cannot know, and does not pretend to.
_codex_offline_walled() {  # $1 = name
  [ -n "${TMUX_PANE:-}" ] || return 1
  _tried_has "$TMUX_PANE" "$1" codex && return 0
  local pend e now
  [ "$(_opt "$TMUX_PANE" @anu_provider)" = codex ] || return 1
  [ "$(_opt "$TMUX_PANE" @anu_account)" = "$1" ] || return 1
  pend="$(_opt "$TMUX_PANE" @anu_wall_pending)"; e="${pend%%:*}"; now="$(date +%s)"
  [[ "$e" =~ ^[0-9]+$ ]] && [ $((now - e)) -lt 1800 ]
}
# The account an offline codex launch lands on (see the header). Returns 1
# with nothing printed when this device has no codex home at all — the one
# case plain `codex` is the better answer — and 2 when homes exist but none
# survives the preflight (each skip already said why, on stderr).
_codex_offline_account() {  # $1 = need, $2 = cwd to trust
  local need="$1" cwd="$2" here name checked=" "
  here="$(_codex_local_accounts)"
  [ -n "$here" ] || return 1
  name="$(_last_pick_read "codex:$need")" || name=""
  if [ -n "$name" ]; then
    checked="$checked$name "
    if _codex_candidate_ok "$name" "$cwd"; then printf '%s' "$name"; return 0; fi
  fi
  name="$(_last_launch_read codex)" || name=""
  case "$checked" in *" $name "*) name="" ;; esac   # (1) already judged it
  if [ -n "$name" ] && ! _codex_offline_walled "$name"; then
    checked="$checked$name "
    if _codex_candidate_ok "$name" "$cwd"; then printf '%s' "$name"; return 0; fi
  fi
  # First by name among the homes that pass — one this pane saw walled only
  # if nothing else does.
  local ok="" walled=""
  while IFS= read -r name; do
    [ -n "$name" ] || continue
    case "$checked" in *" $name "*) continue ;; esac
    _codex_candidate_ok "$name" "$cwd" || continue
    if _codex_offline_walled "$name"; then [ -n "$walled" ] || walled="$name"
    else ok="$name"; break; fi
  done <<EOF
$(printf '%s\n' "$here" | LC_ALL=C sort)
EOF
  [ -n "$ok" ] || ok="$walled"
  [ -n "$ok" ] || return 2
  printf '%s' "$ok"
}
cmd_launch_codex() {  # $1 = --as, $2 = need, $3 = --cd, $4 = --keep-wall (0/1),
  # then -- <codex args>
  local as="$1" need="$2" cd_to="$3" keep_wall="${4:-0}"; shift 4
  if [ -n "${TMUX_PANE:-}" ]; then export ANU_PANE="$TMUX_PANE"; fi
  local account="$as" inherited=""
  if [ -z "$account" ]; then inherited="$(_inherited_account codex)" || inherited=""; account="$inherited"; fi
  local from_pick=0
  if [ -z "$account" ]; then
    from_pick=1
    local pick_rc=0 ranked
    ranked="$(cmd_pick --provider codex --need "$need")" || pick_rc=$?
    if [ "$pick_rc" -ne 0 ]; then
      # No room check is possible, but a home logged in here is still a
      # better pane than none (the header's order). Not a pick: nothing is
      # written to last-pick, so its 10-minute clock is never refreshed by a
      # launch the dashboard never saw.
      from_pick=0
      local off_rc=0
      account="$(_codex_offline_account "$need" "${cd_to:-$PWD}")" || off_rc=$?
      case "$off_rc" in
        0) printf 'anu account: dashboard unreachable — launching as %s without a room check\n' "$account" >&2 ;;
        2) _die_code 1 "dashboard unreachable and no codex home logged in here passes the preflight (reasons above) — fix one, or pass --as <name>" ;;
        *) _die_code 1 "dashboard unreachable — pass --as <name> to launch a codex pane anyway" ;;
      esac
    fi
  fi
  if [ -z "$account" ]; then
    # There is no keychain to fall back to: a Codex account IS a directory on
    # this device, and "whatever ~/.codex happens to be logged in as" is not
    # an account this tool chose. Nothing has room stays an honest exit 3.
    [ -n "$ranked" ] || _die_code 3 "no codex account has room for $need"
    # The dashboard ranks a POOL. Only this device knows which of those
    # accounts it can actually authenticate as — a Codex login does not travel
    # — so the pick is INTERSECTED with the homes logged in here, exactly as
    # `_pick_next` has always done for a rotation. Taking the top pick blind is
    # the bug that made `cdxx` refuse outright on a laptop with two perfectly
    # good codex accounts, because the account ranked first happened to be
    # logged in somewhere else.
    #
    # The preflight is the rotation's, whole: a home with an auth.json, hook
    # tables Codex will actually run, and this directory trusted in that home.
    # A launch that skipped the last two would meet the modal or the silent
    # no-op that the rotation exists to avoid, just later.
    local trust_cwd="${cd_to:-$PWD}" name
    while IFS= read -r name; do
      [ -n "$name" ] || continue
      if _codex_candidate_ok "$name" "$trust_cwd"; then account="$name"; break; fi
    done <<EOF
$ranked
EOF
    if [ -z "$account" ]; then
      local listed here first hint=""
      listed="$(printf '%s\n' "$ranked" | awk 'NF { n = n ? n ", " $0 : $0 } END { print n }')"
      # Read the first local account WITHOUT a pipeline: `… | head -1` closes
      # the pipe early, and under `set -o pipefail` that SIGPIPE becomes the
      # whole command's status, which `set -e` would then act on — killing the
      # script one line before the message it exists to print.
      here="$(_codex_local_accounts)"
      first="${here%%$'\n'*}"
      [ -n "$first" ] && hint=", or launch with --as $first (already logged in here)"
      _die_code 1 "the best codex accounts are $listed — none is logged in on this device; run \`com8-account add --provider codex <name>\` for one of them$hint"
    fi
  fi
  _codex_authed "$account" \
    || _die_code 1 "no codex home for '$account' on this device (com8-account add --provider codex $account)"
  # EVERY launch keeps the home a view of ~/.codex before Codex reads a byte of
  # it: a link some writer replaced, an entry ~/.codex grew since the last
  # launch, a home from before the rule — each is folded back here, and says
  # so. On a home that is already a view it is builtin tests and nothing else.
  # Like the render below it never costs the pane: a home that could not be
  # repaired still launches, and the doctor names what is left.
  _codex_share_all "$account" \
    || printf 'anu account: launching %s with its home not fully a view of %s (com8-account doctor --provider codex)\n' \
         "$account" "$(_tilde "$CODEX_USER_DIR")" >&2
  # EVERY launch re-renders the home from the human's own ~/.codex/config.toml,
  # which is what makes an edit they make there live in the next pane rather
  # than at the next `add`. It is two awk passes over two small files, and a
  # render that cannot happen is never a reason to refuse a launch: the home
  # already holds a config.toml Codex can read, and a pane the human asked for
  # is worth more than a configuration refresh.
  _codex_render_config "$account" \
    || printf 'anu account: launching %s with the config.toml already in its home\n' "$account" >&2
  local home; home="$(_codex_home "$account")"
  local nonce; nonce="$(_launch_nonce)"
  local sid=""; sid="$(_codex_resume_id "$@")" || true
  if [ -n "${TMUX_PANE:-}" ]; then
    # Everything the PREVIOUS launch left behind goes first, in one place:
    # a stale session id, its transcript and byte cursor, and — the one that
    # matters most — a wall that was pending against a conversation this
    # process is not continuing. A launch is the ONLY thing that clears
    # @anu_wall_pending; no screen read ever does.
    tmux set-option -pu -t "$TMUX_PANE" @anu_session 2>/dev/null || true
    tmux set-option -pu -t "$TMUX_PANE" @anu_transcript 2>/dev/null || true
    tmux set-option -pu -t "$TMUX_PANE" @anu_rollout_offset 2>/dev/null || true
    tmux set-option -pu -t "$TMUX_PANE" @anu_rollout_inode 2>/dev/null || true
    # …except under --keep-wall, which only a rotate/switch relaunch types.
    # There the wall stays pending until the relaunch is confirmed ALIVE —
    # the relaunch clears it itself at that point — because a launch that
    # then dies (a login chatgpt.com rejects exits in ~2 s) would otherwise
    # have erased the only evidence the session is still walled, and nothing
    # would ever try again (the 2026-09-23 drill parked a session exactly so).
    [ "$keep_wall" = 1 ] || tmux set-option -pu -t "$TMUX_PANE" @anu_wall_pending 2>/dev/null || true
    tmux set-option -pu -t "$TMUX_PANE" @anu_turn 2>/dev/null || true
    tmux set-option -pu -t "$TMUX_PANE" @anu_prompted 2>/dev/null || true
    tmux set-option -p -t "$TMUX_PANE" @anu_provider codex
    tmux set-option -p -t "$TMUX_PANE" @anu_account "$account"
    tmux set-option -p -t "$TMUX_PANE" @anu_need "$need"
    tmux set-option -p -t "$TMUX_PANE" @anu_launch "$(_codex_args_for_resume "$@")"
    tmux set-option -p -t "$TMUX_PANE" @anu_launch_nonce "$nonce"
    tmux set-option -p -t "$TMUX_PANE" @anu_box 0
    tmux set-option -p -t "$TMUX_PANE" @anu_generation "$(_epoch_ms)"
    # An explicitly resumed conversation is the pane's EXPECTED identity from
    # the moment the line runs; the SessionStart hook confirms it later. With
    # no resume there is no id at all, and that is a state — never a licence
    # to guess the newest rollout in the shared store.
    [ -n "$sid" ] && tmux set-option -p -t "$TMUX_PANE" @anu_session "$sid"
  fi
  # Only a pick this launch actually made is worth remembering as "last known
  # good". An explicit --as is the human's, and an inherited account is the
  # pane's — neither is this launch's answer to the chooser.
  [ "$from_pick" = 1 ] && _last_pick_write "codex:$need" "$account"
  # The credential is a DIRECTORY: this process never reads auth.json, and no
  # secret is exported here at all. What IS scrubbed is anything that would
  # make the CLI answer as somebody other than the account just chosen — an
  # API key bills an OpenAI account instead of the ChatGPT subscription whose
  # windows the chooser just ranked.
  # ANU_PROVIDER travels with ANU_ACCOUNT, always: it is what lets the next
  # launch started from inside this pane tell whose account name it inherited.
  export CODEX_HOME="$home" ANU_ACCOUNT="$account" ANU_PROVIDER=codex ANU_LAUNCH_NONCE="$nonce"
  unset OPENAI_API_KEY OPENAI_BASE_URL CLAUDE_CODE_OAUTH_TOKEN
  if [ -n "$cd_to" ]; then
    cd "$cd_to" || _die "cannot cd to $cd_to"
  fi
  # Every codex launch that gets this far — fresh, --as, inherited, offline,
  # or a rotation's relaunch — is this device's newest answer to "which home
  # did I last run as", the offline fallback's second choice.
  _last_launch_write codex "$account"
  exec codex "$@"
}
cmd_launch() {
  local as="" need=auto box=0 seen_sep=0 fallback_keychain=0 provider=claude cd_to="" keep_wall=0
  while [ $# -gt 0 ]; do case "$1" in
    --as)   [ $# -ge 2 ] || _die "launch: --as needs a name"; as="$2"; shift 2 ;;
    --need) [ $# -ge 2 ] || _die "launch: --need needs a value"; need="$2"; shift 2 ;;
    --provider) [ $# -ge 2 ] || _die "launch: --provider needs a value"; provider="$2"; shift 2 ;;
    --cd)   [ $# -ge 2 ] || _die "launch: --cd needs a directory"; cd_to="$2"; shift 2 ;;
    --keep-wall) keep_wall=1; shift ;;
    --box)  box=1; shift ;;
    --fallback-keychain) fallback_keychain=1; shift ;;
    --)     seen_sep=1; shift; break ;;
    *) _die "launch: unexpected '$1' (claude args go after --)" ;;
  esac; done
  _provider_check launch "$provider"
  [ "$seen_sep" = 1 ] || _die "launch: claude args go after --"
  if [ "$provider" = codex ]; then
    [ "$need" = auto ] && need=any
    [ "$need" = any ] || _die "launch: --need must be any on the codex path (a ChatGPT account has no Fable window)"
    # A boxed codex pane is out of scope on purpose: no hook can run inside a
    # box, so its wall would leave no evidence anywhere anu can read it.
    [ "$box" = 1 ] && _die "launch: --box is not supported with --provider codex — no hook runs inside a box, so a Codex wall there is invisible"
    cmd_launch_codex "$as" "$need" "$cd_to" "$keep_wall" "$@"
    exit $?
  fi
  if [ "$box" = 1 ]; then
    [ -n "${ANU_ACCOUNT_BOX_BIN:-}" ] && [ -x "$ANU_ACCOUNT_BOX_BIN" ] || _die "contained accounts need an executable ANU_ACCOUNT_BOX_BIN; no host fallback"
  fi
  [ -z "$cd_to" ] || _die "launch: --cd is codex-only"
  [ "$keep_wall" = 0 ] || _die "launch: --keep-wall is codex-only"
  [ "$need" = auto ] && need="$(_need_from_settings "$@")"
  [ "$need" = any ] || [ "$need" = fable ] || _die "launch: --need must be auto, any or fable"

  # $TMUX_PANE is ordinarily inherited by the SessionStart hook's own process
  # (verified empirically: a hook run via `claude --init-only` under a plain
  # project-level hook saw both $TMUX_PANE and $TMUX) — this export is belt
  # and braces for anywhere that inheritance doesn't hold (a box container,
  # most likely), so the hook always has a pane to stamp.
  if [ -n "${TMUX_PANE:-}" ]; then export ANU_PANE="$TMUX_PANE"; fi

  # Three distinct outcomes when no account was named explicitly (--as / the
  # inherited $ANU_ACCOUNT): the dashboard answered but nothing has room
  # ("pool exhausted" — a real fact, never silently swallowed into the
  # keychain unless the caller opted in with --fallback-keychain), the
  # dashboard itself could not be reached (falls back to this launcher's own
  # recent successful pick, honored under 10 minutes old, before ever
  # touching the keychain — and if even THAT pick's token can't be resolved
  # locally any more, falls the rest of the way to the keychain too, with a
  # warning), or a name WAS given and simply has no token locally (handled
  # below, same as always — exit 1).
  local account="$as"
  if [ -z "$account" ]; then account="$(_inherited_account claude)" || account=""; fi
  local outcome=""            # "" | pool-exhausted | dashboard-down
  local fresh_pick_need=""    # set only when `account` came from a REAL
    # dashboard pick just now (not --as/$ANU_ACCOUNT, not the last-pick
    # cache) — the last-pick record is written from this, but only once the
    # token below has actually resolved, never merely on the pick itself.
  local from_last_pick=0
  local dashboard_msg=""      # pre-composed message for the empty-account
    # dashboard-down report below, chosen here so it's never double-printed.
  if [ -z "$account" ]; then
    local pick_rc=0 pick_out
    # stdout only — cmd_pick's own _die already writes straight to stderr,
    # live, so it is never captured (and never re-printed) here.
    pick_out="$(cmd_pick --need "$need")" || pick_rc=$?
    if [ "$pick_rc" -ne 0 ]; then
      outcome=dashboard-down
    else
      account="$(printf '%s\n' "$pick_out" | head -1)"
      if [ -z "$account" ]; then
        outcome=pool-exhausted
      else
        fresh_pick_need="$need"
      fi
    fi
  fi

  if [ "$outcome" = pool-exhausted ] && [ "$fallback_keychain" != 1 ]; then
    _die_code 3 "no account has room for $need"
  fi
  if [ "$outcome" = dashboard-down ]; then
    local cached; cached="$(_last_pick_read "$need")" || true
    if [ -n "$cached" ] && _token_for "$cached" >/dev/null 2>&1; then
      account="$cached"
      from_last_pick=1
    elif [ -n "$cached" ]; then
      dashboard_msg="anu account: dashboard unreachable and the last pick ($cached) has no local token — using the keychain login"
    else
      dashboard_msg="anu account: dashboard unreachable and no recent pick cached — using the keychain login"
    fi
  fi

  local -a cmd=(claude)
  if [ "$box" = 1 ]; then cmd=("${ANU_ACCOUNT_BOX_BIN:-box}" claude); fi

  if [ -z "$account" ]; then
    case "$outcome" in
      pool-exhausted) printf 'anu account: no account has room for %s — using the keychain login (--fallback-keychain)\n' "$need" >&2 ;;
      dashboard-down) printf '%s\n' "$dashboard_msg" >&2 ;;
      *)               printf 'anu account: no account picked (dashboard unreachable or nothing has room) — using the keychain login\n' >&2 ;;
    esac
    # Unset every stamp (not just @anu_account) so watchd/`rotate` never resume
    # an old transcript under a token after this pane fell back to the keychain.
    if [ -n "${TMUX_PANE:-}" ]; then
      tmux set-option -pu -t "$TMUX_PANE" @anu_account 2>/dev/null || true
      tmux set-option -pu -t "$TMUX_PANE" @anu_session 2>/dev/null || true
      tmux set-option -pu -t "$TMUX_PANE" @anu_launch 2>/dev/null || true
      tmux set-option -pu -t "$TMUX_PANE" @anu_need 2>/dev/null || true
      tmux set-option -pu -t "$TMUX_PANE" @anu_box 2>/dev/null || true
      tmux set-option -pu -t "$TMUX_PANE" @anu_generation 2>/dev/null || true
    fi
    # The keychain path leaves every credential var exactly as the caller's
    # shell had it — no unset here, unlike the token path below. The anu
    # IDENTITY is a different matter: this pane is running as no account at
    # all, so an inherited one must not ride into the child and let a launch
    # started from inside it inherit an identity that was never true here.
    unset ANU_ACCOUNT ANU_PROVIDER
    exec "${cmd[@]}" "$@"
  fi

  local tok; tok="$(_token_for "$account")" || _die "no token for '$account' (com8-account add $account)"
  [ -n "$tok" ] || _die "empty token for '$account'"
  export CLAUDE_CODE_OAUTH_TOKEN="$tok" ANU_ACCOUNT="$account" ANU_PROVIDER=claude
  if [ "$from_last_pick" = 1 ]; then
    printf 'anu account: dashboard unreachable — resuming the last pick (%s)\n' "$account" >&2
  fi
  # Only now — the token has actually resolved — is this pick worth
  # remembering as "last known good" for a future dashboard-down launch.
  [ -n "$fresh_pick_need" ] && _last_pick_write "$fresh_pick_need" "$account"
  # The subscription token IS the credential now — an API key or a
  # cloud-provider flag left over in this shell would otherwise silently
  # outrank it (or Claude Code would refuse to pick between them). Unset for
  # the child only; this process's own env (and the caller's shell) is
  # unaffected.
  unset ANTHROPIC_API_KEY ANTHROPIC_AUTH_TOKEN \
    CLAUDE_CODE_USE_BEDROCK CLAUDE_CODE_USE_VERTEX CLAUDE_CODE_USE_FOUNDRY

  local sid="" extra=()
  if sid="$(_resume_id "$@")"; then
    :
  else
    if _have uuidgen; then
      sid="$(uuidgen | tr '[:upper:]' '[:lower:]')"
    else
      sid="$(python3 -c 'import uuid; print(uuid.uuid4())')"
    fi
    extra=(--session-id "$sid")
  fi
  if [ -n "${TMUX_PANE:-}" ]; then
    tmux set-option -p -t "$TMUX_PANE" @anu_account "$account"
    tmux set-option -p -t "$TMUX_PANE" @anu_need "$need"
    tmux set-option -p -t "$TMUX_PANE" @anu_session "$sid"
    tmux set-option -p -t "$TMUX_PANE" @anu_launch "$(_args_for_resume "$@")"
    tmux set-option -p -t "$TMUX_PANE" @anu_box "$box"
    # A first generation stamp at launch time — the SessionStart hook (if this
    # CLI has one; see `cmd_hook_session_start` below) overwrites it moments
    # later with its own, but a pane must never be without one, since
    # `_relaunch_and_resume`'s pane-changed-under-me guard reads it.
    tmux set-option -p -t "$TMUX_PANE" @anu_generation "$(_epoch_ms)"
  fi
  if [ "$box" = 0 ]; then
    # Per-launch hooks replace the old global Anu configuration dependency.
    # Keep user settings and argv, and keep options ahead of a literal `--`.
    local supplied_settings="" managed_settings before=() after=()
    while [ "$#" -gt 0 ]; do
      case "$1" in
        --settings)
          [ "$#" -ge 2 ] || _die "launch: --settings needs JSON or a file"
          supplied_settings="$2"; shift 2 ;;
        --settings=*) supplied_settings="${1#*=}"; shift ;;
        --) after=("$@"); break ;;
        *) before+=("$1"); shift ;;
      esac
    done
    managed_settings="$(python3 "$COM8_ACCOUNT_RUNTIME/claude-settings.py" "$COM8_ACCOUNT_SELF" "$supplied_settings")" || _die "launch: invalid Claude settings; nothing launched"
    exec "${cmd[@]}" "${extra[@]}" "${before[@]}" --settings "$managed_settings" "${after[@]}"
  fi
  exec "${cmd[@]}" "${extra[@]}" "$@"
}
# ------------------------------------------------------------------ hook ----
# Session identity from Claude Code itself. `launch` mints a session id and
# stamps it, but `/clear`, an interactive `/resume`, a fork, or `--resume
# <name>` can all change the LIVE conversation in a pane out from under that
# stamp — so rotation would resume the wrong transcript. Claude Code's own
# SessionStart hook (per-launch settings, or an existing legacy global hook).
# The original hook was declared for anu by the
# installer) fires on every one of those and hands us the truth on stdin;
# this keeps `@anu_session`/`@anu_generation` honest.
#
# A hook must never block or slow Claude: every path here exits 0, no matter
# what — a missing pane, a missing session id, or unparseable stdin all fall
# through to a silent, successful no-op instead of an error.
#
# Verified empirically against CLI 2.1.272 (`claude --init-only` under a
# throwaway project-level SessionStart hook, from inside this tmux pane):
# $TMUX_PANE and $TMUX ARE inherited by the hook's own process, and it can
# run `tmux set-option` against them directly. The stdin JSON carries
# session_id/hook_event_name/cwd/transcript_path as documented, but this
# CLI's own SessionStart payload ships the reason field as "source", not
# "start_reason" as the hooks reference names it — read both, "source"
# first, so this still works if/when the field is renamed back.
cmd_hook() {
  local sub="${1:-}"
  case "$sub" in
    session-start) shift; cmd_hook_session_start "$@" ;;
    stop-failure)  shift; cmd_hook_stop_failure "$@" ;;
    codex)         shift; cmd_hook_codex "$@" ;;
    *) exit 0 ;;  # unknown or missing sub-verb: still never blocks Claude
  esac
}
# --------------------------------------------------------- codex hooks ----
# Codex announces its own identity and nothing else. It has no `--session-id`,
# so the id a rotation needs for `codex resume <id>` is minted by the CLI and
# reported HERE — this hook is the only place anu can ever learn it. The same
# payload carries `transcript_path`, the rollout file that is the only place a
# usage-limit turn leaves a record at all.
#
# Every codex hook is gated on the LAUNCH NONCE first, before it reads a byte
# of stdin. Codex fires SessionStart lazily — at the first prompt, which may be
# an hour after the launch, or after a rotation has already replaced the
# process — so "a hook fired" is not the same as "the hook belongs to the
# launch running in this pane now". A hook that cannot show the pane's current
# nonce is from a launch that is over, and re-stamping an identity from it
# would point the next rotation at the wrong conversation. Mismatch, or no
# nonce at all (a `codex` the human started by hand), exits 0 having written
# nothing.
_codex_hook_pane() {  # the pane to stamp, once the nonce agrees — or nothing
  local pane="${TMUX_PANE:-${ANU_PANE:-}}"
  [ -n "$pane" ] || return 1
  [ -n "${ANU_LAUNCH_NONCE:-}" ] || return 1
  [ "$(_opt "$pane" @anu_launch_nonce)" = "$ANU_LAUNCH_NONCE" ] || return 1
  printf '%s' "$pane"
}
_file_size() {  # portable byte size; nothing (and 1) when it cannot be read
  local out
  out="$(stat -f %z "$1" 2>/dev/null)"
  [[ "$out" =~ ^[0-9]+$ ]] || out="$(stat -c %s "$1" 2>/dev/null)"
  [[ "$out" =~ ^[0-9]+$ ]] || return 1
  printf '%s' "$out"
}
_file_inode() {
  local out
  out="$(stat -f %i "$1" 2>/dev/null)"
  [[ "$out" =~ ^[0-9]+$ ]] || out="$(stat -c %i "$1" 2>/dev/null)"
  [[ "$out" =~ ^[0-9]+$ ]] || return 1
  printf '%s' "$out"
}
cmd_hook_codex() {
  local sub="${1:-}"
  case "$sub" in
    session-start) shift; cmd_hook_codex_session_start "$@" ;;
    user-prompt)   shift; cmd_hook_codex_user_prompt "$@" ;;
    *) exit 0 ;;
  esac
}
cmd_hook_codex_session_start() {
  local pane; pane="$(_codex_hook_pane)" || exit 0
  local input; input="$(cat 2>/dev/null)" || true
  local sid transcript
  sid="$(printf '%s' "$input" | jq -r '.session_id // empty' 2>/dev/null)" || true
  transcript="$(printf '%s' "$input" | jq -r '.transcript_path // empty' 2>/dev/null)" || true
  [ -n "$sid" ] || exit 0
  tmux set-option -p -t "$pane" @anu_session "$sid" 2>/dev/null || true
  if [ -n "$transcript" ]; then
    tmux set-option -p -t "$pane" @anu_transcript "$transcript" 2>/dev/null || true
    # The cursor starts at the file's CURRENT size on BOTH `startup` and
    # `resume`. A resumed rollout replays the whole conversation — the walled
    # turn's own `task_complete` record included — and reading those bytes as
    # new would rotate a pane for a wall it hit yesterday. Everything already
    # in the file when this session opened is history; only what Codex appends
    # from here is evidence.
    local size inode
    size="$(_file_size "$transcript")" || size=0
    tmux set-option -p -t "$pane" @anu_rollout_offset "$size" 2>/dev/null || true
    if inode="$(_file_inode "$transcript")"; then
      tmux set-option -p -t "$pane" @anu_rollout_inode "$inode" 2>/dev/null || true
    fi
  fi
  exit 0
}
cmd_hook_codex_user_prompt() {
  local pane; pane="$(_codex_hook_pane)" || exit 0
  local input; input="$(cat 2>/dev/null)" || true
  local turn; turn="$(printf '%s' "$input" | jq -r '.turn_id // empty' 2>/dev/null)" || true
  [ -n "$turn" ] || exit 0
  # Which turn is in flight. A `task_complete` record is only this pane's wall
  # when it carries THIS turn id: `codex resume` re-renders a rollout full of
  # older endings, and acting on one of those is the same mistake as reading a
  # replayed transcript.
  tmux set-option -p -t "$pane" @anu_turn "$turn" 2>/dev/null || true
  tmux set-option -p -t "$pane" @anu_prompted 1 2>/dev/null || true
  exit 0
}
cmd_hook_session_start() {
  # This hook is GLOBAL — every Claude Code process runs it, not just ones
  # anu launched. $ANU_ACCOUNT is exported only by cmd_launch's token-
  # resolved path (never by the keychain-fallback path, which unsets every
  # anu_* stamp instead); a plain `claude` started by hand carries neither.
  # Without this gate, this hook would stamp @anu_session/@anu_generation on
  # an unmanaged pane, which would then pass rotate/switch's "was this
  # started by anu account launch" check and let the watchd arm interrupt and
  # re-credential a session nobody asked it to touch. Check first, before
  # even reading stdin, so an unmanaged pane's hook run is a true no-op.
  _inherited_account claude >/dev/null || exit 0
  local input; input="$(cat 2>/dev/null)" || true
  local pane="${TMUX_PANE:-${ANU_PANE:-}}"
  [ -n "$pane" ] || exit 0
  local session_id; session_id="$(printf '%s' "$input" | jq -r '.session_id // empty' 2>/dev/null)" || true
  [ -n "$session_id" ] || exit 0
  local reason; reason="$(printf '%s' "$input" | jq -r '.source // .start_reason // empty' 2>/dev/null)" || true
  local gen; gen="$(_epoch_ms)" || true
  tmux set-option -p -t "$pane" @anu_session "$session_id" 2>/dev/null || true
  tmux set-option -p -t "$pane" @anu_session_source "$reason" 2>/dev/null || true
  tmux set-option -p -t "$pane" @anu_generation "$gen" 2>/dev/null || true
  exit 0
}
cmd_hook_stop_failure() {  # Claude Code's StopFailure hook — it fires INSTEAD of
  # Stop when an API error ended the turn. Verified against the 2.1.272 binary:
  # the payload is the common hook envelope plus
  #   {hook_event_name:"StopFailure", error:<enum>, error_details?, last_assistant_message?}
  # and the matcher's fieldToMatch is `error` (values include "rate_limit"),
  # NOT `error_type` as the plan assumed. It is fire-and-forget — "hook output
  # and exit codes are ignored" — so this only ever stamps and exits 0.
  #
  # Same $ANU_ACCOUNT gate, and for the same reason, as cmd_hook_session_start:
  # the hook is GLOBAL, so without it a by-hand `claude` hitting a wall would
  # stamp @anu_wall_event on an unmanaged pane and hand watchd's rotation arm a
  # first-tick corroboration signal for a pane it must never touch. Check before
  # even reading stdin, so an unmanaged pane's hook run is a true no-op.
  _inherited_account claude >/dev/null || exit 0
  local input; input="$(cat 2>/dev/null)" || true
  local pane="${TMUX_PANE:-${ANU_PANE:-}}"
  [ -n "$pane" ] || exit 0
  # Re-checked here, not left to the settings.json matcher alone, so a
  # matcher-less wiring (or a CLI whose matcher semantics drift) still only
  # stamps on a real wall. `error_type` is accepted as a fallback name in case a
  # future CLI ships the field under the name the plan expected.
  local kind; kind="$(printf '%s' "$input" | jq -r '.error // .error_type // empty' 2>/dev/null)" || true
  [ "$kind" = rate_limit ] || exit 0
  tmux set-option -p -t "$pane" @anu_wall_event "$(date +%s)" 2>/dev/null || true
  exit 0
}
# ---------------------------------------------------------------- rotate ----
_opt() { tmux show-options -pqv -t "$1" "$2" 2>/dev/null || true; }
_wait_shell() {  # until the pane's foreground process is a shell again
  local pid="$1" tries="${2:-40}" c
  while [ "$tries" -gt 0 ]; do
    c="$(tmux display-message -p -t "$pid" '#{pane_current_command}' 2>/dev/null || true)"
    case "$c" in bash|zsh|sh|fish|dash) return 0 ;; esac
    sleep 0.5; tries=$((tries - 1))
  done
  return 1
}
_wait_running() {  # until the relaunch is actually running — the pane's foreground
  # process is NOT a shell any more. NEVER reads the screen: the human's own
  # shell prompt (starship's "❯") satisfies any on-screen-glyph check instantly,
  # which is exactly the bug this replaces (`_wait_prompt` firing on the typed
  # command line, not on Claude coming up).
  local pid="$1" tries="${2:-40}" c
  while [ "$tries" -gt 0 ]; do
    c="$(tmux display-message -p -t "$pid" '#{pane_current_command}' 2>/dev/null || true)"
    case "$c" in bash|zsh|sh|fish|dash|"") : ;; *) return 0 ;; esac
    sleep 0.5; tries=$((tries - 1))
  done
  return 1
}
_wait_idle() {  # until `pane state` reads idle AND the pane is running something
  # that is not a shell. `pane state` alone is NOT enough: `pane`'s own
  # classifier reads a BARE SHELL as `idle` (no agent CLI, no wall text, no
  # spinner), so a relaunch that died before claude ever started — `box`
  # failing before it execs, a replacement token Claude Code rejects and exits
  # on, a crash right after start — would satisfy this wait, get the
  # continuation typed into the shell, and be reported as a successful
  # rotation. So every poll ALSO requires the non-shell condition
  # `_wait_running` checks. That matters most on the hook-ready path, which
  # skips `_wait_running` entirely: `cmd_launch` stamps @anu_session/
  # @anu_generation itself, BEFORE `exec claude`, so those stamps say "the
  # launch line ran", never "claude is up". Timing out here lands in
  # `_relaunch_died`, which dumps the pane and leaves it alone.
  local pid="$1" tries="${2:-120}" st c
  while [ "$tries" -gt 0 ]; do
    c="$(tmux display-message -p -t "$pid" '#{pane_current_command}' 2>/dev/null || true)"
    case "$c" in
      bash|zsh|sh|fish|dash|"") : ;;
      *) st="$(pane state "$pid" 2>/dev/null || true)"
         # `limited` counts as up too: a `--resume` re-renders the transcript,
         # and the walled turn's own text is then the last turn on screen, so
         # a freshly relaunched pane reads `limited` until it produces a new
         # turn (found live in B7). The continuation the caller sends next IS
         # that new turn; if the new account is walled as well, the wall it
         # prints is a fresh one and the next rotation handles it.
         case "$st" in idle|limited) return 0 ;; esac ;;
    esac
    sleep 0.5; tries=$((tries - 1))
  done
  return 1
}
_relaunch_died() {  # print the pane, session id, and the last screen lines, then die —
  # the pane is left exactly as it is; never looped, never sent "continue".
  local pid="$1" session="$2" why="$3"
  # non-blank lines only: the fullscreen TUI clears the screen on exit, so the
  # bottom eight rows of a died relaunch are empty (seen in B7); what the human
  # needs is the last thing claude printed, wherever it sits.
  tmux capture-pane -p -t "$pid" 2>/dev/null | grep -v '^[[:space:]]*$' | tail -8 >&2
  _die "$pid did not $why after relaunch (session $session) — pane left as is, check it by hand"
}
_gen_newer() {  # $1 candidate, $2 baseline — true iff both look like plain
  # non-negative integers and candidate > baseline. Empty/non-numeric on
  # either side (a pane never stamped, or an older CLI with no hook) is
  # simply "not newer" rather than a comparison error.
  case "$1" in ''|*[!0-9]*) return 1 ;; esac
  case "$2" in ''|*[!0-9]*) return 1 ;; esac
  [ "$1" -gt "$2" ]
}
_wait_hook_ready() {  # $1=pid $2=intended-session $3=pre-relaunch generation
  # $4=tries at 0.5s/try (the caller scales this: 20 => 10s on the host,
  # 120 => 60s boxed — a box's own startup already eats into the budget
  # before Claude gets to fire its own hook). True once the SessionStart
  # hook has itself confirmed the relaunch: @anu_session reads the session
  # we resumed AND @anu_generation is newer than the value read before this
  # relaunch began. An older CLI with no SessionStart hook never satisfies
  # this — callers fall back to _wait_running/_wait_idle after it times out.
  local pid="$1" session="$2" pre_gen="$3" tries="${4:-20}" cur_sess cur_gen
  while [ "$tries" -gt 0 ]; do
    cur_sess="$(_opt "$pid" @anu_session)"
    cur_gen="$(_opt "$pid" @anu_generation)"
    if [ -n "$session" ] && [ "$cur_sess" = "$session" ] && _gen_newer "$cur_gen" "$pre_gen"; then
      return 0
    fi
    sleep 0.5; tries=$((tries - 1))
  done
  return 1
}
# The one relaunch sequence rotate and switch share, factored out so both
# verbs run one implementation: recheck that the pane is still the one the
# caller read facts for (BEFORE touching it at all), leave the old process,
# wait for a bare shell, type the resume line (clearing the screen first so
# old wall/prompt text can't be mistaken for the new session's own output),
# wait for the relaunch to actually be running and then idle, and — only
# when the caller asks for it — nudge it to continue. Neither wait reads the
# screen — see the notes below. The caller does its own reporting; this only
# moves the pane. The caller is expected to hold `_lock_pane` across this
# whole call (rotate/switch acquire it before reading any pane facts, and it
# releases automatically on exit — see `_lock_pane`/`_unlock_pane`), so two
# relaunches of the same pane can never interleave; @anu_rotating below stays
# as the older, softer cooldown other read-only callers (the watchd arm, a manual
# retry message) check.
_abort_relaunch() {  # $1=pid $2=message. A recheck failed before anything was
  # typed — clear @anu_rotating (stamped optimistically just before the
  # recheck) so it doesn't block a retry for up to 120s over a rotation that
  # never actually left the gate, then die with the caller's message.
  tmux set-option -pu -t "$1" @anu_rotating 2>/dev/null || true
  _die "$2"
}
_relaunch_and_resume() {  # $1=pid $2=session $3=next-account $4=need $5=boxed(0/1)
  # $6=launch-args $7=continue-after(0/1, default 1) — rotate always passes
  # 1 (a walled pane was mid-task); switch passes 1 only for a `limited`
  # pane or an explicit --continue, 0 for an `idle` one (reopened, left idle).
  # $8=pre-relaunch generation, as the caller read it BEFORE the pick/
  # preflight network calls above this call — not re-read here, so a change
  # during that round trip is what the recheck below actually catches.
  # $9=state recheck: "wall" (rotate — must still read limited), "movable"
  # (switch without --force — must still read idle or limited), or "skip"
  # (switch --force — the human already forced it; default if omitted).
  # $10=current-account (the one being left, "A") — appended to @anu_tried
  # once the pane is confirmed to have actually left it, so a readiness
  # timeout below (B never comes up) still records A as tried; empty is a
  # silent no-op.
  # Sets $_relaunch_ready_path (hook|fallback) as a global for the caller's
  # own report line — see below.
  local pid="$1" session="$2" next="$3" need="$4" boxed="$5" launch="$6" \
    continue_after="${7:-1}" pre_gen="${8:-}" recheck="${9:-skip}" current="${10:-}"
  # @anu_rotating is stamped first — it is the softer, always-readable
  # cooldown other callers check, not a keystroke — then BOTH facts the
  # caller read before its own pick/preflight (which can be a real network
  # round trip) are rechecked fresh: the generation stamp hasn't moved
  # (someone else relaunched it, or its own SessionStart hook fired for an
  # unrelated reason — a manual /clear, say) and, unless the caller says to
  # skip it (an explicit --force), the pane is still in a state that's
  # actually safe to relaunch. Either failing means NOTHING is typed at all
  # — not even the leave keystrokes — and @anu_rotating is cleared right
  # back off again (_abort_relaunch), since nothing was actually touched.
  tmux set-option -p -t "$pid" @anu_rotating "$(date +%s)"
  local cur_gen; cur_gen="$(_opt "$pid" @anu_generation)"
  [ "$cur_gen" = "$pre_gen" ] || _abort_relaunch "$pid" "pane changed under me ($pid, session $session) — left as is, nothing typed"
  if [ "$recheck" != skip ]; then
    local st2 state2
    st2="$(pane state "$pid" --json 2>/dev/null)" || _abort_relaunch "$pid" "$pid vanished before the relaunch could start (session $session) — nothing typed"
    state2="$(printf '%s' "$st2" | jq -r .state)"
    case "$recheck" in
      wall)    [ "$state2" = limited ] || _abort_relaunch "$pid" "$pid is no longer at a wall (state: $state2, session $session) — left as is, nothing typed" ;;
      movable) case "$state2" in idle|limited) ;; *) _abort_relaunch "$pid" "$pid is now $state2 (session $session) — left as is, nothing typed" ;; esac ;;
    esac
  fi
  # leave: dismiss any dialog, then two ctrl-c (claude asks for the second); /exit as a fallback
  tmux send-keys -t "$pid" Escape; sleep 0.3
  tmux send-keys -t "$pid" C-c; sleep 0.4
  tmux send-keys -t "$pid" C-c
  if ! _wait_shell "$pid" 10; then
    tmux send-keys -t "$pid" C-u "/exit" C-m
    _wait_shell "$pid" 20 || _die "$pid did not return to a shell — left as is (session $session)"
  fi
  # A is confirmed left as of here — record it as tried NOW, not after B's
  # own readiness below, so a readiness timeout (B never comes up) still
  # leaves the pane's memory honest: A was abandoned, whatever happens next.
  [ -n "$current" ] && _tried_append "$pid" "$current" claude
  # $need is the one value interpolated UNQUOTED into the line typed below
  # (`--need $need`), so it is validated here rather than trusted: it comes
  # from a pane option any process on this machine can set. Anything that is
  # not the closed set the verb accepts becomes `any`, loudly.
  case "$need" in
    any|fable) ;;
    *) printf 'anu account: %s has an invalid @anu_need (%s) — relaunching with any\n' "$pid" "$need" >&2
       need=any ;;
  esac
  local boxflag=""; [ "$boxed" = 1 ] && boxflag=" --box"
  # Clear the screen first (same clear the aliases use) so the old wall text and
  # stale prompt lines can't be mistaken for the new session's own output.
  # next/session are shell-quoted (%q) same as $launch already is (via
  # _args_for_resume) — an account name or session id with a space/quote in
  # it must reparse exactly when this line is typed back into the shell.
  local next_q session_q; printf -v next_q '%q' "$next"; printf -v session_q '%q' "$session"
  local line="printf '\033[2J\033[3J\033[H' && $COM8_ACCOUNT_LAUNCH_COMMAND launch --as $next_q --need $need$boxflag -- --resume $session_q $launch"
  tmux send-keys -t "$pid" "$line" C-m
  # Readiness: prefer the SessionStart hook's own word for it — @anu_session
  # back to the resumed session AND @anu_generation newer than $pre_gen —
  # over up to 10s (60s boxed: a box's own startup already eats into that
  # budget before Claude even gets to fire its own hook, so the same fixed
  # 10s would push every boxed relaunch straight to the fallback); that hook
  # already fired is strong evidence the resume line ran under the new
  # account, but it is NOT proof claude is up: `cmd_launch` stamps both
  # options itself, before `exec claude`, so the stamps can land while the
  # pane's foreground process is still the shell. It only buys us the
  # `_wait_running` poll; `_wait_idle` below re-checks the foreground process
  # on every poll for exactly that reason. An older CLI with no SessionStart
  # hook never satisfies it, so after the budget runs out fall back to the
  # original two waits (their own, larger boxed timeouts unchanged), neither
  # of which reads the screen: (1) the relaunch is running at all — the
  # pane's foreground process left the shell; (2) claude is actually back up —
  # `pane state` reads idle AND the foreground process is still not a shell
  # (`pane state` alone reads a bare shell as idle). This is
  # what replaced `_wait_prompt`: that scanned the screen for a composer
  # glyph, and the human's own starship prompt ("❯") satisfies that check
  # instantly — so a naive version would type "continue" into a bare shell
  # (or into Claude mid-boot) and still report success.
  _relaunch_ready_path=fallback
  local hook_tries=20; [ "$boxed" = 1 ] && hook_tries=120
  if _wait_hook_ready "$pid" "$session" "$pre_gen" "$hook_tries"; then
    _relaunch_ready_path=hook
  else
    local run_tries=40; [ "$boxed" = 1 ] && run_tries=180
    _wait_running "$pid" "$run_tries" || _relaunch_died "$pid" "$session" "start relaunching"
  fi
  # 120 tries * 0.5s = 60s unboxed; 360 tries * 0.5s = 180s boxed, per the
  # plan's own cap ("60s, 180s boxed") — 180 TRIES here would only be 90s,
  # half the intended boxed budget.
  local idle_tries=120; [ "$boxed" = 1 ] && idle_tries=360
  _wait_idle "$pid" "$idle_tries" || _relaunch_died "$pid" "$session" "come back up"
  if [ "$continue_after" = 1 ]; then
    # The pane IS up at this point — a failing send must not read as a
    # silent success (the human would think the task resumed on its own).
    pane send "$pid" "$CONTINUATION_TEXT" \
      || _die "$pid: continuation not delivered (session $session, now on $next) — check it by hand"
  fi
  return 0
}
# -------------------------------------------------- codex relaunch ----
# The Codex handoff. Same lock, same tried-list, same "preflight before you
# leave" as the claude path; everything else differs, because Codex differs.
#
#  * There is no `/exit`. The spike tried it: `/exit` and `/quit` did nothing
#    at all in ~10 s — they are not commands this TUI knows — while Ctrl-C
#    twice ended it in about two seconds. So the leave sequence is Ctrl-C ×2
#    and then, if the process is STILL there, a signal to the pid this
#    rotation itself read off the pane's tty. Never a keystroke of text, and
#    never a pid it did not verify.
#  * There is no composer to type into. The continuation rides as the `codex
#    resume <id> "<text>"` ARGUMENT, which the spike verified is submitted
#    automatically — and Codex's own paste detection swallows a `send-keys`
#    prompt that arrives too fast, which is the other reason never to type one.
#  * There is no hook to wait for. Codex reports SessionStart at the FIRST
#    PROMPT, so a relaunch without one emits nothing at all for as long as the
#    human is away (C1, the 2026-09-16 live matrix parked two healthy panes on
#    exactly that). Readiness is therefore the pane's own foreground process: a
#    NEW codex pid, different from the one that was terminated, still alive
#    five seconds later.
_pane_fg_pid() {  # $1 = pane. The pid of the pane's foreground process, or
  # nothing when that process is a shell — "the pane is at bash" is an answer,
  # not a pid worth returning.
  local pid="$1" tty cmd out
  tty="$(tmux display-message -p -t "$pid" '#{pane_tty}' 2>/dev/null || true)"
  cmd="$(tmux display-message -p -t "$pid" '#{pane_current_command}' 2>/dev/null || true)"
  [ -n "$tty" ] && [ -n "$cmd" ] || return 1
  case "$cmd" in bash|zsh|sh|fish|dash|"") return 1 ;; esac
  out="$(ps -t "${tty#/dev/}" -o pid=,comm= 2>/dev/null \
    | awk -v c="$cmd" '{ n = split($2, a, "/"); if (a[n] == c) { print $1; exit } }')"
  [ -n "$out" ] || return 1
  printf '%s' "$out"
}
_wait_pid_gone() {  # $1 = pid, $2 = tries at 0.5s
  local p="$1" tries="${2:-20}"
  while [ "$tries" -gt 0 ]; do
    kill -0 "$p" 2>/dev/null || return 0
    sleep 0.5; tries=$((tries - 1))
  done
  return 1
}
_wait_new_codex() {  # $1 = pane, $2 = the pid that was terminated, $3 = tries.
  # Prints the replacement pid.
  local pid="$1" old="$2" tries="${3:-40}" cur
  while [ "$tries" -gt 0 ]; do
    cur="$(_pane_fg_pid "$pid")" || cur=""
    if [ -n "$cur" ] && [ "$cur" != "$old" ]; then printf '%s' "$cur"; return 0; fi
    sleep 0.5; tries=$((tries - 1))
  done
  return 1
}
_relaunch_codex() {  # $1=pid $2=session $3=next $4=need $5=launch-args
  # $6=continue-after(0/1) $7=pre-relaunch generation $8=state recheck
  # $9=current account ${10}=the session's cwd
  # Leaves the old process and makes the FIRST attempt; the verdict is in
  # $_codex_alive (see _codex_attempt). Everything short of that verdict — a
  # recheck that fails, a pane that will not come back to a shell — dies here
  # exactly as it always has, with nothing typed.
  local pid="$1" session="$2" next="$3" need="$4" launch="$5" \
        continue_after="${6:-1}" pre_gen="${7:-}" recheck="${8:-skip}" current="${9:-}" cwd="${10:-}"
  tmux set-option -p -t "$pid" @anu_rotating "$(date +%s)"
  local cur_gen; cur_gen="$(_opt "$pid" @anu_generation)"
  [ "$cur_gen" = "$pre_gen" ] || _abort_relaunch "$pid" "pane changed under me ($pid, session $session) — left as is, nothing typed"
  if [ "$recheck" != skip ]; then
    local st2 state2
    st2="$(pane state "$pid" --json 2>/dev/null)" || _abort_relaunch "$pid" "$pid vanished before the relaunch could start (session $session) — nothing typed"
    state2="$(printf '%s' "$st2" | jq -r .state)"
    case "$recheck" in
      wall)    [ "$state2" = limited ] || _abort_relaunch "$pid" "$pid is no longer at a wall (state: $state2, session $session) — left as is, nothing typed" ;;
      movable) case "$state2" in idle|limited) ;; *) _abort_relaunch "$pid" "$pid is now $state2 (session $session) — left as is, nothing typed" ;; esac ;;
    esac
  fi
  # The pid this rotation is responsible for, read BEFORE anything is sent —
  # so a signal later can only ever land on the process that was there when
  # the decision was made, never on whatever happens to be running by then.
  local old_pid; old_pid="$(_pane_fg_pid "$pid")" || old_pid=""
  # The wall this relaunch carries, read before anything is sent too. The
  # relaunch line keeps it (--keep-wall) and _codex_attempt clears it only once
  # a new codex is confirmed alive — and only if it is still THIS wall.
  _codex_wall_was="$(_opt "$pid" @anu_wall_pending)"
  tmux send-keys -t "$pid" C-c; sleep 0.4
  tmux send-keys -t "$pid" C-c
  if [ -n "$old_pid" ] && ! _wait_pid_gone "$old_pid" 20; then
    # Ctrl-C ignored. Terminate that pid, and only that pid.
    kill -TERM "$old_pid" 2>/dev/null || true
    if ! _wait_pid_gone "$old_pid" 6; then
      kill -KILL "$old_pid" 2>/dev/null || true
      _wait_pid_gone "$old_pid" 6 || true
    fi
  fi
  if ! _wait_shell "$pid" 20; then
    # Park it. A relaunch line typed on top of whatever IS running there would
    # be typed into that program, not into a shell.
    tmux set-option -pu -t "$pid" @anu_rotating 2>/dev/null || true
    _die_code 2 "$pid did not return to a shell after Ctrl-C (session $session) — parked, left exactly as it is; look at it by hand"
  fi
  [ -n "$current" ] && _tried_append "$pid" "$current" codex
  _codex_attempt "$pid" "$session" "$next" "$launch" "$continue_after" "$cwd" "${old_pid:-none}"
}
# ONE relaunch onto ONE account, typed into a pane that is at a shell, and
# judged by the pane's own processes: a NEW codex pid (not $7) that is still
# alive five seconds later. Sets $_codex_alive to 1 or 0 and always returns 0
# — a candidate that does not come up is an answer about THAT candidate, not
# a failure of the rotation, and the caller decides whether there is another.
# When it is 0 it also sets $_codex_attempt_why (for the "did not <why>
# after relaunch" line) and $_codex_attempt_pid (the codex that died, if one
# started), and puts the screen's last lines on stderr — where Codex's own
# error ("…unauthorized (401)") still sits once the pane is back at a shell.
#
# The line carries --keep-wall, so the launch it runs leaves @anu_wall_pending
# alone. Only a relaunch confirmed alive clears it, here — and only while it
# still holds the wall this rotation started from ($_codex_wall_was): the new
# process may already have walled again on its first turn, and the tick's scan
# may already have stamped THAT wall, which is new evidence, not ours to drop.
_codex_attempt() {  # $1=pid $2=session $3=next $4=launch-args $5=continue-after
  # $6=the session's cwd $7=the pid this attempt replaces ("none" if unknown)
  local pid="$1" session="$2" next="$3" launch="$4" continue_after="${5:-1}" \
        cwd="${6:-}" old="${7:-none}"
  _codex_alive=0; _codex_attempt_why=""; _codex_attempt_pid=""
  local next_q session_q cwd_q cont_q=""
  printf -v next_q '%q' "$next"; printf -v session_q '%q' "$session"
  printf -v cwd_q '%q' "$cwd"
  [ "$continue_after" = 1 ] && printf -v cont_q ' %q' "$CONTINUATION_TEXT"
  local cdflag=""; [ -n "$cwd" ] && cdflag=" --cd $cwd_q"
  local line="printf '\033[2J\033[3J\033[H' && $COM8_ACCOUNT_LAUNCH_COMMAND launch --provider codex --as $next_q --need any$cdflag --keep-wall -- resume $session_q$cont_q${launch:+ $launch}"
  tmux send-keys -t "$pid" "$line" C-m
  _relaunch_ready_path=pid
  local new_pid
  if ! new_pid="$(_wait_new_codex "$pid" "$old" 60)"; then
    _codex_attempt_why="start a new codex process"
    _screen_tail "$pid"
    return 0
  fi
  # …and it is still there a moment later. A codex that exits on a rejected
  # login, a bad profile or an unanswered modal is up for a second and gone.
  sleep 5
  if ! kill -0 "$new_pid" 2>/dev/null; then
    _codex_attempt_why="stay up"; _codex_attempt_pid="$new_pid"
    _screen_tail "$pid"
    return 0
  fi
  _codex_alive=1
  if [ -n "${_codex_wall_was:-}" ] && [ "$(_opt "$pid" @anu_wall_pending)" = "$_codex_wall_was" ]; then
    tmux set-option -pu -t "$pid" @anu_wall_pending 2>/dev/null || true
  fi
  return 0
}
_screen_tail() {  # $1 = pane. Its last non-blank lines, on stderr. A fullscreen
  # TUI clears the screen on exit, so the bottom rows of a relaunch that died
  # are empty; what the reader needs is the last thing it printed.
  tmux capture-pane -p -t "$1" 2>/dev/null | grep -v '^[[:space:]]*$' | tail -8 >&2 || true
}
_pane_say() {  # $1 = pane, $2 = one line. Written to the pane's own tty, so it
  # lands in the pane as OUTPUT — never typed into the shell as a command, never
  # in its history. Then one Enter, so the shell draws a fresh prompt under it
  # instead of leaving the cursor on a bare line. Only ever called with the pane
  # confirmed at a shell; a tty this process cannot write is skipped.
  local tty; tty="$(tmux display-message -p -t "$1" '#{pane_tty}' 2>/dev/null || true)"
  [ -n "$tty" ] && [ -w "$tty" ] || return 0
  printf '\r\n%s' "$2" > "$tty" 2>/dev/null || return 0
  tmux send-keys -t "$1" C-m 2>/dev/null || true
}
# Every candidate a codex rotation could land on failed AFTER the pane had
# already left the walled process. The pane is at a shell, and the session is
# not running anywhere. Its @anu_wall_pending was never cleared (nothing came
# up), so it still reads `limited` — which is true. The walled account goes
# back on @anu_account: the failed launches stamped their own names on the way
# through, and the last account this conversation actually RAN on is the one
# it walled on. Then ONE line — in the pane, and as the last line on stderr,
# which is the last line of the watchd worker's log and so the notice the reap
# raises on the very next tick — and exit 1.
_codex_park() {  # $1=pid $2=session $3=the walled account $4=launch-args
  # $5=the accounts that did not come up, space-separated
  local pid="$1" session="$2" walled="$3" launch="$4" died="$5"
  tmux set-option -p -t "$pid" @anu_account "$walled" 2>/dev/null || true
  # Which logins are left on this device once the dead ones are set aside.
  # auth.json is still only tested for EXISTENCE: whether a login works is
  # what the relaunches above just found out, not something to ask a server.
  local left="" a
  while IFS= read -r a; do
    [ -n "$a" ] || continue
    case " $died " in *" $a "*) continue ;; esac
    left="${left:+$left }$a"
  done <<EOF
$(_codex_local_accounts)
EOF
  local why="${died// /, } did not stay up"
  [ "$left" = "$walled" ] && why="$why; $walled, the account that walled, is the only codex login left on this device"
  local walled_q session_q; printf -v walled_q '%q' "$walled"; printf -v session_q '%q' "$session"
  launch="${launch% }"
  local msg="anu account: rotation failed — no codex account with room is logged in on this device ($why); resume with: $COM8_ACCOUNT_LAUNCH_COMMAND launch --provider codex --as $walled_q -- resume $session_q${launch:+ $launch}"
  _pane_say "$pid" "$msg"
  printf '%s\n' "$msg" >&2
  exit 1
}

cmd_rotate() {
  local target="" force=0
  while [ $# -gt 0 ]; do case "$1" in
    --force) force=1; shift ;;
    *) [ -z "$target" ] || _die "rotate: unexpected '$1'"; target="$1"; shift ;;
  esac; done
  [ -n "$target" ] || _die "usage: com8-account rotate <pane> [--force]"
  # `pane` (the anu plugin bin) is the only way this verb reads or drives a
  # pane. Without it `pane state` below fails the same way an unknown target
  # does, and a missing install would report itself as "no such pane" — a
  # wrong answer that sends the reader looking at the pane instead of at
  # their PATH. Checked here, before anything is resolved.
  [ -x "$COM8_ACCOUNT_PANE" ] || _die "configured pane helper is not executable"
  # `pane state` both resolves the target (CLI name, role, agent-N, %id, …)
  # and reports the wall in one call — `pane id` only matches CLI names, so
  # a %id/agent-N target would silently resolve to nothing.
  local st; st="$(pane state "$target" --json 2>/dev/null)" || _die "no such pane: $target"
  local pid; pid="$(printf '%s' "$st" | jq -r .pane)"
  [ -n "$pid" ] && [ "$pid" != null ] || _die "no such pane: $target"

  # The hard lock, acquired before reading any pane fact below — a second
  # rotate/switch on the SAME pane (a real concurrent call, not just the
  # softer @anu_rotating cooldown checked next) refuses outright instead of
  # racing this one. Released automatically on every exit path (see
  # _lock_pane/_unlock_pane), including every `_die`/`return` below.
  _lock_pane "$pid" || _die "another rotation holds $pid"

  if [ "$force" != 1 ]; then
    local rotating now; rotating="$(_opt "$pid" @anu_rotating)"; now="$(date +%s)"
    if [ -n "$rotating" ] && [ $((now - rotating)) -lt 120 ]; then
      _die "$pid is already rotating (started $((now - rotating))s ago) — pass --force to retry"
    fi
  fi
  local account session need launch boxed pre_gen provider cwd
  account="$(_opt "$pid" @anu_account)"; session="$(_opt "$pid" @anu_session)"
  need="$(_opt "$pid" @anu_need)"; launch="$(_opt "$pid" @anu_launch)"; boxed="$(_opt "$pid" @anu_box)"
  pre_gen="$(_opt "$pid" @anu_generation)"; provider="$(_opt "$pid" @anu_provider)"
  [ -n "$provider" ] || provider=claude
  [ -n "$session" ] || _die "$pid has no @anu_session — it was not started by com8-account launch (a codex pane that has never been prompted has no session id yet, and there is nothing to resume)"
  [ -n "$account" ] || _die "$pid has no @anu_account — it was not started by com8-account launch"
  [ -n "$need" ] || need=any
  local state wall; state="$(printf '%s' "$st" | jq -r .state)"; wall="$(printf '%s' "$st" | jq -r '.wall // "session"')"
  [ "$state" = limited ] || _die "$pid is not at a wall (state: $state)"
  # A Fable wall means Fable room is what this pane lacks; any other wall
  # blocks everything, so the pane's own need decides.
  local pick_need="$need"; [ "$wall" = fable ] && pick_need=fable
  [ "$provider" = codex ] && pick_need=any
  # The session's own cwd. A `codex resume` launched anywhere else opens
  # "Choose working directory to resume this session" — a modal no unattended
  # rotation can answer — so the relaunch always goes back where the session
  # started, and the destination's trust is preflighted for THAT directory.
  cwd=""
  [ "$provider" = codex ] && cwd="$(tmux display-message -p -t "$pid" '#{pane_current_path}' 2>/dev/null || true)"
  # Preflight, before leaving A at all: walk the dashboard's ranked list for
  # the first candidate this device can actually land on and that wasn't just
  # tried by this same pane. Dashboard-unreachable (exit 1) and "every
  # candidate exhausted" (exit 2, A stays parked) are different,
  # distinguishable failures — see _pick_next. The ranking is asked for ONCE
  # and kept: a codex relaunch that dies walks on down this same list.
  local ranked pick_rc=0 next next_rc=0
  ranked="$(cmd_pick --provider "$provider" --need "$pick_need" --exclude "${account:-none}")" || pick_rc=$?
  if [ "$pick_rc" -ne 0 ]; then
    return 1
  fi
  next="$(_first_landable "$pid" "${account:-none}" "$provider" "$cwd" "$ranked")" || next_rc=$?
  if [ -z "$next" ] || [ "$next_rc" -ne 0 ]; then
    printf 'anu account: nothing has room for %s — %s stays parked (the CLI resumes at reset)\n' "$pick_need" "$pid"
    return 2
  fi
  # rotate always continues — a walled pane was mid-task, not idle. The
  # recheck right before leaving must still see a wall (mode "wall") —
  # rotate has no --force override for that, only for the softer cooldown
  # above.
  if [ "$provider" = codex ]; then
    _relaunch_codex "$pid" "$session" "$next" "$need" "$launch" 1 "$pre_gen" wall "$account" "$cwd"
    # A relaunch that did not come up is THAT candidate failing, not the
    # rotation: nothing in the preflight can see a login chatgpt.com has
    # stopped honouring (auth.json is only ever tested for existence, and no
    # preflight makes a network call), so the relaunch itself is the test.
    # The candidate goes on the tried list — a later wall within 30 min skips
    # it too — and the next one down the SAME ranking gets the same preflight
    # and a relaunch from the shell the dead one left behind, in this worker,
    # until one stays up or the ranking runs out. The pane's wall stamp is
    # left alone throughout; only a relaunch confirmed alive clears it.
    local died=""
    while [ "$_codex_alive" != 1 ]; do
      printf 'anu account: %s: %s did not %s after relaunch (session %s) — trying the next codex account\n' \
        "$pid" "$next" "$_codex_attempt_why" "$session" >&2
      _tried_append "$pid" "$next" codex
      died="${died:+$died }$next"
      # Everything ranked BELOW the one that died; never back up the list.
      ranked="$(printf '%s\n' "$ranked" | awk -v n="$next" 'f { print } $0 == n { f = 1 }')"
      if ! _wait_shell "$pid" 20; then
        # Something that is not a shell holds the pane now. Nothing more is
        # typed into it, and nothing is written over it.
        printf 'anu account: rotation failed — %s did not return to a shell after the relaunch onto %s (session %s); left as is\n' \
          "$pid" "$next" "$session" >&2
        exit 1
      fi
      next=""; next_rc=0
      next="$(_first_landable "$pid" "$account" codex "$cwd" "$ranked")" || next_rc=$?
      [ -n "$next" ] && [ "$next_rc" -eq 0 ] || _codex_park "$pid" "$session" "$account" "$launch" "$died"
      _codex_attempt "$pid" "$session" "$next" "$launch" 1 "$cwd" "${_codex_attempt_pid:-none}"
    done
  else
    _relaunch_and_resume "$pid" "$session" "$next" "$need" "$boxed" "$launch" 1 "$pre_gen" wall "$account"
  fi
  printf '%s: %s → %s (%s wall, session %s, ready via %s)\n' "$pid" "${account:-?}" "$next" "$wall" "$session" "$_relaunch_ready_path"
}
# ----------------------------------------------------------------- switch ----
# The voluntary version of rotate: move a pane to another account right now,
# without a wall. Same pane-facts + relaunch sequence (via
# _relaunch_and_resume), but three differences from rotate: (1) by default
# only `idle` and `limited` panes move — `busy` (a mid-generation pane is
# never interrupted by accident), `approval`, `booting`, `dead`, and any
# unknown state are all refused unless --force; (2) the continuation line is
# sent ONLY when the pane was `limited` (it was mid-task and got walled) or
# --continue was passed — an `idle` pane is reopened and left idle, never
# nudged into work it wasn't already doing; (3) `--as` may name the pane's
# own current account only with --force (a no-op otherwise).
cmd_switch() {
  local target="" as="" need_flag="" force=0 cont=0
  while [ $# -gt 0 ]; do case "$1" in
    --as)       [ $# -ge 2 ] || _die "switch: --as needs a name"; as="$2"; shift 2 ;;
    --need)     [ $# -ge 2 ] || _die "switch: --need needs a value"; need_flag="$2"; shift 2 ;;
    --continue) cont=1; shift ;;
    --force)    force=1; shift ;;
    *) [ -z "$target" ] || _die "switch: unexpected '$1'"; target="$1"; shift ;;
  esac; done
  [ -n "$target" ] || _die "usage: com8-account switch <pane> [--as <name>] [--need any|fable] [--continue] [--force]"
  # Same reason as rotate: a missing plugin bin must not masquerade as a
  # missing pane.
  [ -x "$COM8_ACCOUNT_PANE" ] || _die "configured pane helper is not executable"
  [ -z "$need_flag" ] || [ "$need_flag" = any ] || [ "$need_flag" = fable ] \
    || _die "switch: --need must be any or fable"
  # `pane state` both resolves the target (CLI name, role, agent-N, %id, …)
  # and reports the pane's live state in one call — `pane id` only matches
  # CLI names, so a %id/agent-N target would silently resolve to nothing.
  local st; st="$(pane state "$target" --json 2>/dev/null)" || _die "no such pane: $target"
  local pid; pid="$(printf '%s' "$st" | jq -r .pane)"
  [ -n "$pid" ] && [ "$pid" != null ] || _die "no such pane: $target"

  # The same hard lock rotate holds, acquired before reading any pane fact —
  # see the note in cmd_rotate. Released automatically on every exit path.
  _lock_pane "$pid" || _die "another rotation holds $pid"

  local account session need launch boxed pre_gen provider cwd
  account="$(_opt "$pid" @anu_account)"; session="$(_opt "$pid" @anu_session)"
  need="$(_opt "$pid" @anu_need)"; launch="$(_opt "$pid" @anu_launch)"; boxed="$(_opt "$pid" @anu_box)"
  pre_gen="$(_opt "$pid" @anu_generation)"; provider="$(_opt "$pid" @anu_provider)"
  [ -n "$provider" ] || provider=claude
  [ -n "$session" ] || _die "$pid has no @anu_session — it was not started by com8-account launch (a codex pane that has never been prompted has no session id yet, and there is nothing to resume)"
  [ -n "$account" ] || _die "$pid has no @anu_account — it was not started by com8-account launch"
  [ -n "$need" ] || need=any
  [ -n "$need_flag" ] && need="$need_flag"
  [ "$provider" = codex ] && need=any
  cwd=""
  [ "$provider" = codex ] && cwd="$(tmux display-message -p -t "$pid" '#{pane_current_path}' 2>/dev/null || true)"
  # Naming the pane's own current account is a no-op unless --force, which
  # treats it as a deliberate relaunch under the same account. Checked
  # BEFORE the rotating-cooldown guard below, so `switch --as <current>`
  # within the cooldown window reports "already on X" (exit 0), not
  # "already rotating".
  if [ -n "$as" ] && [ "$as" = "${account:-}" ] && [ "$force" != 1 ]; then
    printf 'anu account: %s is already on %s\n' "$pid" "$as"
    return 0
  fi
  if [ "$force" != 1 ]; then
    local rotating now; rotating="$(_opt "$pid" @anu_rotating)"; now="$(date +%s)"
    if [ -n "$rotating" ] && [ $((now - rotating)) -lt 120 ]; then
      _die "$pid is already rotating (started $((now - rotating))s ago) — pass --force to retry"
    fi
  fi
  local state wall; state="$(printf '%s' "$st" | jq -r .state)"; wall="$(printf '%s' "$st" | jq -r '.wall // "session"')"
  if [ "$force" != 1 ]; then
    case "$state" in
      idle|limited) ;;
      *) _die "$pid is $state — pass --force to switch it anyway (only idle/limited panes move by default; a mid-generation or unresolved pane is otherwise left alone)" ;;
    esac
  fi
  # Same rule rotate uses: a `limited` pane at a fable wall lacks fable room
  # specifically, even if its own stamped need is any — any other wall, or a
  # pane that isn't walled at all (idle — no wall to read), falls back to
  # the pane's own need.
  local pick_need="$need"
  [ "$state" = limited ] && [ "$wall" = fable ] && pick_need=fable
  [ "$provider" = codex ] && pick_need=any
  local next
  if [ -n "$as" ]; then
    # Preflight an explicit --as too: nothing typed for an account this
    # device cannot actually land on. On the codex side that is the same
    # three-part check the ranked walk makes — a home, trusted hooks, and this
    # directory already trusted in it.
    if [ "$provider" = codex ]; then
      _codex_candidate_ok "$as" "$cwd" \
        || _die "$as is not a landable codex account on this device (no auth.json, untrusted hooks, or $cwd not trusted in its home); nothing typed"
    else
      _token_for "$as" >/dev/null 2>&1 || _die "no token for $as; nothing typed"
    fi
    next="$as"
  else
    # Same preflight rotate uses: the first ranked candidate this device can
    # land on and that wasn't just tried by this pane.
    local next_rc=0
    next="$(_pick_next "$pid" "$pick_need" "${account:-none}" "$provider" "$cwd")" || next_rc=$?
    if [ "$next_rc" -eq 1 ]; then
      return 1
    fi
    if [ -z "$next" ] || [ "$next_rc" -eq 2 ]; then
      printf 'anu account: nothing has room for %s — %s stays on %s\n' "$pick_need" "$pid" "${account:-?}"
      return 2
    fi
  fi
  # Continue only for a pane that WAS mid-task (limited — walled while
  # working) or when the human explicitly asked to; an idle pane is simply
  # reopened under the new account and left idle, not nudged into work.
  local send_continue=0
  { [ "$state" = limited ] || [ "$cont" = 1 ]; } && send_continue=1
  # The recheck right before leaving mirrors the initial state gate above:
  # --force skips it entirely (the human already forced it), otherwise the
  # pane must still read idle or limited.
  local recheck_mode=movable; [ "$force" = 1 ] && recheck_mode=skip
  if [ "$provider" = codex ]; then
    _relaunch_codex "$pid" "$session" "$next" "$need" "$launch" "$send_continue" "$pre_gen" "$recheck_mode" "$account" "$cwd"
    # A switch names (or picks) ONE destination; it does not walk on. The
    # screen is already on stderr; a limited pane keeps its wall stamp.
    [ "$_codex_alive" = 1 ] \
      || _die "$pid did not $_codex_attempt_why after relaunch (session $session) — pane left as is, check it by hand"
  else
    _relaunch_and_resume "$pid" "$session" "$next" "$need" "$boxed" "$launch" "$send_continue" "$pre_gen" "$recheck_mode" "$account"
  fi
  printf '%s: %s → %s (switch, session %s, ready via %s)\n' "$pid" "${account:-?}" "$next" "$session" "$_relaunch_ready_path"
}

# ---------------------------------------------------------------- doctor ----
# One home's check output (`<kind><TAB><name>` lines) as a line a human reads:
# what holds real state first, then what is merely not linked yet.
_codex_doctor_line() {
  awk -F'\t' '
    function add(k, v) { if (cnt[k] < 6) list[k] = list[k] (cnt[k] ? " " : "") v; cnt[k]++ }
    function show(k, label) {
      if (!cnt[k]) return
      s = label ": " list[k]; if (cnt[k] > 6) s = s " … (+" cnt[k] - 6 ")"
      out = out (out ? "; " : "") s
    }
    { add($1, $2) }
    END {
      show("real", "real, to fold into ~/.codex"); show("here", "only here, to move in")
      show("elsewhere", "linked elsewhere")
      if (cnt["missing"]) out = out (out ? "; " : "") cnt["missing"] " not linked yet"
      print out
    }'
}
# Is every codex account home on this device a view of ~/.codex? One line per
# home: `ok`, or the entries that are not yet what the view needs — a real
# file or directory where the link belongs, a missing link, a link somewhere
# else, a name only the home holds. `--fix` folds them in exactly as a launch
# as that account would. Exit 0 only when every home is a view. The claude
# side keeps no per-account directory, so it has nothing to check.
cmd_doctor() {
  local provider=codex fix=0
  while [ $# -gt 0 ]; do case "$1" in
    --provider) [ $# -ge 2 ] || _die "doctor: --provider needs a value"; provider="$2"; shift 2 ;;
    --fix)      fix=1; shift ;;
    *) _die "doctor: unexpected '$1'" ;;
  esac; done
  _provider_check doctor "$provider"
  if [ "$provider" = claude ]; then
    printf 'claude accounts are tokens, not directories: every one runs in ~/.claude already, so there is no home to check\n'
    return 0
  fi
  local canon d name names store bad=0 total=0
  canon="$(_tilde "$CODEX_USER_DIR")"
  if [ "$fix" = 1 ] && [ -d "$CODEX_ACCOUNT_DIR" ]; then
    _codex_user_dir_ready || _die "could not create $canon"
  fi
  if [ -d "$CODEX_USER_DIR" ]; then
    printf '%s is the one store: every codex home here links all of it but auth.json and config.toml\n' "$canon"
  else
    printf '%s does not exist yet; the first `com8-account add --provider codex` creates it\n' "$canon"
  fi
  if [ -d "$CODEX_ACCOUNT_DIR" ]; then
    if [ "$fix" = 1 ]; then _codex_share_all "" || true; fi
    store="$(_codex_share_entry "$CODEX_ACCOUNT_DIR" sessions check)" || true
    if [ -z "$store" ]; then
      printf '  %-12s ok (%s resolves to %s/sessions)\n' "old store" "$(_tilde "$CODEX_ACCOUNT_DIR/sessions")" "$canon"
    else
      bad=$((bad + 1))
      printf '  %-12s %s is not a link to %s/sessions\n' "old store" "$(_tilde "$CODEX_ACCOUNT_DIR/sessions")" "$canon"
    fi
  fi
  for d in "$CODEX_ACCOUNT_DIR"/*; do
    { [ -d "$d" ] && ! [ -L "$d" ]; } || continue
    name="${d##*/}"
    _codex_home_name_ok "$name" || continue
    total=$((total + 1))
    if [ "$fix" = 1 ]; then _codex_share_all "$name" || true; fi
    names="$(_codex_share_home "$d" check)" || true
    if [ -z "$names" ]; then printf '  %-12s ok\n' "$name"; continue; fi
    bad=$((bad + 1))
    printf '  %-12s not a view yet — %s\n' "$name" "$(printf '%s\n' "$names" | _codex_doctor_line)"
  done
  if [ "$total" = 0 ]; then
    printf 'no codex account homes on this device (com8-account add --provider codex <name>)\n'
    [ "$bad" = 0 ] || return 1
    return 0
  fi
  if [ "$bad" -gt 0 ]; then
    if [ "$fix" = 1 ]; then
      printf 'still outside %s: an entry changed in the last minute moves on a later pass; anything else is named above\n' "$canon"
    else
      printf 'state outside %s: `com8-account doctor --provider codex --fix` folds it in, and so does the next launch as that account\n' "$canon"
    fi
    return 1
  fi
  printf 'every home is a view of %s\n' "$canon"
}

# ------------------------------------------------------------- rebalance ----
# The rule and every guard are in the header's "rebalance" paragraph; this is
# them, in the order a REASON is reported — the FIRST thing that stopped the
# move, never the last. Read off the dashboard pick, two things differ from
# model-switcher by construction: `remaining` is WEEKLY headroom, so (1) does
# not see the 5h window ms also counts; and a null reset is +infinity here
# (the brief's ruling), where ms leaves an unknown reset undecided — a current
# account whose week has not started yet IS beaten by a best that names one.
REBALANCE_NEAR_WALL=15          # (1) the current account has at most this left…
REBALANCE_DEST_ROOM=30          # (1) …and the destination at least this much
REBALANCE_RESET_LEAD=86400      # (2) 24h of weekly-reset lead, the whole test
REBALANCE_MOVE_COOLDOWN=21600   # 6h between two rebalance moves of one pane
REBALANCE_WALL_COOLDOWN=1800    # 30m after any relaunch (a wall's rotation, a switch)
REBALANCE_RANK_TTL=900          # a cached ranking is evidence for 15m
REBALANCE_IN_USE=300            # a key this recent in a client's current pane = in use

_reb_now() {  # the clock — a test may pin it, gated like every other test knob
  if [ "${ANU_ACCOUNT_TEST:-0}" = 1 ] && [ -n "${ANU_ACCOUNT_TEST_NOW:-}" ]; then
    printf '%s' "$ANU_ACCOUNT_TEST_NOW"; return 0
  fi
  date +%s
}
_reb_gate() {  # @anu_rebalance: on unless it reads 0 — unset is ON, unlike @anu_autorotate
  [ "$(tmux show-options -gqv @anu_rebalance 2>/dev/null || true)" != 0 ]
}
_reb_rank_key() {  # $1 = provider, $2 = need → the SERVER option holding that ranking
  if [ "$2" = any ]; then printf '@anu_rebalance_rank_%s' "$1"
  else printf '@anu_rebalance_rank_%s_%s' "$1" "$2"; fi
}
# jq: an ISO-8601 time as epoch seconds, or null. The dashboard hands on
# Claude's own "2026-09-26T20:00:00.474272+00:00" and Codex's
# "2026-09-29T03:33:44.000Z"; jq's fromdateiso8601 reads neither (the fraction,
# the offset), and a reset that reads as null is +infinity — so a bare
# fromdateiso8601 would switch condition 2 off without a word.
_REB_JQ_EPOCH='
def epoch:
  if type != "string" then null
  else (capture("^(?<d>[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2})(\\.[0-9]+)?(?<z>Z|[+-][0-9]{2}:?[0-9]{2})?$") // null) as $m
    | if $m == null then null
      else (($m.d + "Z") | fromdateiso8601) as $t
        | if ($m.z == null or $m.z == "Z") then $t
          else ($m.z | capture("^(?<s>[+-])(?<h>[0-9]{2}):?(?<mm>[0-9]{2})$")) as $o
            | (($o.h | tonumber) * 3600 + ($o.mm | tonumber) * 60) as $off
            | if $o.s == "+" then $t - $off else $t + $off end
          end
      end
  end;'

# The ranking for one provider and need, cache-first. Sets $_reb_json (the
# picks, name/resetsAt/remaining only) and $_reb_fetched (when they were
# fetched). Returns 1 when there is none to trust: nothing cached, or stale,
# and the dashboard did not answer. A stale ranking is never decided on — a
# reset that has passed makes it wrong by a week, not by minutes — and a
# dashboard that is down costs one call per process, however many panes ask.
_REB_ASKED=""
_reb_rank() {  # $1 = provider, $2 = need, $3 = now
  local provider="$1" need="$2" now="$3" key val fetched="" expires="" best="" json=""
  _reb_json=""; _reb_fetched=""
  key="$(_reb_rank_key "$provider" "$need")"
  val="$(tmux show-options -gqv "$key" 2>/dev/null || true)"
  [ -n "$val" ] && read -r fetched expires best json <<< "$val"
  case "$fetched" in ''|*[!0-9]*) fetched=0 ;; esac
  case "$expires" in ''|*[!0-9]*) expires=0 ;; esac
  if [ -n "$json" ] && [ "$now" -ge "$fetched" ] && [ "$now" -lt "$expires" ]; then
    _reb_json="$json"; _reb_fetched="$fetched"; return 0
  fi
  case " $_REB_ASKED " in *" $key "*) return 1 ;; esac
  _REB_ASKED="$_REB_ASKED $key"
  # --stale: the dashboard's own poll is 150s, so making it re-poll every
  # account for a decision this unhurried buys nothing and costs everyone.
  local out; out="$(cmd_pick --provider "$provider" --need "$need" --stale --json 2>/dev/null)" || return 1
  # "<fetched> <expires> <best> <json>". `expires` is 15 min out, or the first
  # cached reset still ahead of the fetch if that comes sooner; the best name
  # rides out front so `pane watchd` can skip a pane already on it with a bare
  # `read` — no jq, no process.
  val="$(printf '%s' "$out" | jq -r --argjson now "$now" --argjson ttl "$REBALANCE_RANK_TTL" "$_REB_JQ_EPOCH"'
    {picks: [.picks[]? | select(.name != null) | {name, resetsAt, remaining}]} as $r
    | ([$r.picks[].resetsAt | epoch | select(. != null and . > $now)] | min) as $next
    | (if $next == null or $next > $now + $ttl then $now + $ttl else $next end) as $exp
    | "\($now) \($exp) \($r.picks[0].name // "-") \($r | tojson)"' 2>/dev/null)" || return 1
  [ -n "$val" ] || return 1
  read -r fetched expires best json <<< "$val"
  tmux set-option -g "$key" "$val" 2>/dev/null || true
  _reb_json="$json"; _reb_fetched="$fetched"
}

# The rule, against the pane's account. Prints one line,
#   <status>TAB<best>TAB<name:reason name:reason …>
# status: current-gated (C is not among the picks — every account at 100 is
# left out of them), already-best, no-condition (the ranked best does not beat
# C), or move — and then the list is every pick, in rank order, that beats C
# under the same rule, the best first. A pick below the best is only ever
# reached by the best failing preflight, never by the best failing the rule.
_reb_decide() {  # $1 = picks json, $2 = the pane's account
  printf '%s' "$1" | jq -r --arg cur "$2" --argjson wall "$REBALANCE_NEAR_WALL" \
    --argjson room "$REBALANCE_DEST_ROOM" --argjson lead "$REBALANCE_RESET_LEAD" "$_REB_JQ_EPOCH"'
    def beats($c):   # . = a pick; why it beats $c, or null
      if ($c.remaining | type) == "number" and (.remaining | type) == "number"
         and $c.remaining <= $wall and .remaining >= $room then "imminent-wall"
      else (.resetsAt | epoch) as $x | ($c.resetsAt | epoch) as $y
        | if $x == null then null                # no reset named: never the sooner one
          elif $y == null then "sooner-reset"    # C names none: +infinity
          elif $y - $x >= $lead then "sooner-reset"
          else null end
      end;
    [.picks[]? | select(.name != null)] as $ps
    | ($ps[0].name // "-") as $best
    | ([$ps[] | select(.name == $cur)] | first) as $c
    | if $c == null then "current-gated\t\($best)\t"
      elif $best == $cur then "already-best\t\($best)\t"
      elif ($ps[0] | beats($c)) == null then "no-condition\t\($best)\t"
      else "move\t\($best)\t" + ([$ps[] | select(.name != $cur) | {n: .name, r: beats($c)}
                                 | select(.r != null) | "\(.n):\(.r)"] | join(" "))
      end' 2>/dev/null
}

_reb_preflight() {  # $1 = candidate, $2 = provider, $3 = the pane's cwd — `switch --as`'s own check
  if [ "$2" = codex ]; then _codex_candidate_ok "$1" "$3"; return $?; fi
  _token_for "$1" >/dev/null 2>&1 && return 0
  printf 'anu account: skipping %s — no token for it on this device (com8-account add %s)\n' "$1" "$1" >&2
  return 1
}

_reb_in_use() {  # $1 = pane, $2 = now. True when an attached client's CURRENT
  # pane is this one and that client sent a key in the last 5 minutes: a
  # half-typed prompt in an idle pane is the human's, and a relaunch loses it.
  local act p
  while IFS='|' read -r act p; do
    [ "$p" = "$1" ] || continue
    case "$act" in ''|*[!0-9]*) continue ;; esac
    [ $(($2 - act)) -lt "$REBALANCE_IN_USE" ] && return 0
  done <<EOF
$(tmux list-clients -F '#{client_activity}|#{pane_id}' 2>/dev/null || true)
EOF
  return 1
}

# One pane's decision, and — outside --dry-run — the move. Leaves the row in
# $_rb_provider $_rb_account $_rb_best $_rb_reason $_rb_outcome, anything the
# switch had to say in $_rb_detail, and returns 0 moved, 2 stayed, 3 the
# dashboard did not answer, 1 the move failed, 4 unmanaged (no row at all).
# $1 = pane, $2 = now, $3 = dry | move | tick.
_reb_one() {
  local pid="$1" now="$2" mode="$3"
  local account provider need session box reb_at rotating cmd cwd
  IFS='|' read -r account provider need session box reb_at rotating cmd cwd <<< \
    "$(tmux display-message -p -t "$pid" '#{@anu_account}|#{@anu_provider}|#{@anu_need}|#{@anu_session}|#{@anu_box}|#{@anu_rebalance_at}|#{@anu_rotating}|#{pane_current_command}|#{pane_current_path}' 2>/dev/null || true)"
  # A claude launch stamps no @anu_provider; absent means claude, exactly as
  # rotate and switch read it.
  [ -n "$provider" ] || provider=claude
  _rb_provider="$provider"; _rb_account="${account:--}"; _rb_best=-; _rb_reason=""
  _rb_outcome=skipped; _rb_detail=""
  [ -n "$account" ] || return 4
  [ -n "$need" ] || need=any
  [ "$provider" = codex ] && need=any
  if [ -z "$session" ]; then _rb_reason=no-session; return 2; fi
  if [ "$box" = 1 ]; then _rb_reason=boxed; return 2; fi
  # `pane state` reads a bare shell as idle. A pane whose human quit its CLI
  # still carries every stamp, and "resuming" it would bring back a session
  # somebody deliberately ended.
  case "$cmd" in bash|zsh|sh|fish|dash|"") _rb_reason=at-shell; return 2 ;; esac
  case "$reb_at" in ''|*[!0-9]*) : ;;
    *) if [ $((now - reb_at)) -ge 0 ] && [ $((now - reb_at)) -lt "$REBALANCE_MOVE_COOLDOWN" ]; then
         _rb_reason="rebalanced-$(((now - reb_at) / 60))m-ago"; return 2
       fi ;;
  esac
  case "$rotating" in ''|*[!0-9]*) : ;;
    *) if [ $((now - rotating)) -ge 0 ] && [ $((now - rotating)) -lt "$REBALANCE_WALL_COOLDOWN" ]; then
         _rb_reason="relaunched-$(((now - rotating) / 60))m-ago"; return 2
       fi ;;
  esac
  local st; st="$(pane state "$pid" 2>/dev/null)" || st=gone
  if [ "$st" != idle ]; then
    [ "$st" = busy ] && st=working
    _rb_reason="${st:-gone}"; return 2
  fi
  if _reb_in_use "$pid" "$now"; then _rb_reason=in-use; return 2; fi
  if ! _reb_rank "$provider" "$need" "$now"; then _rb_reason=dashboard-unreachable; return 3; fi
  local tab=$'\t' line status best cands
  line="$(_reb_decide "$_reb_json" "$account")" || line=""
  status="${line%%"$tab"*}"; line="${line#*"$tab"}"
  best="${line%%"$tab"*}"; cands="${line#*"$tab"}"
  [ -n "$best" ] && _rb_best="$best"
  case "$status" in
    move) : ;;
    current-gated|already-best|no-condition) _rb_reason="$status" ;;
    *) _rb_reason=unreadable-ranking ;;
  esac
  local dest="" why="" entry
  if [ "$status" = move ]; then
    for entry in $cands; do
      _reb_preflight "${entry%%:*}" "$provider" "$cwd" || continue
      dest="${entry%%:*}"; why="${entry##*:}"; break
    done
    [ -n "$dest" ] || _rb_reason=preflight-failed
  fi
  if [ -z "$dest" ]; then
    # This answer is a function of the ranking and the account alone, so it
    # is remembered against both: `pane watchd` does not ask again until one
    # of them changes. (Never under --dry-run, which writes nothing.)
    [ "$mode" = dry ] || tmux set-option -p -t "$pid" @anu_rebalance_seen "$_reb_fetched $account" 2>/dev/null || true
    return 2
  fi
  _rb_best="$dest"; _rb_reason="$why"
  if [ "$mode" = dry ]; then _rb_outcome=would-move; return 2; fi
  # The race guard: idle a dashboard call and a preflight ago is not idle
  # now, and a pane a human has just typed into is the one thing this must
  # never move. (switch re-reads it twice more, under the pane lock.)
  st="$(pane state "$pid" 2>/dev/null)" || st=gone
  if [ "$st" != idle ]; then
    [ "$st" = busy ] && st=working
    _rb_reason="raced-${st:-gone}"; return 2
  fi
  # Stamped BEFORE the move: a switch that then refuses still costs this pane
  # its six hours, so a refusal can never become a retry loop.
  tmux set-option -p -t "$pid" @anu_rebalance_at "$now" 2>/dev/null || true
  local out rc=0
  out="$("$0" switch "$pid" --as "$dest")" || rc=$?
  if [ "$rc" = 0 ]; then
    _rb_outcome=moved; _rb_detail="$(printf '%s\n' "$out" | grep '→' | tail -n 1)"
    return 0
  fi
  _rb_outcome=failed
  _rb_detail="switch --as $dest exited $rc"
  # A move that died AFTER leaving the old process leaves the pane at a shell,
  # the session running nowhere — the switch has no second candidate to try.
  # For an unattended move of an idle pane that is worse than no move at all,
  # so the session goes back where it was.
  local now_cmd; now_cmd="$(tmux display-message -p -t "$pid" '#{pane_current_command}' 2>/dev/null || true)"
  case "$now_cmd" in
    bash|zsh|sh|fish|dash)
      if "$0" switch "$pid" --as "$account" --force >/dev/null; then
        _rb_detail="$_rb_detail; resumed on $account"
      else
        _rb_detail="$_rb_detail; could not resume it on $account either — pane left at a shell (com8-account switch $pid --as $account --force)"
      fi ;;
  esac
  return 1
}

# The watchd worker: one pane, one decision, at most one log line — a move, a
# failed move, or a block for any reason but "nothing better" (already on the
# best, or the best does not beat it). An unmanaged pane says nothing at all.
_reb_tick() {  # $1 = pane, $2 = now
  local pid="$1" r=0 ts; ts="$(date '+%H:%M:%S')"
  _reb_one "$pid" "$2" tick || r=$?
  case "$r" in
    0) printf '[%s] rebalance %s (%s): %s\n' "$ts" "$pid" "$_rb_reason" "$_rb_detail" ;;
    1) printf '[%s] rebalance %s (%s): %s → %s failed — %s\n' "$ts" "$pid" "$_rb_reason" "$_rb_account" "$_rb_best" "$_rb_detail" ;;
    4) return 2 ;;
    *) case "$_rb_reason" in
         already-best|no-condition) : ;;
         *) printf '[%s] rebalance %s: stays on %s — %s%s\n' "$ts" "$pid" "$_rb_account" "$_rb_reason" \
              "$([ "$_rb_best" = - ] || printf ' (best %s)' "$_rb_best")" ;;
       esac ;;
  esac
  return "$r"
}

cmd_rebalance() {
  local target="" mode=move
  while [ $# -gt 0 ]; do case "$1" in
    --dry-run|-n) [ "$mode" = tick ] && _die "rebalance: --dry-run and --tick do not mix"; mode=dry; shift ;;
    --tick)       [ "$mode" = dry ] && _die "rebalance: --dry-run and --tick do not mix"; mode=tick; shift ;;
    -*) _die "rebalance: unexpected '$1'" ;;
    *) [ -z "$target" ] || _die "rebalance: unexpected '$1'"; target="$1"; shift ;;
  esac; done
  [ -x "$COM8_ACCOUNT_PANE" ] || _die "configured pane helper is not executable"
  local now; now="$(_reb_now)"
  if [ "$mode" = tick ]; then
    [ -n "$target" ] || _die "usage: com8-account rebalance <pane> --tick"
    # Paused since the arm looked: nothing moves, nothing is said.
    _reb_gate || exit 2
    local tr=0; _reb_tick "$target" "$now" || tr=$?
    exit "$tr"
  fi
  local -a pids=()
  local unmanaged=0 p c a b seen=" "
  if [ -n "$target" ]; then
    # `pane state` resolves every target shape (a %id, agent-N, a CLI name, a
    # role) — `pane id` only matches CLI names.
    local st; st="$(pane state "$target" --json 2>/dev/null)" || _die "no such pane: $target"
    p="$(printf '%s' "$st" | jq -r .pane 2>/dev/null)"
    [ -n "$p" ] && [ "$p" != null ] || _die "no such pane: $target"
    pids=("$p")
  else
    # Every pane on this server, once — linked sessions list one %id per
    # session. A pane with an account gets a row; an AGENT pane without one
    # (the same test `pane watchd` enumerates by) is only counted.
    while IFS='|' read -r p c a b; do
      [ -n "$p" ] || continue
      case "$seen" in *" $p "*) continue ;; esac
      seen="$seen$p "
      if [ -n "$a" ]; then pids+=("$p"); continue; fi
      case "$c" in
        codex|claude|opencode|pi|node|[0-9]*) unmanaged=$((unmanaged + 1)) ;;
        container) [ "$b" = 1 ] && unmanaged=$((unmanaged + 1)) ;;
      esac
    done <<EOF
$(tmux list-panes -a -F '#{pane_id}|#{pane_current_command}|#{@anu_account}|#{@anu_box}' 2>/dev/null || true)
EOF
  fi
  _reb_gate || printf 'anu account: @anu_rebalance is 0 on this server — pane watchd moves nothing; this run still does\n' >&2
  local rows r rc=0
  rows="$(printf 'PANE\tPROVIDER\tACCOUNT\tBEST\tREASON\tOUTCOME')"
  for p in ${pids[@]+"${pids[@]}"}; do
    r=0; _reb_one "$p" "$now" "$mode" || r=$?
    if [ "$r" = 4 ]; then unmanaged=$((unmanaged + 1)); continue; fi
    [ "$r" = 1 ] && rc=1
    [ -n "$_rb_detail" ] && printf '%s\n' "$_rb_detail" >&2
    rows="$rows"$'\n'"$(printf '%s\t%s\t%s\t%s\t%s\t%s' "$p" "$_rb_provider" "$_rb_account" "$_rb_best" "$_rb_reason" "$_rb_outcome")"
  done
  printf '%s\n' "$rows" | column -t -s $'\t'
  printf '%s unmanaged pane%s skipped\n' "$unmanaged" "$([ "$unmanaged" = 1 ] || printf s)"
  return "$rc"
}

# ------------------------------------------------------------------ help ----
cmd_help() { sed -n '2,/^$/p' "${BASH_SOURCE[0]}" | sed '$d' | sed 's/^# \{0,1\}//'; }   # module header, including when sourced by its installed wrapper

case "${1:-help}" in
  pick)   shift; cmd_pick "$@" ;;
  ls)     shift; cmd_ls "$@" ;;
  token)  shift; cmd_token "$@" ;;
  add)    shift; cmd_add "$@" ;;
  sync)   shift; cmd_sync "$@" ;;
  status) shift; cmd_status "$@" ;;
  launch) shift; cmd_launch "$@" ;;
  rotate) shift; cmd_rotate "$@" ;;
  switch) shift; cmd_switch "$@" ;;
  rebalance) shift; cmd_rebalance "$@" ;;
  hook)   shift; cmd_hook "$@" ;;
  doctor) shift; cmd_doctor "$@" ;;
  __test_lock_hold) shift; cmd__test_lock_hold "$@" ;;
  help|-h|--help) cmd_help ;;
  *) _die "unknown verb '$1' (ls, pick, launch, rotate, switch, rebalance, status, add, sync, token, hook, doctor, help)" ;;
esac
