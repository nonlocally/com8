#!/usr/bin/env bash
# COM8 optional account credential client, adapted from Anu 80d3c86.
# Uses an explicitly configured existing store. Does not provision or host a secrets service.
# Bash 3.2 compatible: no `mapfile`, no other bash-4-only features.
set -uo pipefail

_die()  { printf 'com8-account-secrets: %s\n' "$*" >&2; exit 1; }
_have() { command -v "$1" >/dev/null 2>&1; }

CONFIG="${COM8_SECRETS_CONFIG:-${ANU_SECRETS_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/com8/secrets.toml}}"
STATE="${COM8_SECRETS_STATE:-${ANU_SECRETS_STATE:-${XDG_STATE_HOME:-$HOME/.local/state}/com8/secrets}}"
INFISICAL_BIN="${ANU_INFISICAL_BIN:-infisical}"
REALM="${ANU_SECRETS_REALM:-anu}"

# --- scratch files (0600, for secret material kept off argv) ------------------
# Per-PID scratch dir so cleanup is path-safe (no word-splitting) AND effective:
# `$$` is stable across command-substitution subshells, so files created inside
# `f="$(_mktemp_secure)"` still land under the dir the parent's EXIT trap removes.
_scratch_cleanup() { rm -rf "$STATE/tmp/$$" 2>/dev/null; }
trap '_scratch_cleanup' EXIT
_mktemp_secure() {
  install -d -m 700 "$STATE/tmp/$$"
  local f; f="$(mktemp "$STATE/tmp/$$/anu.XXXXXX")" || _die "could not create a scratch file"
  chmod 600 "$f"
  printf '%s' "$f"
}

# Read a top-level `key = "value"` (or bare `key = value`) line from the TOML config.
_cfg_get() {
  [ -f "$CONFIG" ] || return 0
  sed -n "s/^$1[[:space:]]*=[[:space:]]*\"\\(.*\\)\"[[:space:]]*$/\\1/p;s/^$1[[:space:]]*=[[:space:]]*\\([^\"].*\\)$/\\1/p" "$CONFIG" | head -1
}

# --- secure store: keychain / libsecret / file / 1password -------------------
# Legacy store names are retained for existing credentials; enrollment and
# credential-store mutation commands are deliberately absent from this client.
STORE_SELECTED=""
OP_VAULT_SELECTED=""
_OP_BIN="${ANU_OP_BIN:-op}"

# Resolve the secure-store backend. EXPLICIT opt-in for 1password — never auto-pick
# it just because `op` exists. Precedence: test override -> current command's --store
# -> persisted config -> ANU_SECRETS_STORE (pre-config) -> platform default.
_store_kind() {
  [ -n "${ANU_STORE_FORCE:-}" ] && { echo "$ANU_STORE_FORCE"; return; }   # tests
  [ -n "$STORE_SELECTED" ] && { echo "$STORE_SELECTED"; return; }          # this init/adopt
  local configured; configured="$(_cfg_get credential_store)"
  [ -n "$configured" ] && { echo "$configured"; return; }                  # normal ops
  [ -n "${ANU_SECRETS_STORE:-}" ] && { echo "$ANU_SECRETS_STORE"; return; } # before config exists
  case "$(uname -s)" in
    Darwin) _have security && { echo keychain; return; } ;;
    *)      _have secret-tool && { echo libsecret; return; } ;;
  esac
  echo file
}
_store_svc() { printf 'anu-secrets:%s:%s' "$REALM" "$1"; }

# --- 1Password backend (op CLI): stores ONE opaque value per key, off argv -------
_op_vault() {
  [ -n "$OP_VAULT_SELECTED" ] && { printf '%s' "$OP_VAULT_SELECTED"; return; }
  local c; c="$(_cfg_get op_vault)"; [ -n "$c" ] && { printf '%s' "$c"; return; }
  [ -n "${ANU_SECRETS_OP_VAULT:-}" ] && { printf '%s' "$ANU_SECRETS_OP_VAULT"; return; }
  printf 'anu'   # dedicated default vault for fresh installs
}
# Only check the CLI exists — NOT auth. `op account list` would wrongly reject a
# valid OP_SERVICE_ACCOUNT_TOKEN (service accounts aren't device accounts). The real
# `op vault get`/`item list` operations are the auth/access probe, so the backend
# works with desktop-app integration OR a service-account token (review #1).
_op_ready() {
  _have "$_OP_BIN" || { printf 'com8-account-secrets: op CLI not found — install 1Password CLI or configure another credential_store\n' >&2; return 1; }
}
_op_auth_hint() { # vault
  printf "com8-account-secrets: cannot access 1Password vault '%s' — op may not be authenticated (enable desktop-app integration, sign in with op, or set OP_SERVICE_ACCOUNT_TOKEN) or you lack access to the vault; or configure an existing op_vault\n" "$1" >&2
}
# Resolve a title to a single item id; duplicate titles are a HARD error (no guessing).
_op_item_id() { # <title>
  local vault json; vault="$(_op_vault)"
  json="$("$_OP_BIN" item list --vault "$vault" --categories Password --tags anu-secrets --format=json 2>/dev/null)" \
    || { _op_auth_hint "$vault"; return 1; }
  printf '%s' "$json" | jq -er --arg t "$1" '
    [ .[]? | select(.title == $t) ] as $m
    | if ($m|length)==0 then "" elif ($m|length)==1 then $m[0].id else error("dup") end' 2>/dev/null \
    || { printf "com8-account-secrets: duplicate 1Password items titled '%s' — clean them up in 1Password\n" "$1" >&2; return 1; }
}
_store_get() {
  local key="$1"
  case "$(_store_kind)" in
    keychain) security find-generic-password -a "${USER:-anu}" -s "$(_store_svc "$key")" -w 2>/dev/null ;;
    libsecret) secret-tool lookup application anu realm "$REALM" key "$key" 2>/dev/null ;;
    file) [ -f "$STATE/root/$key" ] && cat "$STATE/root/$key" ;;
    1password)
      _op_ready || return 1
      local title vault id; title="$(_store_svc "$key")"; vault="$(_op_vault)"
      id="$(_op_item_id "$title")" || return 1
      [ -n "$id" ] || return 0   # not found -> empty, success (matches other stores)
      "$_OP_BIN" item get "$id" --vault "$vault" --format=json --reveal 2>/dev/null \
        | jq -r '[.fields[]? | select(.id=="password" or .label=="password" or .purpose=="PASSWORD") | .value] | .[0] // empty' ;;
  esac
}

# --- URL handling: CLI domain vs REST base (review #6) ------------------------
_norm_url() { local u="$1"; while [ "${u%/}" != "$u" ]; do u="${u%/}"; done; printf '%s' "$u"; }
# REST base = the CLI domain with any trailing `/api` removed, so a Cloud-style
# `/api`-suffixed domain doesn't become `/api/api/v1`.
_api_base() { local d; d="$(_cfg_get domain)"; printf '%s' "${d%/api}"; }

# --- JSON build/parse helpers (keep secrets off argv) ------------------------
_json_escape() {
  local s="$1"
  s="${s//\\/\\\\}"; s="${s//\"/\\\"}"
  s="${s//$'\n'/\\n}"; s="${s//$'\t'/\\t}"; s="${s//$'\r'/\\r}"
  printf '%s' "$s"
}
# Build a JSON object from k v k v ...; values stay in-process (never argv).
_json_obj() {
  local out="{" first=1 k v
  while [ $# -ge 2 ]; do
    k="$1"; v="$2"; shift 2
    [ "$first" -eq 1 ] || out="$out,"
    out="$out\"$(_json_escape "$k")\":\"$(_json_escape "$v")\""
    first=0
  done
  printf '%s}' "$out"
}
# Parse one field; fail (nonzero) if absent, empty, or the literal null. Reads JSON
# from $1 (a string), filter in $2.
_jq_field() {
  local v; v="$(printf '%s' "$1" | jq -r "$2" 2>/dev/null)"
  [ -n "$v" ] && [ "$v" != null ] || return 1
  printf '%s' "$v"
}

# --- REST transport: bearer token off argv (-K config file), body off argv ---
# (--data-binary @- on stdin). curl -K reads a FILE so stdin stays free for body.
_api() { # _api <METHOD> <url> <bearer> [json-body]
  local method="$1" url="$2" tok="$3" body="${4:-}"
  local cfg rc=0; cfg="$(_mktemp_secure)"
  printf 'header = "Authorization: Bearer %s"\n' "$tok" > "$cfg"
  if [ -n "$body" ]; then
    printf '%s' "$body" | curl -fsS -K "$cfg" -H "Content-Type: application/json" -X "$method" --data-binary @- "$url" || rc=$?
  else
    curl -fsS -K "$cfg" -X "$method" "$url" </dev/null || rc=$?
  fi
  rm -f "$cfg"
  return $rc
}

# Exchange a Universal Auth client id/secret for a short-lived access token via the
# REST login endpoint. The client secret travels in the request body on stdin —
# never on argv (the `infisical login` CLI has no non-argv way to pass it).
# Current epoch (override with ANU_NOW in tests).
_now() { printf '%s' "${ANU_NOW:-$(date +%s)}"; }
_cache_dir() { printf '%s' "$STATE/cache"; }
_token_cache_file() { printf '%s/infisical-token.json' "$(_cache_dir)"; }
# Identity key for the cache: any of these changing (re-adopt/reconnect) invalidates it.
_token_cache_key() { printf '%s|%s|%s|%s|%s' "$(_cfg_get domain)" "$(_cfg_get project_id)" "$(_cfg_get device_id)" "$(_cfg_get ua_client_id)" "$(_cfg_get org_slug)"; }

_UA_EXPIRES_IN=0   # set by _ua_login from the login response, for the cache TTL
_ua_login() { # _ua_login <api_base> <client_id> <client_secret> <org_slug>
  local api="$1" cid="$2" csec="$3" org="$4" body resp tok exp
  body="$(_json_obj clientId "$cid" clientSecret "$csec" organizationSlug "$org")"
  resp="$(printf '%s' "$body" | curl -fsS -H "Content-Type: application/json" \
      -X POST --data-binary @- "$api/api/v1/auth/universal-auth/login" 2>/dev/null)" || return 1
  tok="$(printf '%s' "$resp" | jq -r '.accessToken // empty' 2>/dev/null)"
  exp="$(printf '%s' "$resp" | jq -r '.expiresIn // 0' 2>/dev/null)"
  [ -n "$tok" ] && [ "$tok" != null ] || return 1
  case "$exp" in ''|*[!0-9]*) exp=0 ;; esac
  _UA_EXPIRES_IN="$exp"
  printf '%s' "$tok"
}

# Exchange THIS device's stored client secret for a SHORT-LIVED access token, and
# CACHE it (0600) so the root credential (in 1Password/Keychain) is read at most once
# per token lifetime — not on every get/env/exec. Cache holds only the scoped token,
# never the root secret. `ANU_SECRETS_NO_CACHE=1` forces a fresh mint.
_ua_token() {
  _have jq || _die "infisical mode needs jq"
  local cid org dev cf key now ttl tok skew=60
  cid="$(_cfg_get ua_client_id)"; org="$(_cfg_get org_slug)"; dev="$(_cfg_get device_id)"
  [ -n "$cid" ] || _die "not connected to Infisical (no ua_client_id) — configure an existing device identity in COM8_SECRETS_CONFIG"
  cf="$(_token_cache_file)"; key="$(_token_cache_key)"; now="$(_now)"
  # Cache hit: a fresh token for this exact identity → no root-credential read.
  if [ "${ANU_SECRETS_NO_CACHE:-}" != 1 ] && [ -f "$cf" ]; then
    local ck cexp ctok
    ck="$(jq -r '.key // empty' "$cf" 2>/dev/null)"; cexp="$(jq -r '.expires_at // 0' "$cf" 2>/dev/null)"; ctok="$(jq -r '.token // empty' "$cf" 2>/dev/null)"
    case "$cexp" in ''|*[!0-9]*) cexp=0 ;; esac
    if [ "$ck" = "$key" ] && [ -n "$ctok" ] && [ "$((cexp - skew))" -gt "$now" ]; then
      printf '%s' "$ctok"; return 0
    fi
  fi
  # Cache miss/expired: read the root credential (this is the only step that touches
  # 1Password/Keychain) and mint a token.
  local csec tf
  csec="$(_store_get "ua-client-secret:$dev")"
  [ -n "$csec" ] || _die "no device credential in the secure store — configure an existing device credential in the selected store"
  # Run _ua_login with a REDIRECT (current shell, NOT $(...) subshell) so the
  # _UA_EXPIRES_IN it sets survives — otherwise the cache TTL would always default.
  tf="$(_mktemp_secure)"
  if _ua_login "$(_api_base)" "$cid" "$csec" "$org" > "$tf" 2>/dev/null; then tok="$(cat "$tf")"; rm -f "$tf"
  else rm -f "$tf"; _die "universal-auth login failed against $(_cfg_get domain)"; fi
  ttl="${_UA_EXPIRES_IN:-0}"; case "$ttl" in ''|*[!0-9]*|0) ttl=3600 ;; esac
  install -d -m 700 "$(_cache_dir)"; umask 077
  printf '{"key":"%s","token":"%s","expires_at":%s}\n' "$(_json_escape "$key")" "$(_json_escape "$tok")" "$((now + ttl))" > "$cf"
  chmod 600 "$cf"
  printf '%s' "$tok"
}

_scope_path() {
  case "$1" in
    host)             echo /anu/host ;;
    host.chat|host.chat.cursor) echo /anu/host/chat ;;
    agent.claude)     echo /anu/agents/claude ;;
    agent.codex)      echo /anu/agents/codex ;;
    bootstrap.health) echo /anu/bootstrap ;;
    /*)               echo "$1" ;;            # an explicit path passes through
    *) return 1 ;;                            # unknown — caller checks (an _die in $() would only exit the subshell)
  esac
}
_bad_scope() { _die "unknown scope '$1' (host, agent.claude, agent.codex, bootstrap.health, or an explicit /path)"; }
# Build the common infisical CLI args (project/env + a fresh short-lived token)
# directly into the global INF array — no mapfile, no bash-4 features (review #1).
_load_inf_args() {
  _have jq || _die "infisical mode needs jq"
  local tok; tok="$(_ua_token)" || return 1
  INF=(--domain "$(_cfg_get domain)" --token "$tok" \
       --projectId "$(_cfg_get project_id)" --env "$(_cfg_get default_env)" --silent)
}
# Write a `NAME=value` dotenv line to a 0600 file for infisical's `secrets set
# --file`. The installed CLI (0.43.x) does NOT dereference the `NAME=@/path`
# form shown in its own --help example — it stores the literal string
# `@/path/to/file` — so this is the only transport that keeps the value off
# argv (verified live 2026-09-14). infisical's dotenv parser reads the value
# verbatim after the first '=' with no shell-style unescaping, so '#', spaces,
# and quote characters all round-trip untouched and must NOT be quoted here.
# One limitation this form does not fully cover: a literal newline embedded
# in the value still breaks one-line dotenv parsing (the old `@file` form was
# newline-safe; `--file` dotenv is not).
_write_value() { # _write_value <file> <name> <value>
  local f="$1" name="$2" val="$3"
  printf '%s=%s\n' "$name" "$val" > "$f"; chmod 600 "$f"
}

cmd_get() {
  [ $# -ge 2 ] || _die "usage: com8-account-secrets get <scope> <NAME> [--show]"
  local scope="$1" name="$2" show=""; [ "${3:-}" = "--show" ] && show=1
  local path; path="$(_scope_path "$scope")" || _bad_scope "$scope"
  _load_inf_args || _die "could not authenticate to Infisical"
  if [ -n "$show" ]; then
    "$INFISICAL_BIN" secrets get "$name" "${INF[@]}" --path "$path" --plain
  else
    "$INFISICAL_BIN" secrets get "$name" "${INF[@]}" --path "$path" >/dev/null \
      && printf '%s/%s present (use --show to reveal)\n' "$scope" "$name"
  fi
}
cmd_set() {
  [ $# -ge 2 ] || _die "usage: com8-account-secrets set <scope> <NAME>   (prompts for the value)"
  local scope="$1" name="$2" val
  case "$name" in *=*) val="${name#*=}"; name="${name%%=*}" ;; *) read -rsp "value for $name: " val; echo >&2 ;; esac
  local path; path="$(_scope_path "$scope")" || _bad_scope "$scope"
  _load_inf_args || _die "could not authenticate to Infisical"
  # value travels via a 0600 dotenv file (--file), never argv (review #3,#5)
  local f; f="$(_mktemp_secure)"; _write_value "$f" "$name" "$val"
  local rc=0
  "$INFISICAL_BIN" secrets set --file "$f" "${INF[@]}" --path "$path" || rc=$?
  rm -f "$f"
  [ "$rc" -eq 0 ] && printf '%s/%s set\n' "$scope" "$name"
  return $rc
}
# Ensure every folder along a scope's path exists in Infisical (a 404 blocks any
# `set` into a not-yet-created folder — the infisical CLI has no `folders`
# command, so this walks the REST folders API). Idempotent: only missing
# segments are created, from /anu down.
cmd_mkdir() {
  [ $# -ge 1 ] || _die "usage: com8-account-secrets mkdir <scope-or-path>"
  local scope="$1" path
  path="$(_scope_path "$scope")" || _bad_scope "$scope"
  _have jq || _die "mkdir needs jq"
  local api pid env tok
  api="$(_api_base)"; pid="$(_cfg_get project_id)"; env="$(_cfg_get default_env)"
  tok="$(_ua_token)" || _die "could not authenticate to Infisical"
  local rest="${path#/}" parent="/" seg list found full
  while [ -n "$rest" ]; do
    case "$rest" in
      */*) seg="${rest%%/*}"; rest="${rest#*/}" ;;
      *)   seg="$rest"; rest="" ;;
    esac
    [ -n "$seg" ] || continue
    if [ "$parent" = "/" ]; then full="/$seg"; else full="$parent/$seg"; fi
    list="$(_api GET "$api/api/v1/folders?workspaceId=$pid&environment=$env&path=$parent" "$tok")" \
      || _die "could not list folders at $parent"
    found="$(printf '%s' "$list" | jq -r --arg n "$seg" '.folders[]? | select(.name==$n) | .name' 2>/dev/null | head -1)"
    if [ -z "$found" ]; then
      _api POST "$api/api/v1/folders" "$tok" \
        "$(_json_obj workspaceId "$pid" environment "$env" name "$seg" path "$parent")" >/dev/null \
        || _die "could not create folder $full"
      printf 'created %s\n' "$full"
    fi
    parent="$full"
  done
  printf 'ok %s\n' "$path"
}
cmd_env() {
  local scope="" fmt="dotenv"
  while [ $# -gt 0 ]; do case "$1" in
    --scope)  [ $# -ge 2 ] || _die "env: --scope needs a value"; scope="$2"; shift 2 ;;
    --format) [ $# -ge 2 ] || _die "env: --format needs a value"; fmt="$2"; shift 2 ;;
    *) _die "env: unexpected '$1'" ;;
  esac; done
  [ -n "$scope" ] || _die "usage: com8-account-secrets env --scope <scope> [--format dotenv|json|csv|export]"
  local path; path="$(_scope_path "$scope")" || _bad_scope "$scope"
  _load_inf_args || _die "could not authenticate to Infisical"
  case "$fmt" in
    dotenv|json|csv) "$INFISICAL_BIN" export "${INF[@]}" --path "$path" --format "$fmt" ;;
    export)
      # anu-side transform: Infisical has no `export` format; map dotenv -> shell
      "$INFISICAL_BIN" export "${INF[@]}" --path "$path" --format dotenv \
        | while IFS= read -r line; do
            case "$line" in
              ''|\#*) continue ;;
              *=*) local k="${line%%=*}" v="${line#*=}"
                   v="${v//\'/\'\\\'\'}"
                   printf "export %s='%s'\n" "$k" "$v" ;;
            esac
          done ;;
    *) _die "env: unknown format '$fmt' (dotenv|json|csv|export)" ;;
  esac
}
case "${1:-help}" in
  get|set|mkdir|env) verb="$1"; shift; [ -f "$CONFIG" ] || _die "existing secrets configuration required: $CONFIG"; "cmd_$verb" "$@" ;;
  help|-h|--help) printf 'com8-account-secrets {get SCOPE NAME [--show]|set SCOPE NAME|mkdir SCOPE|env --scope SCOPE --format FORMAT}\n' ;;
  *) _die "unsupported account credential operation" ;;
esac
