# COM8 optional contained-agent image. Explicit build only; no notebook payload.
# Adapted from Anu 80d3c86 config/box/Containerfile; see box/README.md.
FROM node:22-bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
      git curl ca-certificates ripgrep fd-find jq less procps \
      build-essential python3 python3-venv python3-pip \
    && rm -rf /var/lib/apt/lists/* \
    && ln -sf "$(command -v fdfind)" /usr/local/bin/fd

RUN npm install -g @anthropic-ai/claude-code
RUN git config --system safe.directory '*' \
    && git config --system commit.gpgsign false \
    && mkdir -p /opt/com8/pane

ENV PATH="/opt/com8/pane:${PATH}"
ENV IS_SANDBOX=1
WORKDIR /work
CMD ["bash"]
