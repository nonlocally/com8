#!/usr/bin/env bash
# communicate — COM8's compatible native/session, bus, and durable CLI.
# Native remote adapters use SSH; registered buses and durable links retain
# their own transports. Claude Code and Codex are the native agent adapters.
#
#   communicate link    <device>                 verify the ssh/Tailscale substrate
#   communicate ls      [device]                 list agents on a device
#   communicate status                           show active bridges / codex peers
#   communicate down                             tear everything down
#
#   communicate claude bridge   <device> [name|pid|newest]
#   communicate claude unbridge <device|all>
#
#   communicate codex  queue <device> <session-name|uuid> <message>  # enqueue for existing session
#   communicate codex  ask   <device> [--dir D] [--thread N] [--new] [--auto] <message>
#   communicate codex  peer  <device> [name]     present a remote Codex as a native Claude peer
#   communicate codex  unpeer <device|all>
#   communicate codex  forget <device|all>
#
#   communicate send <peer-name|socket-path> <message>    raw inject into a peer socket
#
#   communicate agents                           the routing table (every reachable agent)
#   communicate bus register [--bus NAME]         register THIS session (default: general)
#   communicate bus list|agents|dashboard         explicit buses and registered agents
#   communicate bus --help                        membership, invitations, HTTPS access
#   communicate whereis <name>                   resolve a name -> type/device/socket
#   communicate route   <name> <message>         route to any agent by name
#   communicate wake    <name> [--every SEC] [--message MSG] [--times N]     timer trigger
#   communicate wake    <name> --on-pr <owner/repo> [--every SEC] [--catchup]  new-PR trigger
#   communicate wake    stop <name|all> | wake ls
#
#   communicate ask <name> [--timeout SEC] [--as NAME] <question>
#                                                sync ask of ANY agent (claude or local codex session)
#   communicate card {set|show|clear} <name|self> [--what T] [--ask-me-for T]
#                                                self-described capability; roster DESCRIPTION prefers it
#   communicate setup-repo [--claude] [--codex] [--dry-run] [--uninstall]
#                                                register THIS checkout as the Claude+Codex plugin
#   communicate com8 ...                         the fabric: durable identities, mailboxes,
#                       seats, spawn, move, links, fleets, boxes. Verbs:
#                       start|stop|status|agents  claim [--boxed]|release|adopt|retitle
#                       send|ask|reply|wait|group|notify|inbox   seat {ls|spawn|send|read|state|wait|respond|bind|kill}
#                       spawn|fan|consult   move <name> <device>   link|unlink [--allow-seats]
#                       grant|ungrant|grants|card|federate {invite|accept|revoke|status}
#   com8 setup --service                         managed daemon persistence
#
set -o pipefail
# Resolve symlinks so `ln -s .../bin/communicate ~/.local/bin/` works: lib/
# lives beside the REAL script, not beside the symlink.
_SELF="${BASH_SOURCE[0]}"
while [ -L "$_SELF" ]; do
  _DIR="$(cd "$(dirname "$_SELF")" && pwd)"
  _SELF="$(readlink "$_SELF")"
  [[ "$_SELF" != /* ]] && _SELF="$_DIR/$_SELF"
done
COMM_HOME="$(cd "$(dirname "$_SELF")/.." && pwd)"
export COMM_HOME
# Reject retired persistence verbs before common.sh initializes runtime state.
# The same refusals remain in com8_cmd for callers sourcing the native adapter.
if [ "${1:-}" = com8 ]; then
  case "${2:-}" in
    install|uninstall)
      source "$COMM_HOME/lib/com8.sh"
      "com8_$2" "${@:3}"
      exit $?;;
  esac
fi
# shellcheck source=lib/common.sh
source "$COMM_HOME/lib/common.sh"
# shellcheck source=lib/claude.sh
source "$COMM_HOME/lib/claude.sh"
# shellcheck source=lib/codex.sh
source "$COMM_HOME/lib/codex.sh"
# shellcheck source=lib/peer.sh
source "$COMM_HOME/lib/peer.sh"
# shellcheck source=lib/router.sh
source "$COMM_HOME/lib/router.sh"
# shellcheck source=lib/wake.sh
source "$COMM_HOME/lib/wake.sh"
# shellcheck source=lib/cards.sh
[ -f "$COMM_HOME/lib/cards.sh" ] && . "$COMM_HOME/lib/cards.sh"
# shellcheck source=lib/ask.sh
[ -f "$COMM_HOME/lib/ask.sh" ] && . "$COMM_HOME/lib/ask.sh"
# shellcheck source=lib/setup_repo.sh
[ -f "$COMM_HOME/lib/setup_repo.sh" ] && . "$COMM_HOME/lib/setup_repo.sh"
# Older compatibility packages omitted the durable plane; combined COM8 releases include it.
# shellcheck source=lib/com8.sh
[ -f "$COMM_HOME/lib/com8.sh" ] && . "$COMM_HOME/lib/com8.sh"

# Print the whole leading comment header (stops at the first non-comment line),
# so the usage text can grow without a hardcoded line range going stale.
usage() { awk 'NR < 2 { next } /^#/ { sub(/^# ?/, ""); print; next } { exit }' "$COMM_HOME/bin/communicate"; }

cmd_link() {
  local dev="${1:-}"; [ -n "$dev" ] || die "usage: communicate link <device>"
  log "checking substrate for '$dev' ..."
  local ts; ts="$(tailscale_bin)"
  if [ -n "$ts" ] && ! comm_is_local "$dev"; then
    local line; line="$("$ts" status 2>/dev/null | awk -v d="$dev" '$2==d || $1==d {print; found=1} END{}')"
    [ -n "$line" ] && ok "tailscale: $line" || warn "tailscale: '$dev' not seen in tailnet (may still resolve via ssh config)"
  fi
  if device_reachable "$dev"; then
    ok "ssh: reachable"
    local rc; rc="$(codex_probe "$dev")"
    [ -n "$rc" ] && ok "codex: $rc" || warn "codex: not installed on $dev"
    local cs; cs="$(on_device "$dev" 'ls "$HOME"/.claude/sessions/*.json 2>/dev/null | wc -l | tr -d " "')"
    ok "claude: ${cs:-0} session sidecar(s) present"
  else
    die "ssh: NOT reachable — check Tailscale is up and ssh works: ssh $dev true"
  fi
}

cmd_ls() {
  local dev="${1:-}"
  if [ -z "$dev" ]; then
    log "local Claude sessions:"; claude_list local
    log "active bridges:"; cmd_status quiet
    return 0
  fi
  log "Claude sessions on $dev:"; claude_list "$dev"
  local rc; rc="$(codex_probe "$dev")"
  [ -n "$rc" ] && log "codex on $dev: $rc" || log "codex on $dev: (not installed)"
}

cmd_status() {
  local quiet="${1:-}"
  local any=0 sd
  for sd in "$COMM_STATE"/bridges/*/; do
    [ -f "$sd/meta" ] || continue; any=1
    local device remote_name; device=""; remote_name=""
    while IFS='=' read -r k v; do case "$k" in device) device="$v";; remote_name) remote_name="$v";; esac; done < "$sd/meta"
    local up="down"; [ -f "$sd/supervisor.pid" ] && kill -0 "$(cat "$sd/supervisor.pid")" 2>/dev/null && up="up"
    printf '  claude-bridge  %-24s peer=%-20s [%s]\n' "$device" "${remote_name:-?}" "$up" >&2
  done
  for sd in "$COMM_STATE"/peers/*/; do
    [ -f "$sd/meta" ] || continue; any=1
    local device name; device=""; name=""
    while IFS='=' read -r k v; do case "$k" in device) device="$v";; name) name="$v";; esac; done < "$sd/meta"
    local up="down"; [ -f "$sd/daemon.pid" ] && kill -0 "$(cat "$sd/daemon.pid")" 2>/dev/null && up="up"
    printf '  codex-peer     %-24s name=%-20s [%s]\n' "$device" "${name:-?}" "$up" >&2
  done
  [ "$any" -eq 0 ] && [ "$quiet" != quiet ] && warn "nothing active"
  return 0
}

cmd_down() {
  wake_stop all 2>/dev/null || true
  claude_unbridge all 2>/dev/null || true
  codex_unpeer all 2>/dev/null || true
  ok "all wakes, bridges, and peers torn down"
}

cmd_claude() {
  local sub="${1:-}"; shift || true
  case "$sub" in
    bridge)   claude_bridge "$@";;
    unbridge) claude_unbridge "$@";;
    list|ls)  claude_list "$@";;
    *) die "usage: communicate claude {bridge|unbridge|list} ...";;
  esac
}

cmd_codex() {
  local sub="${1:-}"; shift || true
  case "$sub" in
    queue)  codex_queue "$@";;
    ask)    codex_ask "$@";;
    peer)   codex_peer "$@";;
    unpeer) codex_unpeer "$@";;
    forget) codex_forget "$@";;
    probe)  codex_probe "$@";;
    *) die "usage: communicate codex {queue|ask|peer|unpeer|forget|probe} ...";;
  esac
}

main() {
  local cmd="${1:-}"; shift || true
  case "$cmd" in
    bus)     COMM_STATE="$COMM_STATE" python3 "$COMM_HOME/lib/bus.py" "$@";;
    link)    cmd_link "$@";;
    ls|list) cmd_ls "$@";;
    status)  cmd_status;;
    down)    cmd_down;;
    claude)  cmd_claude "$@";;
    codex)   cmd_codex "$@";;
    send)    peer_send "$@";;
    agents)    router_agents "$@";;
    whereis) router_whereis "$@" && echo;;
    route)   router_route "$@";;
    wake)    wake_cmd "$@";;
    ask)     ask_cmd "$@";;
    card)    cards_cmd "$@";;
    setup-repo) setup_repo "$@";;
    com8)    type com8_cmd >/dev/null 2>&1 || \
                 die "durable COM8 is missing from this installation — install a verified release from https://github.com/nonlocally/com8/releases"
             com8_cmd "$@";;
    # internal entrypoints (not for humans)
    __supervise-claude) _claude_supervise "$@";;
    __codex-peer-serve) _codex_peer_serve "$@";;
    __wake-loop)        _wake_loop "$@";;
    ''|-h|--help|help) usage;;
    *) err "unknown command: $cmd"; usage; exit 1;;
  esac
}
main "$@"
